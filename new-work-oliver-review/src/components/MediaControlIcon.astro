---
interface Props {
  name: 'play' | 'pause' | 'volume-on' | 'volume-off' | 'fullscreen';
}

const { name } = Astro.props;
---

<span class={`media-control-icon media-control-icon--${name}`} data-media-control-icon={name} aria-hidden="true">
  {name === 'play' ? (
    <svg viewBox="0 0 24 24" focusable="false">
      <path d="M7.5 4.75 19 12 7.5 19.25Z" fill="currentColor" />
    </svg>
  ) : name === 'pause' ? (
    <svg viewBox="0 0 24 24" focusable="false">
      <path d="M6.75 5h4v14h-4zM13.25 5h4v14h-4z" fill="currentColor" />
    </svg>
  ) : name === 'volume-on' ? (
    <svg viewBox="0 0 24 24" focusable="false">
      <path d="M4.5 9.25v5.5h3.25L12.5 19V5L7.75 9.25H4.5Z" fill="currentColor" />
      <path d="M15.2 8.15a5.25 5.25 0 0 1 0 7.7M17.55 5.8a8.5 8.5 0 0 1 0 12.4" fill="none" stroke="currentColor" stroke-linecap="round" stroke-width="1.75" />
    </svg>
  ) : name === 'volume-off' ? (
    <svg viewBox="0 0 24 24" focusable="false">
      <path d="M4.5 9.25v5.5h3.25L12.5 19V5L7.75 9.25H4.5Z" fill="currentColor" />
      <path d="m15.25 9.25 4.5 5.5m0-5.5-4.5 5.5" fill="none" stroke="currentColor" stroke-linecap="round" stroke-width="1.75" />
    </svg>
  ) : (
    <svg viewBox="0 0 24 24" focusable="false">
      <path d="M5 9V5h4M15 5h4v4M19 15v4h-4M9 19H5v-4" fill="none" stroke="currentColor" stroke-linecap="square" stroke-width="1.75" />
    </svg>
  )}
</span>
