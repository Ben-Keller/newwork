---
import LogoIntro from './LogoIntro.astro';
import SplitFlapTicker from './SplitFlapTicker.astro';
import type { BrandAssetView, ProjectView } from '../lib/types';
interface Props { wordmark?: BrandAssetView; projects?: ProjectView[]; words?: string[]; cities?: string[] }
const { wordmark, projects, words = ['Film + photo', 'In production', 'New work'], cities = ['sf', 'la', 'nyc'] } = Astro.props;
---
<section class="home-identity" aria-label="New Work Agency" data-home-identity>
  <div class="home-identity__wordmark"><LogoIntro asset={wordmark} projects={projects} /></div>
  <div class="home-identity__dock" data-ticker-dock>
    <div class="home-departures" data-home-departures data-placement="docked">
      <SplitFlapTicker words={words} cities={cities} label="Film and photo production. San Francisco, Los Angeles, New York." cells={20} clock size="var(--home-flap-height)" />
    </div>
  </div>
</section>
<style>
  .home-identity { pointer-events: auto; display: grid; grid-template-columns: minmax(0, 1.9fr) minmax(0, 1fr); align-items: center; gap: clamp(2rem, 4vw, 5rem); min-height: min(68vh, 740px); padding: clamp(8rem, 15vh, 12rem) var(--page-gutter) clamp(4rem, 8vh, 7rem); max-width: 1800px; margin-inline: auto; }
  .home-identity__wordmark { color: #050505; }
  .home-identity__dock { min-width: 0; height: 115px; display: flex; align-items: center; }
  @media (max-width: 999px) { .home-identity { grid-template-columns: 1fr; gap: 2rem; min-height: auto; padding-block: 9rem 4rem; } .home-identity__wordmark { max-width: 760px; } .home-identity__dock { height: 100px; } }
  @media (max-width: 599px) { .home-identity { gap: 2rem; padding-block: 8rem 2.5rem; } .home-identity__dock { height: 85px; } }
  @media (max-width: 999px) and (prefers-reduced-motion: no-preference) {
    .home-identity { padding-block-end: max(4rem, var(--gallery-motion-clearance)); }
  }
  @media (prefers-reduced-motion: reduce) { .home-identity { transition: none; } }
</style>
<style is:global>
  .home-departures { --home-flap-height: clamp(1.2rem, 1.7vw, 1.65rem); z-index: 55; color: #151513; width: max-content; max-width: calc(100vw - 2 * var(--page-gutter)); }
  .home-departures[data-placement='floating'] { pointer-events: none; }
  .home-departures[hidden] { display: none; }
  @media (max-width: 999px) { .home-departures { --home-flap-height: clamp(1.2rem, 3.1vw, 1.8rem); } }
  @media (max-width: 359px) { .home-departures { --home-flap-height: 1.15rem; } }
</style>
<script>
  import { projectLabel } from '../lib/ticker';
  let disposeHome = () => {};
  function setupHome() {
    disposeHome();
    const dock = document.querySelector<HTMLElement>('[data-ticker-dock]');
    const board = dock?.querySelector<HTMLElement>('[data-home-departures]');
    const page = document.querySelector<HTMLElement>('[data-logo-work-page]');
    const gallery = document.querySelector<HTMLElement>('[data-work-gallery]');
    if (!dock || !board || !page || !gallery) return;
    const controller = new AbortController(); const { signal } = controller;
    const fine = matchMedia('(min-width: 1000px) and (hover: hover) and (pointer: fine)');
    const ticker = board.querySelector<HTMLElement>('[data-flap-ticker]')!;
    let hovered: HTMLElement | null = null; let focused: HTMLElement | null = null; let frame = 0;
    const setLabel = () => {
      const card = focused || hovered;
      ticker.dispatchEvent(new CustomEvent('new-work:ticker-label', { detail: { label: card ? projectLabel(card.dataset.tickerClient, card.dataset.tickerTitle || '') : '' } }));
    };
    const update = () => {
      frame = 0;
      const active = document.body.classList.contains('home-page') && page.dataset.handoff === 'true' && !gallery.closest('[data-gallery-layer-state="background"]');
      const bounds = gallery.getBoundingClientRect(); const anchor = dock.getBoundingClientRect();
      const floating = fine.matches && bounds.top < innerHeight * .54 && bounds.bottom > innerHeight * .52;
      const dockVisible = anchor.bottom > 0 && anchor.top < innerHeight;
      board.hidden = !active || (fine.matches && !floating && !dockVisible);
      board.dataset.placement = floating ? 'floating' : 'docked';
      if (fine.matches) {
        if (board.parentElement !== document.body) document.body.append(board);
        board.style.position = 'fixed';
        board.style.left = floating ? 'auto' : `${anchor.left}px`;
        board.style.right = floating ? 'max(1.5rem, env(safe-area-inset-right))' : 'auto';
        board.style.top = floating ? '50%' : `${anchor.top + (anchor.height - board.offsetHeight) / 2}px`;
        board.style.transform = floating ? 'translateY(-50%)' : 'none';
      } else {
        if (board.parentElement !== dock) dock.append(board);
        board.removeAttribute('style');
      }
    };
    const requestUpdate = () => { if (!frame) frame = requestAnimationFrame(update); };
    const cardAt = (target: EventTarget | null) => target instanceof Element ? target.closest<HTMLElement>('[data-project-card]') : null;
    gallery.addEventListener('pointerover', event => { if (event.pointerType === 'touch') return; const card = cardAt(event.target); if (card !== hovered) { hovered = card; setLabel(); } }, { signal });
    gallery.addEventListener('pointerleave', () => { hovered = null; setLabel(); }, { signal });
    gallery.addEventListener('focusin', event => { focused = cardAt(event.target); setLabel(); }, { signal });
    gallery.addEventListener('focusout', event => { focused = cardAt(event.relatedTarget); setLabel(); }, { signal });
    window.addEventListener('scroll', requestUpdate, { passive: true, signal });
    window.addEventListener('resize', requestUpdate, { passive: true, signal });
    document.addEventListener('new-work:work-layout-settled', requestUpdate, { signal });
    fine.addEventListener('change', requestUpdate, { signal });
    const state = new MutationObserver(requestUpdate); state.observe(page, { attributes: true, attributeFilter: ['data-handoff'] });
    const resize = new ResizeObserver(requestUpdate); resize.observe(dock); resize.observe(gallery);
    update();
    disposeHome = () => {
      controller.abort(); state.disconnect(); resize.disconnect(); if (frame) cancelAnimationFrame(frame);
      dock.append(board); board.removeAttribute('style'); board.hidden = false;
      disposeHome = () => {};
    };
  }
  setupHome();
  document.addEventListener('astro:page-load', setupHome);
  document.addEventListener('astro:before-swap', () => disposeHome());
</script>
