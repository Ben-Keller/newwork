<div class="site-scrollbar" data-site-scrollbar aria-hidden="true" hidden>
  <span class="site-scrollbar__thumb" data-site-scrollbar-thumb></span>
</div>

<script>
  declare global {
    interface Window {
      __newWorkScrollbarCleanup?: () => void;
    }
  }

  const setupScrollbar = (): void => {
    window.__newWorkScrollbarCleanup?.();
    const track = document.querySelector<HTMLElement>('[data-site-scrollbar]');
    const thumb = track?.querySelector<HTMLElement>('[data-site-scrollbar-thumb]');
    if (!track || !thumb) return;

    let frame = 0;
    let thumbHeight = 0;
    let thumbTravel = 0;
    let scrollRange = 0;
    let dragPointer: number | undefined;
    let dragStartY = 0;
    let dragStartScroll = 0;

    const render = (): void => {
      frame = 0;
      const scroller = document.scrollingElement as HTMLElement | null;
      const viewportHeight = window.innerHeight;
      const documentHeight = scroller?.scrollHeight ?? 0;
      scrollRange = Math.max(0, documentHeight - viewportHeight);
      const unavailable = scrollRange <= 1 || document.body.classList.contains('menu-open');
      track.hidden = unavailable;
      if (unavailable) return;

      const inset = 4;
      thumbHeight = Math.max(38, Math.min(
        viewportHeight - inset * 2,
        (viewportHeight * viewportHeight) / documentHeight,
      ));
      thumbTravel = Math.max(0, viewportHeight - thumbHeight - inset * 2);
      const progress = Math.min(1, Math.max(0, window.scrollY / scrollRange));
      thumb.style.height = `${thumbHeight}px`;
      thumb.style.transform = `translate3d(0, ${inset + progress * thumbTravel}px, 0)`;
    };

    const requestRender = (): void => {
      if (frame) return;
      frame = window.requestAnimationFrame(render);
    };

    const onPointerMove = (event: PointerEvent): void => {
      if (dragPointer !== event.pointerId || thumbTravel <= 0 || scrollRange <= 0) return;
      const scrollDelta = ((event.clientY - dragStartY) / thumbTravel) * scrollRange;
      window.scrollTo({ top: dragStartScroll + scrollDelta, behavior: 'auto' });
    };

    const clearDrag = (): void => {
      if (dragPointer === undefined) return;
      const pointerId = dragPointer;
      dragPointer = undefined;
      thumb.removeAttribute('data-dragging');
      if (thumb.hasPointerCapture(pointerId)) thumb.releasePointerCapture(pointerId);
    };

    const releasePointer = (event: PointerEvent): void => {
      if (dragPointer !== event.pointerId) return;
      clearDrag();
    };

    const onPointerDown = (event: PointerEvent): void => {
      if (event.button !== 0) return;
      event.preventDefault();
      dragPointer = event.pointerId;
      dragStartY = event.clientY;
      dragStartScroll = window.scrollY;
      thumb.dataset.dragging = 'true';
      thumb.setPointerCapture(event.pointerId);
    };

    const resizeObserver = 'ResizeObserver' in window
      ? new ResizeObserver(requestRender)
      : undefined;
    resizeObserver?.observe(document.body);
    const bodyObserver = new MutationObserver(requestRender);
    bodyObserver.observe(document.body, { attributes: true, attributeFilter: ['class'] });

    window.addEventListener('scroll', requestRender, { passive: true });
    window.addEventListener('resize', requestRender, { passive: true });
    thumb.addEventListener('pointerdown', onPointerDown);
    thumb.addEventListener('pointermove', onPointerMove);
    thumb.addEventListener('pointerup', releasePointer);
    thumb.addEventListener('pointercancel', releasePointer);
    thumb.addEventListener('lostpointercapture', clearDrag);
    window.addEventListener('pointerup', releasePointer, { capture: true });
    window.addEventListener('mouseup', clearDrag, { capture: true });
    window.addEventListener('blur', clearDrag);
    render();

    window.__newWorkScrollbarCleanup = () => {
      if (frame) window.cancelAnimationFrame(frame);
      resizeObserver?.disconnect();
      bodyObserver.disconnect();
      window.removeEventListener('scroll', requestRender);
      window.removeEventListener('resize', requestRender);
      thumb.removeEventListener('pointerdown', onPointerDown);
      thumb.removeEventListener('pointermove', onPointerMove);
      thumb.removeEventListener('pointerup', releasePointer);
      thumb.removeEventListener('pointercancel', releasePointer);
      thumb.removeEventListener('lostpointercapture', clearDrag);
      window.removeEventListener('pointerup', releasePointer, { capture: true });
      window.removeEventListener('mouseup', clearDrag, { capture: true });
      window.removeEventListener('blur', clearDrag);
      delete window.__newWorkScrollbarCleanup;
    };
  };

  setupScrollbar();
  document.addEventListener('astro:page-load', setupScrollbar);
  document.addEventListener('astro:before-swap', () => window.__newWorkScrollbarCleanup?.());
</script>

<style>
  .site-scrollbar {
    position: fixed;
    z-index: 3000;
    inset: 0 0 0 auto;
    width: 11px;
    height: 100svh;
    background: none;
    pointer-events: none;
  }

  .site-scrollbar__thumb {
    position: absolute;
    top: 0;
    right: 3px;
    width: 3px;
    min-height: 38px;
    border-radius: 999px;
    background: #fff;
    cursor: grab;
    mix-blend-mode: difference;
    opacity: .52;
    pointer-events: auto;
    touch-action: none;
    will-change: height, transform;
  }

  .site-scrollbar__thumb:is(:hover, [data-dragging="true"]) {
    width: 5px;
    opacity: .82;
  }

  .site-scrollbar__thumb[data-dragging="true"] { cursor: grabbing; }

  @media (hover: none), (pointer: coarse) {
    .site-scrollbar { display: none; }
  }

  @media print {
    .site-scrollbar { display: none; }
  }
</style>
