{
  "name": "new-work-site",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "brand:social": "node scripts/generate-social-share.mjs",
    "dev": "astro dev",
    "dev:cms": "PUBLIC_CONTENT_MODE=production PUBLIC_SITE_URL=https://local.new-work.invalid astro dev",
    "typecheck": "astro check",
    "lint": "eslint .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:chromium": "playwright test --project=desktop-chromium --project=mobile-chromium",
    "test:e2e:visual": "VISUAL_REGRESSION=1 playwright test tests/e2e/visual.spec.ts --project=desktop-chromium --project=mobile-chromium",
    "test:e2e:preview": "pnpm build && PLAYWRIGHT_PREVIEW_SERVER=1 playwright test",
    "test:all": "pnpm typecheck && pnpm lint && pnpm test:coverage && pnpm build && pnpm verify:dist && pnpm test:e2e:preview",
    "qa:capture": "node scripts/capture-qa.mjs",
    "build": "pnpm media:responsive && pnpm verify:media && pnpm content:attribution && astro build",
    "preview": "astro preview",
    "content:attribution": "node scripts/generate-attribution.mjs",
    "verify:dist": "node scripts/verify-dist.mjs",
    "media:responsive": "node scripts/generate-responsive-images.mjs",
    "media:video": "node scripts/optimize-local-videos.mjs",
    "verify:media": "node scripts/verify-media-budgets.mjs",
    "sanity:seed": "tsx scripts/seed-sanity.ts",
    "sanity:seed:dry-run": "tsx scripts/seed-sanity.ts --dry-run",
    "sanity:typegen": "npm --prefix ../studio-new-work run typegen"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.3",
    "@sanity/astro": "^3.5.1",
    "@sanity/client": "^7.26.2",
    "@sanity/image-url": "^2.1.1",
    "astro": "^7.2.1",
    "astro-portabletext": "^1.0.0",
    "groq": "^6.10.1",
    "gsap": "^3.15.0",
    "three": "0.185.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.4",
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.56.1",
    "@types/node": "^24.10.0",
    "@types/three": "^0.185.0",
    "@vitest/coverage-v8": "^4.0.4",
    "eslint": "^9.39.1",
    "eslint-plugin-astro": "^1.5.0",
    "groq-js": "^2.0.0",
    "sharp": "^0.35.3",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.3",
    "vitest": "^4.0.4"
  }
}
