---
import { michaelPhotoWork } from '../../content/local/michael-gallery';
import { withBase } from '../../lib/base-path';
import { getContentMode } from '../../lib/content';

export function getStaticPaths() {
  if (getContentMode() !== 'prototype') return [];
  return michaelPhotoWork.photos.map((photo) => ({
    params: {slug: photo.id},
    props: {photoId: photo.id},
  }));
}

interface Props { photoId: string }
const { photoId } = Astro.props;
const target = withBase(`/work/${michaelPhotoWork.slug}/${photoId}`);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="robots" content="noindex, nofollow" />
    <meta http-equiv="refresh" content={`0;url=${target}`} />
    <link rel="canonical" href={target} />
    <title>Work moved</title>
  </head>
  <body>
    <p><a href={target}>Continue to this Work page</a></p>
    <script is:inline define:vars={{target}}>window.location.replace(target);</script>
  </body>
</html>
