---
import AboutExperience from '../components/AboutExperience.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { withBase } from '../lib/base-path';
import { getSiteContent } from '../lib/content';
import '../styles/about-experience.css';

const content = await getSiteContent();
const aboutPage = content.settings.aboutPage;

const ctaHref = aboutPage.ctaDestination === 'work'
  ? withBase('/')
  : withBase('/contact');
---

<BaseLayout
  content={content}
  title="About"
  description="Lorem ipsum dolor sit amet, consectetur adipiscing elit."
  seo={{
    ...aboutPage.seo,
    metaTitle: 'About — New Work Agency',
    metaDescription: 'Lorem ipsum dolor sit amet, consectetur adipiscing elit.',
  }}
  pageClass="about-page"
>
  <AboutExperience
    assetBase={withBase('/')}
    copy={aboutPage}
    ctaHref={ctaHref}
  />
</BaseLayout>
