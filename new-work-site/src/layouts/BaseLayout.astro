---
import { ClientRouter } from 'astro:transitions';
import Analytics from '../components/Analytics.astro';
import MotionRuntime from '../components/MotionRuntime.astro';
import OverlayScrollbar from '../components/OverlayScrollbar.astro';
import SeoHead from '../components/SeoHead.astro';
import SiteFooter from '../components/SiteFooter.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SkipLink from '../components/SkipLink.astro';
import { buildResponsiveAvifSrcset, buildResponsiveSrcset } from '../lib/responsive-images';
import { storagePrefix, withBase, withoutBase } from '../lib/base-path';
import type { BrandAssetView, ImageView, ProjectTheme, SeoFields, SiteContent } from '../lib/types';
import '../styles/brand.css';
import '../styles/global.css';

interface Props {
  content: SiteContent;
  title?: string;
  description?: string;
  seo?: SeoFields;
  kind?: 'website' | 'project' | 'article';
  pageClass?: string;
  structuredData?: Record<string, unknown>;
  pageTheme?: ProjectTheme;
  pageAccent?: string;
  preloadImage?: ImageView;
  preloadMobileImage?: ImageView;
  preloadImageSizes?: string;
  showSiteChrome?: boolean;
  showSiteFooter?: boolean;
}

const {
  content,
  title,
  description,
  seo,
  kind = 'website',
  pageClass = '',
  structuredData,
  pageTheme,
  pageAccent,
  preloadImage,
  preloadMobileImage,
  preloadImageSizes = '100vw',
  showSiteChrome = true,
  showSiteFooter = showSiteChrome,
} = Astro.props;
const { mode, settings, notes } = content;
const headerSiteName = settings.siteName;
const suppliedBrandAsset: BrandAssetView = {
  src: withBase('/media/brand/new-black.svg'),
  width: 1641,
  height: 824,
};
const wordmarkAsset = settings.wordmark ?? suppliedBrandAsset;
const compactMarkAsset = settings.compactMark ?? wordmarkAsset;
const brandTone = pageTheme === 'dark' ? 'light' : 'dark';
const showNotes = settings.notesEnabled && notes.length > 0;
// Review round 2: the About page is archived (src/archive/about-experience)
// and not routed, so an About destination from the CMS has nowhere to go and
// is dropped from the menus rather than linking to a missing page.
const destinationHref: Partial<Record<'work' | 'about' | 'notes' | 'contact', string>> = {
  work: withBase('/'),
  notes: withBase('/notes'),
  contact: withBase('/contact'),
};
const navigationItems = settings.navigation
  .filter((item) => item.visible
    && Boolean(destinationHref[item.destination])
    && (item.destination !== 'notes' || showNotes))
  .map((item) => ({
    href: destinationHref[item.destination]!,
    label: item.label,
    match: 'section' as const,
  }));
const galleryOrderToolsEnabled = false;
const routePath = withoutBase(Astro.url.pathname).replace(/\/+$/u, '') || '/';
const safePageAccent = pageAccent && /^#[\da-f]{6}$/iu.test(pageAccent) ? pageAccent : undefined;
const pageStyle = safePageAccent ? `--project-page-accent:${safePageAccent}` : undefined;
const themeColor = pageClass.includes('project-page')
  ? pageTheme === 'dark'
    ? '#171716'
    : safePageAccent || '#e8e8e4'
  : '#f7f6f2';
const preloadSrcset = preloadImage ? buildResponsiveSrcset(preloadImage) : undefined;
const preloadAvifSrcset = preloadImage ? buildResponsiveAvifSrcset(preloadImage) : undefined;
const preloadMobileSrcset = preloadMobileImage ? buildResponsiveSrcset(preloadMobileImage) : undefined;
const preloadMobileAvifSrcset = preloadMobileImage
  ? buildResponsiveAvifSrcset(preloadMobileImage)
  : undefined;
const avifHref = (image: ImageView) => image.src.replace(/\.webp$/iu, '.avif');
const isWorkProject = pageClass.includes('project-page');
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content={themeColor} />
    <link rel="icon" type="image/svg+xml" sizes="any" href={withBase('/favicon.svg?v=nw-2')} />
    <link rel="apple-touch-icon" sizes="180x180" href={withBase('/apple-touch-icon.png?v=nw-2')} />
    <link rel="mask-icon" href={withBase('/favicon-mask.svg?v=nw-2')} color="#111111" />
    <script is:inline define:vars={{ storagePrefix }}>
      (() => {
        const navigation = performance.getEntriesByType('navigation')[0];
        const isReload = navigation?.type === 'reload';
        if (!isReload) return;

        history.scrollRestoration = 'manual';
        sessionStorage.removeItem(`${storagePrefix}new-work-restore-requested`);
        const resetToTop = () => window.scrollTo({ top: 0, left: 0, behavior: 'auto' });
        resetToTop();
        window.addEventListener('pageshow', () => {
          resetToTop();
          requestAnimationFrame(() => requestAnimationFrame(() => {
            resetToTop();
            history.scrollRestoration = 'auto';
          }));
        }, { once: true });
      })();
    </script>
    {preloadImage ? (
      <>
        {preloadMobileImage ? (
          <link
            rel="preload"
            as="image"
            href={preloadMobileAvifSrcset ? avifHref(preloadMobileImage) : preloadMobileImage.src}
            imagesrcset={preloadMobileAvifSrcset || preloadMobileSrcset}
            imagesizes={preloadImageSizes}
            type={preloadMobileAvifSrcset ? 'image/avif' : undefined}
            media="(max-width: 767px)"
            fetchpriority="high"
          />
        ) : null}
        <link
          rel="preload"
          as="image"
          href={preloadAvifSrcset ? avifHref(preloadImage) : preloadImage.src}
          imagesrcset={preloadAvifSrcset || preloadSrcset}
          imagesizes={preloadImageSizes}
          type={preloadAvifSrcset ? 'image/avif' : undefined}
          media={preloadMobileImage ? '(min-width: 768px)' : undefined}
          fetchpriority="high"
        />
      </>
    ) : null}
    <ClientRouter fallback="swap" />
    <SeoHead
      siteName={headerSiteName}
      title={title}
      description={description}
      pathname={Astro.url.pathname}
      mode={mode}
      seo={seo}
      defaultSeo={settings.defaultSeo}
      kind={kind}
      structuredData={structuredData}
    />
  </head>
  <body
    class:list={[pageClass, mode !== 'production' && 'prototype-mode', `content-mode-${mode}`]}
    data-page-theme={pageTheme}
    style={pageStyle}
  >
    {showSiteChrome ? <SkipLink /> : null}
    {showSiteChrome ? (
      <SiteHeader
        currentPath={routePath}
        showNotes={showNotes}
        siteName={headerSiteName}
        navItems={navigationItems}
        wordmarkAsset={wordmarkAsset}
        compactMarkAsset={compactMarkAsset}
        tone={brandTone}
        galleryEditing={galleryOrderToolsEnabled && mode !== 'production'}
      />
    ) : null}
    <main id="main-content" tabindex="-1" data-motion-root>
      {isWorkProject ? (
        <>
          <div
            class="route-gallery-layer"
            data-route-gallery-layer
            transition:persist="new-work-gallery-scene"
          ></div>
          <div class="route-project-layer" data-route-project-layer>
            <slot />
          </div>
        </>
      ) : (
        <slot />
      )}
    </main>
    {showSiteFooter ? (
      <SiteFooter
        siteName={headerSiteName}
        featuredProjects={content.galleryEntries.map(({ work }) => work)}
        peopleHeading={settings.footer.peopleHeading}
        copyrightLine={settings.footer.copyrightLine}
        wordmarkAsset={wordmarkAsset}
        tone={brandTone}
        showYear={settings.footer.showYear}
      />
    ) : null}
    <Analytics mode={mode} />
    <OverlayScrollbar />
    <MotionRuntime />
  </body>
</html>
