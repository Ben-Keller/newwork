---
import { tickerPages } from '../lib/ticker';
interface Props {
  words?: readonly string[]; label?: string; size?: string; class?: string;
  cells?: number; rows?: number; clock?: boolean; cities?: readonly string[];
}
const { words = ['Photo', 'Creative', 'Film'], label = words.join(', '), size, class: className, cells = 10, rows = 1, clock = false, cities = ['sf', 'la', 'nyc'] } = Astro.props;
const first = tickerPages(words[0] || 'New Work', cells, rows)[0]!;
---
<div class:list={['flap-ticker', className]} data-flap-ticker data-ticker-words={JSON.stringify(words)} data-ticker-columns={cells} data-ticker-rows={rows} data-ticker-clock={String(clock)} data-ticker-cities={JSON.stringify(cities)} style={`--flap-columns:${cells};${size ? `--flap-height:${size}` : ''}`}>
  <span class="sr-only" data-ticker-accessible>{label}</span>
  <span class="flap-ticker__board" aria-hidden="true">
    {[...first].map(glyph => <span class="flap" data-flap>
      <span class="flap__half flap__half--top"><span data-flap-top>{glyph}</span></span>
      <span class="flap__half flap__half--bottom"><span data-flap-glyph>{glyph}</span></span>
      <span class="flap__leaf flap__leaf--top"><span data-flap-leaf-top>{glyph}</span></span>
      <span class="flap__leaf flap__leaf--bottom"><span data-flap-leaf-bottom>{glyph}</span></span>
    </span>)}
  </span>
</div>
<style>
  .flap-ticker { --flap-height: clamp(1.5rem, 2.1vw, 2.25rem); --flap-gap: clamp(1px, .14vw, 2px); display: inline-block; vertical-align: bottom; container-type: inline-size; width: calc(var(--flap-columns) * var(--flap-height) * .64 + (var(--flap-columns) - 1) * var(--flap-gap) + 6px); max-width: 100%; min-width: 0; }
  .flap-ticker__board { display: grid; position: relative; width: 100%; grid-template-columns: repeat(var(--flap-columns), minmax(0, 1fr)); gap: var(--flap-gap); padding: 3px; background: #0b0b0b; border-radius: 2px; }
  /* Fit the type and tall tiles to the available width together, keeping one line. */
  .flap { --fitted-height: min(var(--flap-height), calc((100cqi - 6px - (var(--flap-columns) - 1) * var(--flap-gap)) / var(--flap-columns) / .64)); --tile-height: calc(var(--fitted-height) * 1.35); display: block; position: relative; width: 100%; height: var(--tile-height); color: #f4f0e5; font: 700 calc(var(--fitted-height) * .76)/var(--tile-height) var(--font-body); font-variant-numeric: tabular-nums; text-align: center; perspective: calc(var(--tile-height) * 6); }
  .flap__half, .flap__leaf { position: absolute; left: 0; width: 100%; height: 50%; overflow: hidden; background: #171715; backface-visibility: hidden; }
  .flap__half--top, .flap__leaf--top { top: 0; border-radius: 2px 2px 0 0; background: linear-gradient(#292926, #20201d); transform-origin: 50% 100%; }
  .flap__half--bottom, .flap__leaf--bottom { bottom: 0; border-radius: 0 0 2px 2px; transform-origin: 50% 0; }
  .flap__half > span, .flap__leaf > span { position: absolute; left: 0; width: 100%; height: 200%; white-space: pre; }
  .flap__half--top > span, .flap__leaf--top > span { top: 0; }
  .flap__half--bottom > span, .flap__leaf--bottom > span { top: -100%; }
  .flap__leaf { visibility: hidden; }
  .flap[data-flipping] .flap__leaf { visibility: visible; }
  .flap__leaf--bottom { transform: rotateX(90deg); }
  .flap::after { content: ''; position: absolute; inset: 50% 0 auto; height: 1px; background: #000; z-index: 1; }
</style>
<script>
  import { createFlapMotion } from '../lib/ticker-motion';
  import { CITY_CLOCKS, cityTime, tickerPages } from '../lib/ticker';
  let disposeAll = () => {};
  function setupTickers() {
    disposeAll();
    const cleanups: Array<() => void> = [];
    document.querySelectorAll<HTMLElement>('[data-flap-ticker]').forEach(ticker => {
      const controller = new AbortController(); const { signal } = controller;
      const words: string[] = JSON.parse(ticker.dataset.tickerWords || '[]');
      const columns = Number(ticker.dataset.tickerColumns); const rows = Number(ticker.dataset.tickerRows);
      const cityKeys: string[] = JSON.parse(ticker.dataset.tickerCities || '[]');
      const cityIndexes = cityKeys.map(key => CITY_CLOCKS.findIndex(city => city.city.toLowerCase() === key)).filter(index => index >= 0);
      const clock = ticker.dataset.tickerClock === 'true' && cityIndexes.length > 0;
      // Each city clock is a complete entry, interleaved with the agency messages.
      // Resolve times when displayed so returning from a project never shows a stale clock.
      const entries: Array<() => string> = [];
      for (let i = 0; i < Math.max(words.length, clock ? cityIndexes.length : 0); i++) {
        const word = words[i];
        if (word) entries.push(() => word);
        if (clock && i < cityIndexes.length) entries.push(() => cityTime(cityIndexes[i]!, new Date(), 'board'));
      }
      if (!entries.length) entries.push(() => 'New Work');
      const motion = createFlapMotion(ticker);
      const reduced = matchMedia('(prefers-reduced-motion: reduce)');
      let index = 0; let pageIndex = 0; let label = ''; let visible = true; let pageCount = 1;
      let rotation = 0; let minute = 0;
      const render = (animate = true) => {
        const value = label || entries[index % entries.length]!();
        const pages = tickerPages(value, columns, rows);
        pageCount = pages.length;
        const target = pages[pageIndex % pages.length]!;
        ticker.dataset.tickerText = value;
        const accessible = ticker.querySelector<HTMLElement>('[data-ticker-accessible]');
        if (accessible) accessible.textContent = label || `${words.join('. ')}${clock ? `. Local times: ${cityIndexes.map(i => cityTime(i)).join(', ')}.` : ''}`;
        motion.render(target, animate && visible && !reduced.matches && !document.hidden, label ? 'interactive' : 'ambient');
      };
      const scheduleRotation = () => {
        clearTimeout(rotation);
        if (document.hidden || !visible || reduced.matches || (label && pageCount === 1)) return;
        rotation = window.setTimeout(() => {
          if (label) pageIndex = (pageIndex + 1) % pageCount;
          else if (++pageIndex >= pageCount) { pageIndex = 0; index = (index + 1) % entries.length; }
          render(); scheduleRotation();
        }, label ? 4200 : 5000);
      };
      const scheduleMinute = () => {
        clearTimeout(minute);
        if (!clock || document.hidden) return;
        minute = window.setTimeout(() => { if (!label) render(false); scheduleMinute(); }, 60_000 - Date.now() % 60_000 + 20);
      };
      ticker.addEventListener('new-work:ticker-label', ((event: CustomEvent<{ label?: string }>) => {
        const nextLabel = event.detail.label || '';
        if (nextLabel === label) return;
        label = nextLabel; pageIndex = 0; render(); scheduleRotation();
      }) as EventListener, { signal });
      const observer = new IntersectionObserver(entries => { visible = entries[0]?.isIntersecting ?? false; if (!visible) render(false); scheduleRotation(); }, { rootMargin: '80px' });
      observer.observe(ticker);
      document.addEventListener('visibilitychange', () => { render(false); scheduleRotation(); scheduleMinute(); }, { signal });
      reduced.addEventListener('change', () => { render(false); scheduleRotation(); }, { signal });
      render(false); scheduleRotation(); scheduleMinute();
      cleanups.push(() => { controller.abort(); observer.disconnect(); clearTimeout(rotation); clearTimeout(minute); motion.dispose(); });
    });
    disposeAll = () => { cleanups.forEach(cleanup => cleanup()); disposeAll = () => {}; };
  }
  setupTickers();
  document.addEventListener('astro:page-load', setupTickers);
  document.addEventListener('astro:before-swap', () => disposeAll());
</script>
