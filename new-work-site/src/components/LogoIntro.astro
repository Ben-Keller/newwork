  .logo-intro__type-line { pointer-events: none; }

  .logo-intro__type-letter-canvas {
    position: absolute;
    z-index: 2;
    inset: 0;
    width: 100%;
    height: 100%;
    opacity: 0;
    transition: opacity .42s cubic-bezier(.22, 1, .36, 1);
    pointer-events: none;
  }

  /* Gallery hover uses individual letter canvases. Splash hover is drawn once
     through the whole title by the shared canvas, keeping both words continuous. */
  .logo-intro__type-letter-canvas[data-media-ready="true"] {
    z-index: 3;
  }

  .logo-intro__type-letter-canvas[data-media-ready="true"] { opacity: 1; }

  .logo-intro__type-letter-video {
    position: fixed;
    width: 1px;
    height: 1px;
    inset: auto auto 0 0;
    opacity: 0;
    pointer-events: none;
