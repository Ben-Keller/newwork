---
import ResponsiveImage from './ResponsiveImage.astro';
import { inferVideoMimeType } from './media/video-mime';
import { withBase } from '../lib/base-path';
import type { ImageView, ProjectView } from '../lib/types';
import legacyTitleWordmark from '../assets/brand/new-work-letters.svg?raw';
import legacyTitleManifest from '../assets/brand/new-work-letter-manifest.json';
import sentenceTitleWordmark from '../assets/brand/new-work-sentence-letters.svg?raw';
import sentenceTitleManifest from '../assets/brand/new-work-sentence-letter-manifest.json';
import titleTitleWordmark from '../assets/brand/new-work-title-letters.svg?raw';
import titleTitleManifest from '../assets/brand/new-work-title-letter-manifest.json';

const TITLE_KITS = {
  legacy: {
    assetRoot: withBase('/media/brand/new-work-letter-kit'),
    inlineScale: 1,
    manifest: legacyTitleManifest,
    maskFile: 'new-work-letters.svg',
    sessionKey: 'new-work:logo-intro:v3',
    source: 'new-work-letter-kit',
    wordmark: legacyTitleWordmark,
  },
  'sentence-clean': {
    assetRoot: withBase('/media/brand/new-work-sentence-clean-letter-kit'),
    inlineScale: 1,
    manifest: sentenceTitleManifest,
    maskFile: 'new-work-sentence-letters.svg',
    sessionKey: 'new-work:logo-intro:sentence-clean:v1',
    source: 'new-work-sentence-clean-letter-kit',
    wordmark: sentenceTitleWordmark,
  },
  title: {
    assetRoot: withBase('/media/brand/new-work-title-letter-kit'),
    inlineScale: 0.92,
    manifest: titleTitleManifest,
    maskFile: 'new-work-title-letters.svg',
    sessionKey: 'new-work:logo-intro:title:v1',
    source: 'new-work-title-letter-kit',
    wordmark: titleTitleWordmark,
  },
} as const;

// Switch this single value to `sentence-clean` or `legacy` to restore an earlier title kit.
const ACTIVE_TITLE_KIT: keyof typeof TITLE_KITS = 'title';
// Switch this to `svg-kit` to restore the masked, per-letter artwork above.
const ACTIVE_TITLE_TREATMENT = 'type' as 'type' | 'svg-kit';
// Keep the authored five-second sequence available, but load directly into
// the black wordmark while the current design is being reviewed.
const TITLE_ENTRANCE_ENABLED = false;
const titleKit = TITLE_KITS[ACTIVE_TITLE_KIT];
const usesTypeTitle = ACTIVE_TITLE_TREATMENT === 'type';

export interface Props {
  siteName?: string;
  descriptor?: string;
  projects?: ProjectView[];
  duration?: number;
  sessionKey?: string;
  class?: string;
}

const {
  descriptor = 'film + photo production agency',
  projects = [],
  duration = 5_000,
  sessionKey = titleKit.sessionKey,
  class: className,
} = Astro.props;

const boundedDuration = Math.min(5_200, Math.max(4_800, duration));
const mediaProjects = projects.filter((project) => project.cover.poster).slice(0, 8);
const motionProject = mediaProjects.find((project) => project.cover.previewVideo);
const motionVideoSource = motionProject?.cover.previewVideo;
const motionVideoPoster = motionProject?.cover.previewPosterOverride?.src || motionProject?.cover.poster.src;
const cellCount = Math.min(4, mediaProjects.length);
const cells = Array.from({ length: cellCount }, (_, index) => ({
  primary: mediaProjects[index % mediaProjects.length],
  alternate: mediaProjects[(index + cellCount) % mediaProjects.length],
}));
const typeLetterAssignments = [
  { slug: 'stella-artois-daydream', position: '0.52,0.48' },
  { slug: 'native-cucumber-mint-stop-motion', position: '0.5,0.5' },
  { slug: 'adobe', position: '0.52,0.46' },
  { slug: 'tour-de-france-x-toyota', position: '0.62,0.5' },
  { slug: 'specialized-globe', position: '0.5,0.52' },
  { slug: 'rakuten', position: '0.48,0.5' },
  { slug: 'olympics-toyota-in-due-time', position: '0.5,0.5' },
] as const;
const typeLetterProjects = typeLetterAssignments.map(({ slug }) =>
  projects.find((project) => project.slug === slug));
const typeWords = ['new', 'work'].map((word, wordIndex) => ({
  word,
  letters: [...word].map((glyph, letterIndex) => {
    const index = (wordIndex === 0 ? 0 : 3) + letterIndex;
    const primary = typeLetterProjects[index] || mediaProjects[(index + 1) % Math.max(1, mediaProjects.length)];
    const alternate = typeLetterProjects[(index + 3) % typeLetterProjects.length] || primary;
    const videoSource = primary?.cover.previewVideo;
    return {
      glyph,
      index,
      position: typeLetterAssignments[index]?.position || '0.5,0.5',
      poster: primary?.cover.previewPosterOverride?.src || primary?.cover.poster.src,
      videoMime: videoSource ? inferVideoMimeType(videoSource) : undefined,
      videoSource,
      style: primary
        ? `--type-letter-primary:url("${primary.cover.poster.src}");--type-letter-alternate:url("${alternate!.cover.poster.src}")`
        : undefined,
    };
  }),
}));
const decorative = (image: ImageView): ImageView => ({ ...image, alt: '' });
const titleAssetRoot = titleKit.assetRoot;
const titleManifest = titleKit.manifest;
const [, , titleWidth = 1, titleHeight = 1] = titleManifest.wordmarkViewBox
  .split(' ')
  .map(Number);
const introStyle = [
  `--logo-intro-duration:${boundedDuration}ms`,
  `--logo-title-aspect:${titleWidth} / ${titleHeight}`,
  `--logo-title-inline-size:${titleKit.inlineScale * 100}%`,
  `--logo-title-mask:url("${titleAssetRoot}/${titleKit.maskFile}")`,
].join(';');
const motionMime = motionVideoSource
  ? inferVideoMimeType(motionVideoSource)
  : undefined;
const motionProjects = mediaProjects.filter((project) => project.cover.previewVideo);
const letterMedia = mediaProjects.length ? titleManifest.letters.map((definition, index) => {
  const fallback = mediaProjects[index % mediaProjects.length];
  const videoProject = index % 3 === 0 && motionProjects.length
    ? motionProjects[Math.floor(index / 3) % motionProjects.length]
    : undefined;
  const primary = videoProject || fallback;
  const alternate = mediaProjects[(index + Math.max(1, Math.floor(mediaProjects.length / 2))) % mediaProjects.length]
    || primary;
  const videoSource = videoProject?.cover.previewVideo;
  const [viewBoxX, , viewBoxWidth] = definition.viewBox;
  const filename = definition.file.split('/').at(-1);
  return {
    index,
    primary,
    alternate,
    videoSource,
    videoPoster: videoProject?.cover.previewPosterOverride?.src || videoProject?.cover.poster.src,
    videoMime: videoSource ? inferVideoMimeType(videoSource) : undefined,
    mask: `${titleAssetRoot}/letters/${filename}`,
    left: `${(viewBoxX! / titleWidth) * 100}%`,
    width: `${(viewBoxWidth! / titleWidth) * 100}%`,
  };
}) : [];
const titleWordmarkMarkup = titleKit.wordmark
  .replace(/^<\?xml[^>]*>\s*/u, '')
  // The inline source color would paint this SVG above the animated media.
  // This copy is only the exact per-letter hover map; the solid layer below
  // owns the resting black title.
  .replace(/(<svg\b[^>]*?)\sstyle="[^"]*"/u, '$1');
---

<section
  class:list={['logo-intro', className]}
  style={introStyle}
  data-logo-intro
  data-state="pending"
  data-duration={boundedDuration}
  data-session-key={sessionKey}
  data-title-layout={usesTypeTitle ? 'stacked' : 'single-line'}
  data-title-source={usesTypeTitle ? 'pp-neue-montreal' : titleKit.source}
  data-title-treatment={ACTIVE_TITLE_TREATMENT}
  data-entrance-enabled={TITLE_ENTRANCE_ENABLED ? 'true' : 'false'}
>
  {usesTypeTitle ? (
    <div class="logo-intro__type-lockup" data-type-lockup>
      <div class="logo-intro__type-title" data-type-title aria-hidden="true">
        {typeWords.map(({ word, letters }, wordIndex) => (
          <span
            class:list={[
              'logo-intro__type-line',
              wordIndex === 0 ? 'logo-intro__type-line--outline' : 'logo-intro__type-line--solid',
            ]}
            data-type-title-line={word}
          >
            {wordIndex === 0 ? (
              <span class="logo-intro__mobile-outline-word" aria-hidden="true">new</span>
            ) : null}
            {letters.map(({ glyph, index, position, poster, style, videoMime, videoSource }) => (
              <span
                class="logo-intro__type-letter"
                data-type-letter={index}
                data-glyph={glyph}
                style={style}
              >
                <span class="logo-intro__type-letter-rest">
                  <span data-type-letter-glyph>{glyph}</span><span
                    class="logo-intro__type-letter-baseline"
                    data-type-letter-baseline
                  ></span>
                </span>
                <canvas class="logo-intro__type-letter-canvas" data-type-letter-canvas aria-hidden="true"></canvas>
                {videoSource ? (
                  <video
                    class="logo-intro__type-letter-video"
                    muted
                    loop
                    playsinline
                    preload="none"
                    poster={poster}
                    data-type-letter-video
                    data-object-position={position}
                    aria-hidden="true"
                  >
                    <source data-type-letter-video-source data-src={videoSource} type={videoMime} />
                  </video>
                ) : null}
              </span>
            ))}
          </span>
        ))}
      </div>
      {descriptor ? <p class="logo-intro__descriptor" data-logo-descriptor>{descriptor}</p> : null}
    </div>
  ) : (
  <>
  <div class="logo-intro__stage" data-svg-title aria-hidden="true">
    <div class="logo-intro__solid" data-intro-solid></div>
    <div class="logo-intro__media" data-intro-media>
      <div class="logo-intro__mosaic">
        {cells.map(({ primary, alternate }, index) => (
          <div class="logo-intro__cell" data-intro-cell>
            <div class="logo-intro__face logo-intro__face--primary" data-intro-primary>
              <ResponsiveImage
                image={decorative(primary!.cover.poster)}
                mobileImage={primary!.cover.mobilePoster ? decorative(primary!.cover.mobilePoster!) : undefined}
                sizes="(min-width: 768px) 25vw, 50vw"
                eager={index < 2}
              />
              {primary?.id === motionProject?.id && motionVideoSource ? (
                <video
                  muted
                  loop
                  playsinline
                  preload="none"
                  poster={motionVideoPoster}
                  data-intro-video
                >
                  <source
                    data-intro-video-source
                    data-src={motionVideoSource}
                    data-type={motionMime}
                    type={motionMime}
                  />
                </video>
              ) : null}
            </div>
            <div class="logo-intro__face logo-intro__face--alternate" data-intro-alternate>
              <ResponsiveImage
                image={decorative((alternate || primary)!.cover.poster)}
                mobileImage={(alternate || primary)!.cover.mobilePoster
                  ? decorative((alternate || primary)!.cover.mobilePoster!)
                  : undefined}
                sizes="(min-width: 768px) 25vw, 50vw"
              />
            </div>
          </div>
        ))}
      </div>
    </div>
    <div class="logo-intro__letter-media" data-intro-letter-media>
      {letterMedia.map((letter) => (
        <div
          class="logo-intro__letter-layer"
          style={`--logo-letter-mask:url("${letter.mask}");--logo-letter-left:${letter.left};--logo-letter-width:${letter.width}`}
          data-intro-letter-layer
          data-letter-index={letter.index}
          data-letter-kind={letter.videoSource ? 'video' : 'flip'}
        >
          <div class="logo-intro__letter-face logo-intro__letter-face--primary" data-intro-letter-primary>
            <ResponsiveImage
              image={decorative(letter.primary!.cover.poster)}
              mobileImage={letter.primary!.cover.mobilePoster ? decorative(letter.primary!.cover.mobilePoster!) : undefined}
              sizes="100vw"
            />
            {letter.videoSource ? (
              <video
                muted
                loop
                playsinline
                preload="none"
                poster={letter.videoPoster}
                data-intro-letter-video
              >
                <source
                  data-intro-letter-video-source
                  data-src={letter.videoSource}
                  data-type={letter.videoMime}
                  type={letter.videoMime}
                />
              </video>
            ) : null}
          </div>
          <div class="logo-intro__letter-face logo-intro__letter-face--alternate" data-intro-letter-alternate>
            <ResponsiveImage
              image={decorative(letter.alternate!.cover.poster)}
              mobileImage={letter.alternate!.cover.mobilePoster ? decorative(letter.alternate!.cover.mobilePoster!) : undefined}
              sizes="100vw"
            />
          </div>
        </div>
      ))}
    </div>
    <div
      class="logo-intro__letter-triggers"
      data-intro-letter-triggers
      aria-hidden="true"
      set:html={titleWordmarkMarkup}
    ></div>
  </div>
  {descriptor ? <p class="logo-intro__descriptor" data-logo-descriptor>{descriptor}</p> : null}
  </>
  )}
  <noscript><style>.logo-intro__media{display:none!important}</style></noscript>
</section>

<script>
  import { prefersReducedData } from '../lib/motion/reduced-data';

  let logoIntroRouteController = new AbortController();

  const disposeLogoIntroRoute = (): void => {
    logoIntroRouteController.abort();
    logoIntroRouteController = new AbortController();
  };

  document.addEventListener('astro:before-swap', disposeLogoIntroRoute);

  const settleIntro = (intro: HTMLElement): void => {
    intro.dataset.state = 'settled';
    intro.querySelectorAll<HTMLVideoElement>('[data-intro-video]').forEach((video) => {
      video.pause();
      const source = video.querySelector<HTMLSourceElement>('[data-intro-video-source]');
      source?.removeAttribute('src');
      video.removeAttribute('src');
      video.load();
    });
  };

  const markIntroSettled = (): void => {
    document.documentElement.removeAttribute('data-logo-intro-playing');
  };

  const initializeLogoIntros = (): void => {
    const intros = document.querySelectorAll<HTMLElement>('[data-logo-intro]:not([data-intro-ready])');

    intros.forEach((intro) => {
      intro.dataset.introReady = 'true';
      const duration = Number.parseInt(intro.dataset.duration ?? '5000', 10);
      const boundedDuration = Number.isFinite(duration) ? Math.min(5_200, Math.max(4_800, duration)) : 5_000;
      const sessionKey = intro.dataset.sessionKey ?? 'new-work:logo-intro:v3';
      const playEntrance = intro.dataset.entranceEnabled === 'true';
      const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      const saveData = prefersReducedData();
      const routeSignal = logoIntroRouteController.signal;
      if (routeSignal.aborted) return;

      if (intro.dataset.titleTreatment === 'type') {
        const letters = [...intro.querySelectorAll<HTMLElement>('[data-type-letter]')];
        const lines = [...intro.querySelectorAll<HTMLElement>('[data-type-title-line]')];
        let activeLetter: HTMLElement | null = null;
        let renderFrame = 0;

        const stopActiveLetter = (): void => {
          if (renderFrame) window.cancelAnimationFrame(renderFrame);
          renderFrame = 0;
          if (!activeLetter) return;
          activeLetter.removeAttribute('data-type-active');
          const canvas = activeLetter.querySelector<HTMLCanvasElement>('[data-type-letter-canvas]');
          const video = activeLetter.querySelector<HTMLVideoElement>('[data-type-letter-video]');
          video?.pause();
          canvas?.removeAttribute('data-media-ready');
          activeLetter.removeAttribute('data-type-media-ready');
          activeLetter = null;
        };

        const renderLetterVideo = (letter: HTMLElement): void => {
          const canvas = letter.querySelector<HTMLCanvasElement>('[data-type-letter-canvas]');
          const video = letter.querySelector<HTMLVideoElement>('[data-type-letter-video]');
          const rest = letter.querySelector<HTMLElement>('.logo-intro__type-letter-rest');
          const glyphElement = letter.querySelector<HTMLElement>('[data-type-letter-glyph]');
          const baselineMarker = letter.querySelector<HTMLElement>('[data-type-letter-baseline]');
          if (!canvas || !video || !rest || !glyphElement || !baselineMarker || activeLetter !== letter) return;
          const rect = letter.getBoundingClientRect();
          const scale = Math.min(window.devicePixelRatio || 1, 2);
          const width = Math.max(1, Math.round(rect.width));
          const height = Math.max(1, Math.round(rect.height));
          const styles = getComputedStyle(glyphElement);
          const letterSpacing = Number.parseFloat(styles.letterSpacing) || 0;
          // The inline box includes the negative tracking used to overlap the
          // title letters. Restore that trimmed advance only for the painted
          // canvas so the glyph's right edge is not clipped.
          const paintWidth = width + Math.max(0, -letterSpacing);
          const pixelWidth = Math.round(paintWidth * scale);
          const pixelHeight = Math.round(height * scale);
          canvas.style.width = `${paintWidth}px`;
          if (canvas.width !== pixelWidth || canvas.height !== pixelHeight) {
            canvas.width = pixelWidth;
            canvas.height = pixelHeight;
          }
          const context = canvas.getContext('2d');
          if (context && video.readyState >= 2 && video.videoWidth && video.videoHeight) {
            context.setTransform(scale, 0, 0, scale, 0, 0);
            context.clearRect(0, 0, paintWidth, height);
            const [positionX = .5, positionY = .5] = (video.dataset.objectPosition || '.5,.5')
              .split(',')
              .map(Number);
            const mediaScale = Math.max(paintWidth / video.videoWidth, height / video.videoHeight);
            const mediaWidth = video.videoWidth * mediaScale;
            const mediaHeight = video.videoHeight * mediaScale;
            context.drawImage(
              video,
              (paintWidth - mediaWidth) * positionX,
              (height - mediaHeight) * positionY,
              mediaWidth,
              mediaHeight,
            );
            context.globalCompositeOperation = 'destination-in';
            context.font = `${styles.fontWeight} ${styles.fontSize} ${styles.fontFamily}`;
            context.textBaseline = 'alphabetic';
            context.fillStyle = '#fff';
            const glyph = letter.dataset.glyph || '';
            const markerRect = baselineMarker.getBoundingClientRect();
            const baseline = markerRect.top - rect.top;
            // Use the browser's real inline baseline instead of centering from
            // canvas font metrics. The latter differs substantially for the
            // very tight title line-height and shifts the media glyph upward.
            context.fillText(glyph, 0, baseline);
            context.globalCompositeOperation = 'source-over';
            canvas.dataset.mediaReady = 'true';
            letter.dataset.typeMediaReady = 'true';
          }
          renderFrame = window.requestAnimationFrame(() => renderLetterVideo(letter));
        };

        const startLetter = (letter: HTMLElement): void => {
          if (activeLetter === letter) return;
          stopActiveLetter();
          activeLetter = letter;
          letter.dataset.typeActive = 'true';
          const video = letter.querySelector<HTMLVideoElement>('[data-type-letter-video]');
          const source = video?.querySelector<HTMLSourceElement>('[data-type-letter-video-source]');
          if (!reducedMotion && !saveData && video && source?.dataset.src) {
            if (!source.hasAttribute('src')) {
              source.src = source.dataset.src;
              video.load();
            }
            void video.play().catch(() => undefined);
            renderLetterVideo(letter);
          }
        };

        lines.forEach((line) => {
          const lineLetters = letters.filter((letter) => letter.parentElement === line);
          line.addEventListener('pointermove', (event) => {
            const nearest = lineLetters.reduce<HTMLElement | null>((closest, letter) => {
              const rect = letter.getBoundingClientRect();
              if (!closest) return letter;
              const closestRect = closest.getBoundingClientRect();
              return Math.abs(event.clientX - (rect.left + rect.width / 2))
                < Math.abs(event.clientX - (closestRect.left + closestRect.width / 2))
                ? letter
                : closest;
            }, null);
            if (nearest) startLetter(nearest);
          });
          line.addEventListener('pointerleave', stopActiveLetter);
          line.addEventListener('pointercancel', stopActiveLetter);
        });
        routeSignal.addEventListener('abort', stopActiveLetter, { once: true });
        markIntroSettled();
        settleIntro(intro);
        return;
      }

      let skipIntro = false;
      try {
        // A dedicated sentinel keeps automated visual checks fast without
        // allowing a stale value from an earlier prototype to suppress the
        // title mask or its post-intro letter interactions for real visitors.
        skipIntro = window.sessionStorage.getItem(sessionKey) === 'test-skip';
      } catch {
        // Storage can be unavailable in privacy modes; the animation remains safe.
      }
      const shouldPlayEntrance = playEntrance && !skipIntro;

      if (reducedMotion || saveData) {
        markIntroSettled();
        settleIntro(intro);
        return;
      }

      if (shouldPlayEntrance) document.documentElement.dataset.logoIntroPlaying = sessionKey;

      let animationFrameId = 0;
      let cleanupStartedIntro: (() => void) | null = null;
      const disposeIntro = (): void => {
        if (animationFrameId) window.cancelAnimationFrame(animationFrameId);
        animationFrameId = 0;
        cleanupStartedIntro?.();
        cleanupStartedIntro = null;
        if (
          intro.dataset.state !== 'settled'
          && document.documentElement.dataset.logoIntroPlaying === sessionKey
        ) {
          document.documentElement.removeAttribute('data-logo-intro-playing');
        }
      };

      routeSignal.addEventListener('abort', disposeIntro, { once: true });
      animationFrameId = window.requestAnimationFrame(() => {
        animationFrameId = 0;
        if (routeSignal.aborted || !intro.isConnected) return;
        void import('../lib/motion/logo-intro')
          .then(({ startLogoIntro }) => {
            if (routeSignal.aborted || !intro.isConnected) return;
            cleanupStartedIntro = startLogoIntro({
              intro,
              duration: boundedDuration,
              playEntrance: shouldPlayEntrance,
              onSettle: markIntroSettled,
            });
          })
          .catch(() => {
            if (!routeSignal.aborted) {
              document.documentElement.removeAttribute('data-logo-intro-playing');
              settleIntro(intro);
            }
          });
      });
    });
  };

  initializeLogoIntros();
  document.addEventListener('astro:page-load', initializeLogoIntros);
</script>

<style>
  .logo-intro {
    position: relative;
    /* The gallery intentionally rises behind the lower edge of the wordmark.
       Keep the title's painted letters and their exact SVG hit areas above it. */
    z-index: 5;
    isolation: isolate;
    overflow: clip;
    max-width: 1800px;
    margin-inline: auto;
    padding: clamp(3.5rem, 9vh, 7rem) var(--page-gutter) clamp(.75rem, 1.8vw, 2rem);
    background: transparent;
    pointer-events: none;
  }

  .logo-intro__stage {
    position: relative;
    overflow: clip;
    width: var(--logo-title-inline-size, 100%);
    height: auto;
    aspect-ratio: var(--logo-title-aspect);
    margin-inline: auto;
  }

  .logo-intro__type-lockup {
    translate: 0 -10%;
  }

  .logo-intro__type-title {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    width: min(100%, 1600px);
    margin-inline: auto;
    font-family: "New Work Sans", "PP Neue Montreal", "Helvetica Neue", Arial, sans-serif;
    font-size: clamp(8rem, 20.5vw, 20rem);
    font-weight: 700;
    letter-spacing: -.082em;
    line-height: .66;
    text-transform: lowercase;
  }

  .logo-intro__type-line {
    display: block;
    width: max-content;
    max-width: 100%;
    white-space: nowrap;
  }

  .logo-intro__mobile-outline-word { display: none; }

  .logo-intro__type-letter {
    position: relative;
    display: inline-block;
    cursor: crosshair;
    pointer-events: none;
  }

  [data-type-title-line="new"] [data-type-letter="2"] {
    margin-inline-start: clamp(-7px, -.42vw, -4px);
  }

  .logo-intro__type-letter-rest {
    display: block;
    transition: opacity .42s cubic-bezier(.22, 1, .36, 1);
  }

  .logo-intro__type-letter-baseline {
    display: inline-block;
    width: 0;
    height: 0;
    vertical-align: baseline;
    pointer-events: none;
  }

  .logo-intro__type-line { pointer-events: auto; }

  .logo-intro__type-letter-canvas {
    position: absolute;
    z-index: 2;
    inset: 0;
    width: 100%;
    height: 100%;
    opacity: 0;
    transition: opacity .42s cubic-bezier(.22, 1, .36, 1);
    pointer-events: none;
  }

  .logo-intro__type-letter-canvas[data-media-ready="true"] { opacity: 1; }

  .logo-intro__type-letter-video {
    position: fixed;
    width: 1px;
    height: 1px;
    inset: auto auto 0 0;
    opacity: 0;
    pointer-events: none;
  }

  .logo-intro__type-letter::before,
  .logo-intro__type-letter::after {
    position: absolute;
    inset: 0;
    content: attr(data-glyph);
    color: transparent;
    background-position: 50% 50%;
    background-repeat: no-repeat;
    background-size: cover;
    opacity: 0;
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-stroke: 0 transparent;
    transform: scale(.975) translateY(3%);
    transition:
      opacity .52s cubic-bezier(.22, 1, .36, 1),
