    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-stroke: 0 transparent;
    transition: opacity .52s cubic-bezier(.22, 1, .36, 1);
    pointer-events: none;
  }

  .logo-intro__type-letter::before { background-image: var(--type-letter-primary); }
  .logo-intro__type-letter::after { background-image: var(--type-letter-alternate); }

  .logo-intro__type-letter[data-type-active="true"] .logo-intro__type-letter-rest { opacity: 0; }
  .logo-intro__type-letter[data-type-active="true"]::before {
    opacity: 1;
    animation: type-letter-drift 3.2s cubic-bezier(.37, 0, .18, 1) infinite alternate;
  }
  .logo-intro__type-letter[data-type-active="true"]::after {
    opacity: 1;
    animation: type-letter-flip 3.2s cubic-bezier(.37, 0, .18, 1) infinite alternate;
  }

  /* The stills are a loading fallback for video-backed letters. Once the
     canvas has a decoded frame, keep a single mask source active. Layering
     the text-clipped stills with the canvas creates doubled glyph edges. */
  .logo-intro__type-letter[data-type-media-ready="true"]::before,
  .logo-intro__type-letter[data-type-media-ready="true"]::after {
    opacity: 0 !important;
    animation: none !important;
    transition: none;
  }

  .logo-intro[data-title-state="splash"] .logo-intro__type-letter-canvas,
  .logo-intro[data-title-state="splash"] .logo-intro__type-letter::before,
  .logo-intro[data-title-state="splash"] .logo-intro__type-letter::after {
    opacity: 0 !important;
    animation: none !important;
    transition: none;
  }

  @keyframes type-letter-drift {
    from { background-position: 45% 48%; }
    to { background-position: 58% 54%; }
  }

  @keyframes type-letter-flip {
    0%, 42% { opacity: 0; background-position: 58% 48%; }
    58%, 100% { opacity: 1; background-position: 44% 54%; }
  }

  .logo-intro__type-line--outline {
    color: transparent;
    -webkit-text-stroke: clamp(1.5px, .17vw, 3px) var(--color-ink, #101010);
    paint-order: stroke fill;
  }

  .logo-intro__type-line--solid {
    color: var(--color-ink, #101010);
  }

  /* Animation 2 is the entrance on every visit to the splash. */
  .logo-intro[data-logo-reveal="2"][data-logo-reveal-ready="true"] .logo-intro__stage-type {
    animation: logo-reveal-diagonal 1100ms cubic-bezier(.2, .8, .2, 1) both;
  }

  /* Once the title has left the splash it is page furniture, not an entrance.
     Holding a finished animation here would also pin its transform. */
  .logo-intro[data-title-state="home"] .logo-intro__stage-type {
    animation: none;
    opacity: 1;
  }

  @keyframes logo-reveal-diagonal {
    0% {
      opacity: 0;
      clip-path: polygon(0 0, 0 0, -20% 100%, -20% 100%);
      transform: translateX(-4%) skewX(-3deg);
    }
    100% {
      opacity: 1;
      clip-path: polygon(0 0, 120% 0, 100% 100%, 0 100%);
      transform: none;
