---
import ResponsiveImage from './ResponsiveImage.astro';
import { inferVideoMimeType } from './media/video-mime';
import { withBase } from '../lib/base-path';
import { splashRendition } from '../lib/media/splash-renditions';
import type { ImageView, ProjectView } from '../lib/types';
import legacyTitleWordmark from '../assets/brand/new-work-letters.svg?raw';
import legacyTitleManifest from '../assets/brand/new-work-letter-manifest.json';
import sentenceTitleWordmark from '../assets/brand/new-work-sentence-letters.svg?raw';
import sentenceTitleManifest from '../assets/brand/new-work-sentence-letter-manifest.json';
import titleTitleWordmark from '../assets/brand/new-work-title-letters.svg?raw';
import titleTitleManifest from '../assets/brand/new-work-title-letter-manifest.json';

const TITLE_KITS = {
  legacy: {
    assetRoot: withBase('/media/brand/new-work-letter-kit'),
    inlineScale: 1,
    manifest: legacyTitleManifest,
    maskFile: 'new-work-letters.svg',
    sessionKey: 'new-work:logo-intro:v3',
    source: 'new-work-letter-kit',
    wordmark: legacyTitleWordmark,
  },
  'sentence-clean': {
    assetRoot: withBase('/media/brand/new-work-sentence-clean-letter-kit'),
    inlineScale: 1,
    manifest: sentenceTitleManifest,
    maskFile: 'new-work-sentence-letters.svg',
    sessionKey: 'new-work:logo-intro:sentence-clean:v1',
    source: 'new-work-sentence-clean-letter-kit',
    wordmark: sentenceTitleWordmark,
  },
  title: {
    assetRoot: withBase('/media/brand/new-work-title-letter-kit'),
    inlineScale: 0.92,
    manifest: titleTitleManifest,
    maskFile: 'new-work-title-letters.svg',
    sessionKey: 'new-work:logo-intro:title:v1',
    source: 'new-work-title-letter-kit',
    wordmark: titleTitleWordmark,
  },
} as const;

// Switch this single value to `sentence-clean` or `legacy` to restore an earlier title kit.
const ACTIVE_TITLE_KIT: keyof typeof TITLE_KITS = 'title';
// Switch this to `svg-kit` to restore the masked, per-letter artwork above.
const ACTIVE_TITLE_TREATMENT = 'type' as 'type' | 'svg-kit';
// Keep the authored five-second sequence available, but load directly into
// the black wordmark while the current design is being reviewed.
const TITLE_ENTRANCE_ENABLED = false;
const titleKit = TITLE_KITS[ACTIVE_TITLE_KIT];
const usesTypeTitle = ACTIVE_TITLE_TREATMENT === 'type';

export interface Props {
  siteName?: string;
  descriptor?: string;
  projects?: ProjectView[];
  duration?: number;
  sessionKey?: string;
  class?: string;
}

const {
  descriptor = 'film + photo production agency',
  projects = [],
  duration = 5_000,
  sessionKey = titleKit.sessionKey,
  class: className,
} = Astro.props;

const boundedDuration = Math.min(5_200, Math.max(4_800, duration));
const mediaProjects = projects.filter((project) => project.cover.poster).slice(0, 8);
const motionProject = mediaProjects.find((project) => project.cover.previewVideo);
const motionVideoSource = motionProject?.cover.previewVideo;
const motionVideoPoster = motionProject?.cover.previewPosterOverride?.src || motionProject?.cover.poster.src;
const cellCount = Math.min(4, mediaProjects.length);
const cells = Array.from({ length: cellCount }, (_, index) => ({
  primary: mediaProjects[index % mediaProjects.length],
  alternate: mediaProjects[(index + cellCount) % mediaProjects.length],
}));
const typeLetterAssignments = [
  { slug: 'mercury-an-unexpected-life', position: '0.52,0.48' },
  { slug: 'native-cucumber-mint-stop-motion', position: '0.5,0.5' },
  { slug: 'cradlewise', position: '0.52,0.46' },
  { slug: 'tour-de-france-x-toyota', position: '0.62,0.5' },
  { slug: 'specialized-globe', position: '0.5,0.52' },
  { slug: 'brava', position: '0.48,0.5' },
  { slug: 'olympics-toyota-in-due-time', position: '0.5,0.5' },
] as const;
const typeLetterProjects = typeLetterAssignments.map(({ slug }) =>
  projects.find((project) => project.slug === slug));
// Review round 2: the title text follows Logo 01 ("headline"), which closes
// on a full stop. `word` stays the line's stable key; `text` is what is set.
// Punctuation is typeset like the letters but carries no media or hover.
const typeWords = [
  { word: 'new', text: 'new' },
  { word: 'work', text: 'work.' },
].map(({ word, text }, wordIndex) => ({
  word,
  text,
  marks: [...text].filter((glyph) => !/\p{L}/u.test(glyph)),
  letters: [...text].filter((glyph) => /\p{L}/u.test(glyph)).map((glyph, letterIndex) => {
    const index = (wordIndex === 0 ? 0 : 3) + letterIndex;
    const primary = typeLetterProjects[index] || mediaProjects[(index + 1) % Math.max(1, mediaProjects.length)];
    const alternate = typeLetterProjects[(index + 3) % typeLetterProjects.length] || primary;
    const videoSource = primary?.cover.previewVideo;
    return {
      glyph,
      index,
      position: typeLetterAssignments[index]?.position || '0.5,0.5',
      poster: primary?.cover.previewPosterOverride?.src || primary?.cover.poster.src,
      videoMime: videoSource ? inferVideoMimeType(videoSource) : undefined,
      videoSource,
      style: primary
        ? `--type-letter-primary:url("${primary.cover.poster.src}");--type-letter-alternate:url("${alternate!.cover.poster.src}")`
        : undefined,
    };
  }),
}));
// The splash state fills the same letters with one project's media, the way
// the separate splash lockup used to. These are sources for the canvas that
// paints through the glyphs; they are never painted directly.
const splashProject = typeLetterProjects.find((project) => project?.cover.previewVideo)
  || mediaProjects.find((project) => project.cover.previewVideo)
  || mediaProjects[0];
// The splash paints at several times a gallery tile's size, so a full-HD cut
// of the same frames is preferred when one exists (see splash-renditions).
const splashHd = splashRendition(splashProject?.cover.previewVideo);
const splashVideoSource = splashHd?.video ?? splashProject?.cover.previewVideo;
const splashPoster = splashHd?.poster
  || splashProject?.cover.previewPosterOverride?.src
  || splashProject?.cover.poster.src;
const splashVideoMime = splashVideoSource ? inferVideoMimeType(splashVideoSource) : undefined;

const decorative = (image: ImageView): ImageView => ({ ...image, alt: '' });
const titleAssetRoot = titleKit.assetRoot;
const titleManifest = titleKit.manifest;
const [, , titleWidth = 1, titleHeight = 1] = titleManifest.wordmarkViewBox
  .split(' ')
  .map(Number);
const introStyle = [
  `--logo-intro-duration:${boundedDuration}ms`,
  `--logo-title-aspect:${titleWidth} / ${titleHeight}`,
  `--logo-title-inline-size:${titleKit.inlineScale * 100}%`,
  `--logo-title-mask:url("${titleAssetRoot}/${titleKit.maskFile}")`,
].join(';');
const motionMime = motionVideoSource
  ? inferVideoMimeType(motionVideoSource)
  : undefined;
const motionProjects = mediaProjects.filter((project) => project.cover.previewVideo);
const letterMedia = mediaProjects.length ? titleManifest.letters.map((definition, index) => {
  const fallback = mediaProjects[index % mediaProjects.length];
  const videoProject = index % 3 === 0 && motionProjects.length
    ? motionProjects[Math.floor(index / 3) % motionProjects.length]
    : undefined;
  const primary = videoProject || fallback;
  const alternate = mediaProjects[(index + Math.max(1, Math.floor(mediaProjects.length / 2))) % mediaProjects.length]
    || primary;
  const videoSource = videoProject?.cover.previewVideo;
  const [viewBoxX, , viewBoxWidth] = definition.viewBox;
  const filename = definition.file.split('/').at(-1);
  return {
    index,
    primary,
    alternate,
    videoSource,
    videoPoster: videoProject?.cover.previewPosterOverride?.src || videoProject?.cover.poster.src,
    videoMime: videoSource ? inferVideoMimeType(videoSource) : undefined,
    mask: `${titleAssetRoot}/letters/${filename}`,
    left: `${(viewBoxX! / titleWidth) * 100}%`,
    width: `${(viewBoxWidth! / titleWidth) * 100}%`,
  };
}) : [];
const titleWordmarkMarkup = titleKit.wordmark
  .replace(/^<\?xml[^>]*>\s*/u, '')
  // The inline source color would paint this SVG above the animated media.
  // This copy is only the exact per-letter hover map; the solid layer below
  // owns the resting black title.
  .replace(/(<svg\b[^>]*?)\sstyle="[^"]*"/u, '$1');
---

<section
  class:list={['logo-intro', className]}
  style={introStyle}
  data-logo-intro
  data-logo-mask-experience
  data-logo-reveal="2"
  data-logo-reveal-ready="false"
  data-logo-reveal-phase="background"
  data-title-state="splash"
  data-title-motion="settled"
  aria-label="New Work logo media study"
  data-state="pending"
  data-duration={boundedDuration}
  data-session-key={sessionKey}
  data-title-layout={usesTypeTitle ? 'stacked' : 'single-line'}
  data-title-source={usesTypeTitle ? 'helvetica-now-display' : titleKit.source}
  data-title-treatment={ACTIVE_TITLE_TREATMENT}
  data-entrance-enabled={TITLE_ENTRANCE_ENABLED ? 'true' : 'false'}
>
  {usesTypeTitle ? (
    <div class="logo-intro__type-lockup" data-type-lockup>
      <!-- One title. The wrapper carries the placement that puts it on the
           splash box; the stage inside carries the entrance reveal, so the two
           transforms never fight over the same property. -->
      <div class="logo-intro__stage-morph" data-logo-stage-morph>
      <div class="logo-intro__stage-type" data-logo-stage>
      <div class="logo-intro__type-title" data-type-title data-title-measure aria-hidden="true">
        {typeWords.map(({ word, text, letters, marks }, wordIndex) => (
          <span
            class:list={[
              'logo-intro__type-line',
              wordIndex === 0 ? 'logo-intro__type-line--outline' : 'logo-intro__type-line--solid',
            ]}
            data-type-title-line={word}
            data-type-title-text={text}
          >
            {wordIndex === 0 ? (
              <span class="logo-intro__mobile-outline-word" aria-hidden="true">new</span>
            ) : null}
            <span
              class="logo-intro__type-letter-baseline"
              data-type-line-baseline
              aria-hidden="true"
            ></span>
            {letters.map(({ glyph, index, position, poster, style, videoMime, videoSource }) => (
              <span
                class="logo-intro__type-letter"
                data-type-letter={index}
                data-glyph={glyph}
                data-type-letter-poster={poster}
                style={style}
              >
                <span class="logo-intro__type-letter-rest">
                  <span data-type-letter-glyph>{glyph}</span><span
                    class="logo-intro__type-letter-baseline"
                    data-type-letter-baseline
                  ></span>
                </span>
                <canvas class="logo-intro__type-letter-canvas" data-type-letter-canvas aria-hidden="true"></canvas>
                {videoSource ? (
                  <video
                    class="logo-intro__type-letter-video"
                    muted
                    loop
                    playsinline
                    preload="none"
                    poster={poster}
                    data-type-letter-video
                    data-object-position={position}
                    aria-hidden="true"
                  >
                    <source data-type-letter-video-source data-src={videoSource} type={videoMime} />
                  </video>
                ) : null}
                <span class="logo-intro__type-letter-hit" data-type-letter-hit aria-hidden="true"></span>
              </span>
            ))}
            {marks.map((glyph) => (
              <span class="logo-intro__type-letter logo-intro__type-letter--mark" data-glyph={glyph}>
                <span class="logo-intro__type-letter-rest">{glyph}</span>
              </span>
            ))}
          </span>
        ))}
      </div>
      <canvas class="logo-intro__splash-canvas" data-splash-canvas aria-hidden="true"></canvas>
      {splashPoster ? (
        <div class="logo-intro__splash-media" data-single-layer data-asset-index="0" data-active="true">
          <img src={splashPoster} alt="" loading="eager" decoding="async" data-splash-image />
          {splashVideoSource ? (
            <video muted loop playsinline preload="none" poster={splashPoster} data-logo-video data-splash-video>
              <source data-src={splashVideoSource} type={splashVideoMime} />
            </video>
          ) : null}
        </div>
      ) : null}
      </div>
      </div>
      {descriptor ? <p class="logo-intro__descriptor" data-logo-descriptor>{descriptor}</p> : null}
    </div>
  ) : (
  <>
  <div class="logo-intro__stage" data-svg-title aria-hidden="true">
    <div class="logo-intro__solid" data-intro-solid></div>
    <div class="logo-intro__media" data-intro-media>
      <div class="logo-intro__mosaic">
        {cells.map(({ primary, alternate }, index) => (
          <div class="logo-intro__cell" data-intro-cell>
            <div class="logo-intro__face logo-intro__face--primary" data-intro-primary>
              <ResponsiveImage
                image={decorative(primary!.cover.poster)}
                mobileImage={primary!.cover.mobilePoster ? decorative(primary!.cover.mobilePoster!) : undefined}
                sizes="(min-width: 768px) 25vw, 50vw"
                eager={index < 2}
              />
              {primary?.id === motionProject?.id && motionVideoSource ? (
                <video
                  muted
                  loop
                  playsinline
                  preload="none"
                  poster={motionVideoPoster}
                  data-intro-video
                >
                  <source
                    data-intro-video-source
                    data-src={motionVideoSource}
                    data-type={motionMime}
                    type={motionMime}
                  />
                </video>
              ) : null}
            </div>
            <div class="logo-intro__face logo-intro__face--alternate" data-intro-alternate>
              <ResponsiveImage
                image={decorative((alternate || primary)!.cover.poster)}
                mobileImage={(alternate || primary)!.cover.mobilePoster
                  ? decorative((alternate || primary)!.cover.mobilePoster!)
                  : undefined}
                sizes="(min-width: 768px) 25vw, 50vw"
              />
            </div>
          </div>
        ))}
      </div>
    </div>
    <div class="logo-intro__letter-media" data-intro-letter-media>
      {letterMedia.map((letter) => (
        <div
          class="logo-intro__letter-layer"
          style={`--logo-letter-mask:url("${letter.mask}");--logo-letter-left:${letter.left};--logo-letter-width:${letter.width}`}
          data-intro-letter-layer
          data-letter-index={letter.index}
          data-letter-kind={letter.videoSource ? 'video' : 'flip'}
        >
          <div class="logo-intro__letter-face logo-intro__letter-face--primary" data-intro-letter-primary>
            <ResponsiveImage
              image={decorative(letter.primary!.cover.poster)}
              mobileImage={letter.primary!.cover.mobilePoster ? decorative(letter.primary!.cover.mobilePoster!) : undefined}
              sizes="100vw"
            />
            {letter.videoSource ? (
              <video
                muted
                loop
                playsinline
                preload="none"
                poster={letter.videoPoster}
                data-intro-letter-video
              >
                <source
                  data-intro-letter-video-source
                  data-src={letter.videoSource}
                  data-type={letter.videoMime}
                  type={letter.videoMime}
                />
              </video>
            ) : null}
          </div>
          <div class="logo-intro__letter-face logo-intro__letter-face--alternate" data-intro-letter-alternate>
            <ResponsiveImage
              image={decorative(letter.alternate!.cover.poster)}
              mobileImage={letter.alternate!.cover.mobilePoster ? decorative(letter.alternate!.cover.mobilePoster!) : undefined}
              sizes="100vw"
            />
          </div>
        </div>
      ))}
    </div>
    <div
      class="logo-intro__letter-triggers"
      data-intro-letter-triggers
      aria-hidden="true"
      set:html={titleWordmarkMarkup}
    ></div>
  </div>
  {descriptor ? <p class="logo-intro__descriptor" data-logo-descriptor>{descriptor}</p> : null}
  </>
  )}
  <noscript><style>
    .logo-intro__media{display:none!important}
    /* Without script there is no splash to come out of: the title is simply
       the title, at rest, in its own place. */
    .logo-intro__stage-type{opacity:1!important;animation:none!important}
    .logo-intro__splash-canvas,.logo-intro__splash-media{display:none!important}
    .logo-intro__descriptor{opacity:1!important}
  </style></noscript>
</section>

<script>
  import {readStorageValue} from '../lib/browser-storage';
  import { prefersReducedData } from '../lib/motion/reduced-data';

  let logoIntroRouteController = new AbortController();

  const disposeLogoIntroRoute = (): void => {
    logoIntroRouteController.abort();
    logoIntroRouteController = new AbortController();
  };

  document.addEventListener('astro:before-swap', disposeLogoIntroRoute);

  const settleIntro = (intro: HTMLElement): void => {
    intro.dataset.state = 'settled';
    intro.querySelectorAll<HTMLVideoElement>('[data-intro-video]').forEach((video) => {
      video.pause();
      const source = video.querySelector<HTMLSourceElement>('[data-intro-video-source]');
      source?.removeAttribute('src');
      video.removeAttribute('src');
      video.load();
    });
  };

  const markIntroSettled = (): void => {
    document.documentElement.removeAttribute('data-logo-intro-playing');
  };

  const initializeLogoIntros = (): void => {
    const intros = document.querySelectorAll<HTMLElement>('[data-logo-intro]:not([data-intro-ready])');

    intros.forEach((intro) => {
      // A home page being held behind a project route is scenery, not a live
      // title: it must not claim readiness or start playing media.
      if (intro.closest('[data-gallery-layer-state="background"]')) return;
      intro.dataset.introReady = 'true';
      const duration = Number.parseInt(intro.dataset.duration ?? '5000', 10);
      const boundedDuration = Number.isFinite(duration) ? Math.min(5_200, Math.max(4_800, duration)) : 5_000;
      const sessionKey = intro.dataset.sessionKey ?? 'new-work:logo-intro:v3';
      const playEntrance = intro.dataset.entranceEnabled === 'true';
      const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      const saveData = prefersReducedData();
      const routeSignal = logoIntroRouteController.signal;
      if (routeSignal.aborted) return;

      if (intro.dataset.titleTreatment === 'type') {
        const letters = [...intro.querySelectorAll<HTMLElement>('[data-type-letter]')];
        const lines = [...intro.querySelectorAll<HTMLElement>('[data-type-title-line]')];
        let activeLetter: HTMLElement | null = null;
        let activeSplashPoster: HTMLImageElement | null = null;
        const splashHoverPosters = new Map<HTMLElement, HTMLImageElement>();
        let renderFrame = 0;

        // --- Splash fill ----------------------------------------------------
        // On the splash this one title is filled with a project's media, the
        // way the separate splash lockup used to be. The letters are painted
        // from a single source across the whole lockup rather than per letter,
        // so the image reads as one picture seen through the word.
        const title = intro.querySelector<HTMLElement>('[data-type-title]');
        const splashCanvas = intro.querySelector<HTMLCanvasElement>('[data-splash-canvas]');
        const splashVideo = intro.querySelector<HTMLVideoElement>('[data-splash-video]');
        const splashImage = intro.querySelector<HTMLImageElement>('[data-splash-image]');
        let splashFrame = 0;
        let splashRetry = 0;

        const titleGeometry = () => {
          if (!title) return null;
          const rect = title.getBoundingClientRect();
          const styles = getComputedStyle(title);
          // offsetWidth/offsetHeight round to whole pixels. At splash scale
          // that rounding gave each hovered letter a different coordinate grid.
          const width = Number.parseFloat(styles.width);
          const height = Number.parseFloat(styles.height);
          if (!width || !height) return null;
          return { rect, styles, width, height, scale: rect.width / width || 1 };
        };

        const hitMeasureContext = document.createElement('canvas').getContext('2d');
        const updateLetterHitBounds = (): void => {
          const geometry = titleGeometry();
          if (!geometry || !hitMeasureContext || routeSignal.aborted) return;
          letters.forEach((letter) => {
            const hit = letter.querySelector<HTMLElement>('[data-type-letter-hit]');
            const glyph = letter.querySelector<HTMLElement>('[data-type-letter-glyph]');
            const marker = letter.querySelector<HTMLElement>('[data-type-letter-baseline]');
            if (!hit || !glyph || !marker || !letter.getClientRects().length) return;
            const styles = getComputedStyle(glyph);
            hitMeasureContext.font = `${styles.fontWeight} ${styles.fontSize} ${styles.fontFamily}`;
            const metrics = hitMeasureContext.measureText(letter.dataset.glyph || '');
            const box = letter.getBoundingClientRect();
            const baseline = (marker.getBoundingClientRect().top - box.top) / geometry.scale;
            hit.style.top = `${baseline - metrics.actualBoundingBoxAscent}px`;
            hit.style.bottom = `${box.height / geometry.scale - baseline - metrics.actualBoundingBoxDescent}px`;
          });
        };

        const splashSource = (): HTMLVideoElement | HTMLImageElement | null => {
          const hoverVideo = activeLetter?.querySelector<HTMLVideoElement>('[data-type-letter-video]');
          if (hoverVideo && hoverVideo.readyState >= 2 && hoverVideo.videoWidth) return hoverVideo;
          if (activeSplashPoster?.complete && activeSplashPoster.naturalWidth) return activeSplashPoster;
          if (splashVideo && splashVideo.readyState >= 2 && splashVideo.videoWidth) return splashVideo;
          if (splashImage?.complete && splashImage.naturalWidth) return splashImage;
          return null;
        };

        const stopSplashFill = (): void => {
          if (splashFrame) window.cancelAnimationFrame(splashFrame);
          if (splashRetry) window.clearTimeout(splashRetry);
          splashFrame = 0;
          splashRetry = 0;
          splashVideo?.pause();
          splashCanvas?.removeAttribute('data-media-ready');
        };

        const paintSplashFill = (): void => {
          splashFrame = 0;
          if (routeSignal.aborted || reducedMotion || saveData
            || !splashCanvas || !title || intro.dataset.titleState === 'home') return;
          const source = splashSource();
          const geometry = titleGeometry();
          const localWidth = geometry?.width ?? 0;
          const localHeight = geometry?.height ?? 0;
          if (!source || !localWidth || !localHeight) {
            if (!splashRetry) {
              splashRetry = window.setTimeout(() => {
                splashRetry = 0;
                paintSplashFill();
              }, 120);
            }
            return;
          }

          // The title is scaled while it sits on the splash, but this canvas is
          // scaled with it. Everything below is therefore in the title's own
          // unscaled pixels, with the on-screen scale folded into the backing
          // store only, so the letters stay sharp at splash size.
          // The splash scale alone is about 2x, so on a 2x display the store
          // needs about 4x; a fixed cap of 3 left the letters soft there. The
          // store is instead bounded by area (one 4K frame), which keeps the
          // per-frame video composite affordable on large screens.
          if (!geometry) return;
          const { rect, styles: titleStyles, scale: onScreenScale } = geometry;
          const idealScale = (window.devicePixelRatio || 1) * onScreenScale;
          const maxScale = Math.sqrt(8_294_400 / (localWidth * localHeight));
          const paintScale = Math.max(1, Math.min(idealScale, maxScale));
          const pixelWidth = Math.round(localWidth * paintScale);
          const pixelHeight = Math.round(localHeight * paintScale);
          if (splashCanvas.width !== pixelWidth || splashCanvas.height !== pixelHeight) {
            splashCanvas.width = pixelWidth;
            splashCanvas.height = pixelHeight;
          }
          const context = splashCanvas.getContext('2d');
          if (!context) return;
          context.setTransform(pixelWidth / localWidth, 0, 0, pixelHeight / localHeight, 0, 0);
          context.clearRect(0, 0, localWidth, localHeight);

          // The word is laid down first and the picture is then taken into it
          // in one composite. Cutting the picture to each line in turn would
          // not work: successive `destination-in` passes intersect, and two
          // lines of a stacked lockup barely overlap, so the second pass would
          // erase the first.
          context.globalCompositeOperation = 'source-over';
          context.textBaseline = 'alphabetic';
          context.fillStyle = '#fff';
          context.font = `${titleStyles.fontWeight} ${titleStyles.fontSize} ${titleStyles.fontFamily}`;
          if ('letterSpacing' in context) context.letterSpacing = titleStyles.letterSpacing;
          // Each line is drawn whole, at the box and the real inline baseline
          // the browser laid out, so the painted word sits exactly on the
          // typeset one rather than on canvas font metrics — and so this still
          // holds in the phone layout, where the first line is one painted word
          // rather than separate letters.
          lines.forEach((line) => {
            const word = line.dataset.typeTitleText ?? line.dataset.typeTitleLine;
            const baselineMarker = line.querySelector<HTMLElement>('[data-type-line-baseline]');
            if (!word || !baselineMarker) return;
            const baseline = (baselineMarker.getBoundingClientRect().top - rect.top) / onScreenScale;
            // Paint each glyph where its letter box actually sits. The letters
            // are separate boxes, so the browser applies no kerning between
            // them; painting the line as one kerned word left the fill a few
            // pixels off the hover canvases, which paint from these boxes.
            const glyphs = Array.from(line.querySelectorAll<HTMLElement>('.logo-intro__type-letter'))
              .filter((glyph) => glyph.getClientRects().length > 0);
            if (glyphs.length) {
              if ('fontKerning' in context) context.fontKerning = 'none';
              glyphs.forEach((glyph) => {
                context.fillText(
                  glyph.dataset.glyph ?? '',
                  (glyph.getBoundingClientRect().left - rect.left) / onScreenScale,
                  baseline,
                );
              });
              return;
            }
            // The phone layout sets the first line as one word, which the
            // browser does kern, so it is painted the same way.
            if ('fontKerning' in context) context.fontKerning = 'normal';
            context.fillText(word, (line.getBoundingClientRect().left - rect.left) / onScreenScale, baseline);
          });

          const mediaWidth = source instanceof HTMLVideoElement ? source.videoWidth : source.naturalWidth;
          const mediaHeight = source instanceof HTMLVideoElement ? source.videoHeight : source.naturalHeight;
          const cover = Math.max(localWidth / mediaWidth, localHeight / mediaHeight);
          const drawWidth = mediaWidth * cover;
          const drawHeight = mediaHeight * cover;
          context.globalCompositeOperation = 'source-in';
          context.drawImage(
            source,
            (localWidth - drawWidth) / 2,
            (localHeight - drawHeight) / 2,
            drawWidth,
            drawHeight,
          );
          context.globalCompositeOperation = 'source-over';
          splashCanvas.dataset.mediaReady = 'true';

          if (source instanceof HTMLVideoElement && !source.paused) {
            splashFrame = window.requestAnimationFrame(paintSplashFill);
          }
        };

        const startSplashFill = (): void => {
          // The entrance and the state observer can both ask for the fill in
          // the same frame; only one paint loop may be running.
          if (splashFrame) window.cancelAnimationFrame(splashFrame);
          splashFrame = 0;
          if (!splashCanvas || reducedMotion || saveData) {
            // Without motion the letters stay solid; the splash is then the
            // title on the colour field.
            return;
          }
          // Nothing to fill if this title is already at rest on the page.
          if (intro.dataset.titleState === 'home') return;
          const source = splashVideo?.querySelector<HTMLSourceElement>('source[data-src]');
          if (splashVideo && source?.dataset.src && !source.src) {
            source.src = source.dataset.src;
            splashVideo.load();
          }
          try {
            if (splashVideo) splashVideo.currentTime = 0;
          } catch {
            // A source that has not exposed metadata yet already begins at zero.
          }
          void splashVideo?.play().catch(() => undefined);
          paintSplashFill();
        };

        // The poster almost always decodes before the video, so the first
        // paint takes the still and, being a still, does not keep the loop
        // running. Pick the loop up when the video actually starts.
        const resumeSplashFill = (): void => {
          if (routeSignal.aborted || intro.dataset.titleState === 'home' || splashFrame) return;
          paintSplashFill();
        };
        splashVideo?.addEventListener('playing', resumeSplashFill, { signal: routeSignal });
        splashVideo?.addEventListener('loadeddata', resumeSplashFill, { signal: routeSignal });
        letters.forEach((letter) => {
          const video = letter.querySelector<HTMLVideoElement>('[data-type-letter-video]');
          video?.addEventListener('playing', resumeSplashFill, { signal: routeSignal });
          video?.addEventListener('loadeddata', resumeSplashFill, { signal: routeSignal });
        });

        // Route lifecycle pauses every video while the tab is hidden and
        // nothing restarts them, so a splash opened in the background (or
        // left for another window) would stay on a frozen frame.
        document.addEventListener('visibilitychange', () => {
          if (document.hidden) stopActiveLetter();
          if (document.hidden || intro.dataset.titleState === 'home' || reducedMotion || saveData) return;
          if (!splashVideo?.querySelector('source[src]')) return;
          void splashVideo.play().catch(() => undefined);
        }, { signal: routeSignal });

        // --- Entrance -------------------------------------------------------
        const initialBackgroundHold = 240;
        let revealFrame = 0;
        let revealSettleFrame = 0;
        let revealTimer = 0;

        const playReveal = (backgroundHold = 0): void => {
          if (revealFrame) window.cancelAnimationFrame(revealFrame);
          if (revealSettleFrame) window.cancelAnimationFrame(revealSettleFrame);
          if (revealTimer) window.clearTimeout(revealTimer);
          intro.dataset.logoRevealReady = 'false';
          intro.dataset.logoRevealPhase = backgroundHold > 0 ? 'background' : 'content';
          // Begin fetching the media behind the hidden title so the colour
          // owns first paint without the reveal waiting on the network.
          startSplashFill();

          const revealContent = (): void => {
            revealTimer = 0;
            intro.dataset.logoRevealPhase = 'content';
            revealFrame = window.requestAnimationFrame(() => {
              revealFrame = 0;
              revealSettleFrame = window.requestAnimationFrame(() => {
                revealSettleFrame = 0;
                intro.dataset.logoRevealReady = 'true';
              });
            });
          };

          if (backgroundHold > 0) {
            revealFrame = window.requestAnimationFrame(() => {
              revealFrame = 0;
              revealTimer = window.setTimeout(revealContent, backgroundHold);
            });
          } else {
            revealContent();
          }
        };

        playReveal(reducedMotion ? 0 : initialBackgroundHold);

        // Once the entrance has played, drop its layer hint (see CSS) so the
        // title is re-rastered at its splash scale rather than enlarged.
        const revealStage = intro.querySelector<HTMLElement>('[data-logo-stage]');
        const finishReveal = (event: AnimationEvent): void => {
          if (event.target !== revealStage) return;
          intro.dataset.logoRevealPhase = 'done';
          updateLetterHitBounds();
        };
        revealStage?.addEventListener('animationend', finishReveal, { signal: routeSignal });
        revealStage?.addEventListener('animationcancel', finishReveal, { signal: routeSignal });
        if (reducedMotion) intro.dataset.logoRevealPhase = 'done';

        const handleRevealRequest = (): void => {
          stopActiveLetter();
          playReveal();
        };
        window.addEventListener('new-work:logo-reveal', handleRevealRequest, { signal: routeSignal });

        // The page controller flips this element between its two states. The
        // fill follows the state rather than the other way round.
        const titleStateObserver = new MutationObserver((mutations) => {
          if (mutations.some((mutation) => mutation.attributeName === 'data-title-state')) {
            stopActiveLetter();
            if (intro.dataset.titleState === 'home') stopSplashFill();
            else startSplashFill();
          }
          if (intro.dataset.titleMotion === 'settled') updateLetterHitBounds();
        });
        titleStateObserver.observe(intro, { attributeFilter: ['data-title-state', 'data-title-motion'] });
        routeSignal.addEventListener('abort', () => {
          titleStateObserver.disconnect();
          stopSplashFill();
          // Allow this title to initialize again if its page is brought back
          // rather than re-rendered.
          delete intro.dataset.introReady;
          if (revealFrame) window.cancelAnimationFrame(revealFrame);
          if (revealSettleFrame) window.cancelAnimationFrame(revealSettleFrame);
          if (revealTimer) window.clearTimeout(revealTimer);
        }, { once: true });

        const repaintSplashFill = (): void => {
          updateLetterHitBounds();
          if (intro.dataset.titleState === 'home') return;
          if (!splashFrame) paintSplashFill();
        };
        window.addEventListener('resize', repaintSplashFill, { passive: true, signal: routeSignal });
        void document.fonts?.ready.then(repaintSplashFill).catch(() => undefined);
        updateLetterHitBounds();

        const stopActiveLetter = (): void => {
          if (renderFrame) window.cancelAnimationFrame(renderFrame);
          renderFrame = 0;
          if (!activeLetter) return;
          activeLetter.removeAttribute('data-type-active');
          const canvas = activeLetter.querySelector<HTMLCanvasElement>('[data-type-letter-canvas]');
          const video = activeLetter.querySelector<HTMLVideoElement>('[data-type-letter-video]');
          video?.pause();
          canvas?.removeAttribute('data-media-ready');
          activeLetter.removeAttribute('data-type-media-ready');
          activeLetter = null;
          activeSplashPoster = null;
          resumeSplashFill();
        };

        const renderLetterVideo = (letter: HTMLElement): void => {
          const canvas = letter.querySelector<HTMLCanvasElement>('[data-type-letter-canvas]');
          const video = letter.querySelector<HTMLVideoElement>('[data-type-letter-video]');
          const rest = letter.querySelector<HTMLElement>('.logo-intro__type-letter-rest');
          const glyphElement = letter.querySelector<HTMLElement>('[data-type-letter-glyph]');
          const baselineMarker = letter.querySelector<HTMLElement>('[data-type-letter-baseline]');
          if (intro.dataset.titleState === 'splash'
            || !canvas || !video || !rest || !glyphElement || !baselineMarker || activeLetter !== letter) return;
          // Work in the letter's own (layout) pixels and fold the on-screen
          // scale into the backing store only. At rest the scale is 1; on the
          // splash the whole title is scaled up, and sizing the canvas from the
          // on-screen box would scale it a second time.
          const rect = letter.getBoundingClientRect();
          const geometry = titleGeometry();
          if (!geometry) return;
          const onScreenScale = geometry.scale;
          const scale = Math.min((window.devicePixelRatio || 1) * onScreenScale, 4);
          const width = Math.max(1, rect.width / onScreenScale);
          const height = Math.max(1, rect.height / onScreenScale);
          const styles = getComputedStyle(glyphElement);
          const letterSpacing = Number.parseFloat(styles.letterSpacing) || 0;
          // The canvas overhangs the letter box on every side: the box is
          // trimmed by the title's negative tracking, and some glyphs reach
          // past it, so a canvas cut to the box clipped them (on the splash
          // the shared fill then showed through at the cut). Its CSS size is
          // set to exactly what is drawn, so nothing is stretched by rounding.
          const pad = Math.ceil(height * .1);
          const paintWidth = width + Math.max(0, -letterSpacing) + pad * 2;
          const paintHeight = height + pad * 2;
          const pixelWidth = Math.round(paintWidth * scale);
          const pixelHeight = Math.round(paintHeight * scale);
          canvas.style.left = `${-pad}px`;
          canvas.style.top = `${-pad}px`;
          canvas.style.width = `${paintWidth}px`;
          canvas.style.height = `${paintHeight}px`;
          if (canvas.width !== pixelWidth || canvas.height !== pixelHeight) {
            canvas.width = pixelWidth;
            canvas.height = pixelHeight;
          }
          const context = canvas.getContext('2d');
          if (context && video.readyState >= 2 && video.videoWidth && video.videoHeight) {
            context.setTransform(pixelWidth / paintWidth, 0, 0, pixelHeight / paintHeight, 0, 0);
            context.clearRect(0, 0, paintWidth, paintHeight);
            const [positionX = .5, positionY = .5] = (video.dataset.objectPosition || '.5,.5')
              .split(',')
              .map(Number);
            const mediaScale = Math.max(paintWidth / video.videoWidth, paintHeight / video.videoHeight);
            const mediaWidth = video.videoWidth * mediaScale;
            const mediaHeight = video.videoHeight * mediaScale;
            context.drawImage(
              video,
              (paintWidth - mediaWidth) * positionX,
              (paintHeight - mediaHeight) * positionY,
              mediaWidth,
              mediaHeight,
            );
            context.globalCompositeOperation = 'destination-in';
            context.font = `${styles.fontWeight} ${styles.fontSize} ${styles.fontFamily}`;
            context.fontKerning = 'none';
            context.letterSpacing = styles.letterSpacing;
            context.textBaseline = 'alphabetic';
            context.fillStyle = '#fff';
            const glyph = letter.dataset.glyph || '';
            const markerRect = baselineMarker.getBoundingClientRect();
            const baseline = (markerRect.top - rect.top) / onScreenScale;
            // Use the browser's real inline baseline instead of centering from
            // canvas font metrics. The latter differs substantially for the
            // very tight title line-height and shifts the media glyph upward.
            context.fillText(glyph, pad, baseline + pad);
            context.globalCompositeOperation = 'source-over';
            canvas.dataset.mediaReady = 'true';
            letter.dataset.typeMediaReady = 'true';
          }
          renderFrame = window.requestAnimationFrame(() => renderLetterVideo(letter));
        };

        const startLetter = (letter: HTMLElement): void => {
          if (activeLetter === letter) return;
          stopActiveLetter();
          activeLetter = letter;
          letter.dataset.typeActive = 'true';
          const video = letter.querySelector<HTMLVideoElement>('[data-type-letter-video]');
          const source = video?.querySelector<HTMLSourceElement>('[data-type-letter-video-source]');
          const onSplash = intro.dataset.titleState === 'splash';
          if (onSplash && !reducedMotion && !saveData && letter.dataset.typeLetterPoster) {
            let poster = splashHoverPosters.get(letter);
            if (!poster) {
              poster = new Image();
              poster.decoding = 'async';
              poster.addEventListener('load', resumeSplashFill, { once: true, signal: routeSignal });
              poster.src = letter.dataset.typeLetterPoster;
              splashHoverPosters.set(letter, poster);
            }
            activeSplashPoster = poster;
          }
          if (!reducedMotion && !saveData && video && source?.dataset.src) {
            if (!source.hasAttribute('src')) {
              source.src = source.dataset.src;
              video.load();
            }
            void video.play().catch(() => undefined);
            // The splash has one picture across both words. Only the gallery
            // uses independent letter masks; never layer those over the splash.
            if (!onSplash) renderLetterVideo(letter);
          }
          if (onSplash) resumeSplashFill();
        };

        lines.forEach((line) => {
          const lineLetters = letters.filter((letter) => letter.parentElement === line);
          line.addEventListener('pointermove', (event) => {
            if (event.pointerType === 'touch') return;
            const nearest = lineLetters.reduce<HTMLElement | null>((closest, letter) => {
              const rect = letter.getBoundingClientRect();
              if (!closest) return letter;
              const closestRect = closest.getBoundingClientRect();
              return Math.abs(event.clientX - (rect.left + rect.width / 2))
                < Math.abs(event.clientX - (closestRect.left + closestRect.width / 2))
                ? letter
                : closest;
            }, null);
            if (nearest) startLetter(nearest);
          }, { signal: routeSignal });
          line.addEventListener('pointerleave', stopActiveLetter, { signal: routeSignal });
          line.addEventListener('pointercancel', stopActiveLetter, { signal: routeSignal });
        });
        window.addEventListener('blur', stopActiveLetter, { signal: routeSignal });
        routeSignal.addEventListener('abort', stopActiveLetter, { once: true });
        markIntroSettled();
        settleIntro(intro);
        return;
      }

      // A dedicated sentinel keeps automated visual checks fast without
      // allowing a stale value from an earlier prototype to suppress the
      // title mask or its post-intro letter interactions for real visitors.
      const skipIntro = readStorageValue('session', sessionKey) === 'test-skip';
      const shouldPlayEntrance = playEntrance && !skipIntro;

      if (reducedMotion || saveData) {
        markIntroSettled();
        settleIntro(intro);
        return;
      }

      if (shouldPlayEntrance) document.documentElement.dataset.logoIntroPlaying = sessionKey;

      let animationFrameId = 0;
      let cleanupStartedIntro: (() => void) | null = null;
      const disposeIntro = (): void => {
        if (animationFrameId) window.cancelAnimationFrame(animationFrameId);
        animationFrameId = 0;
        cleanupStartedIntro?.();
        cleanupStartedIntro = null;
        if (
          intro.dataset.state !== 'settled'
          && document.documentElement.dataset.logoIntroPlaying === sessionKey
        ) {
          document.documentElement.removeAttribute('data-logo-intro-playing');
        }
      };

      routeSignal.addEventListener('abort', disposeIntro, { once: true });
      animationFrameId = window.requestAnimationFrame(() => {
        animationFrameId = 0;
        if (routeSignal.aborted || !intro.isConnected) return;
        void import('../lib/motion/logo-intro')
          .then(({ startLogoIntro }) => {
            if (routeSignal.aborted || !intro.isConnected) return;
            cleanupStartedIntro = startLogoIntro({
              intro,
              duration: boundedDuration,
              playEntrance: shouldPlayEntrance,
              onSettle: markIntroSettled,
            });
          })
          .catch(() => {
            if (!routeSignal.aborted) {
              document.documentElement.removeAttribute('data-logo-intro-playing');
              settleIntro(intro);
            }
          });
      });
    });
  };

  initializeLogoIntros();
  document.addEventListener('astro:page-load', initializeLogoIntros);
  document.addEventListener('new-work:gallery-layer-released', initializeLogoIntros);
</script>

<style>
  .logo-intro {
    position: relative;
    /* Review round 1: the gallery now rises OVER the lower edge of the
       wordmark. This value orders the intro inside the title wrapper only;
       the wrapper itself is what sits behind the gallery (see
       .logo-work-page__title in index.astro). Letters the grid covers are no
       longer hoverable, which is the intended trade for the overlap. */
    z-index: 5;
    isolation: isolate;
    max-width: 1800px;
    margin-inline: auto;
    padding: clamp(3.5rem, 9vh, 7rem) var(--page-gutter) clamp(.75rem, 1.8vw, 2rem);
    background: transparent;
    pointer-events: none;
  }

  /* The per-letter artwork treatment still clips to its stage. The type
     treatment must not: on the splash the title is scaled well past this
     section's own box. */
  .logo-intro[data-title-treatment="svg-kit"] { overflow: clip; }

  .logo-intro__stage {
    position: relative;
    overflow: clip;
    width: var(--logo-title-inline-size, 100%);
    height: auto;
    aspect-ratio: var(--logo-title-aspect);
    margin-inline: auto;
  }

  .logo-intro__type-lockup {
    translate: 0 -10%;
  }

  /* Placement: where the one title sits and how big it is. Set from the page
     controller, which measures this box against the splash box. */
  .logo-intro__stage-morph {
    width: max-content;
    max-width: min(100%, 1600px);
    margin-inline: auto;
    transform-origin: 0 0;
  }

  /* Layer hints only while something is moving. A standing will-change pins
     the type's raster scale to whatever it was first painted at, and the
     splash scales this title about 2x, so the letters would sit on screen as
     an enlarged bitmap. Without the hint Chrome re-rasters at the final scale. */
  .logo-intro[data-title-motion="moving"] .logo-intro__stage-morph {
    will-change: transform;
  }

  /* Entrance: the reveal owns this element's own transform. */
  .logo-intro__stage-type {
    position: relative;
    width: 100%;
    opacity: 0;
  }

  .logo-intro:is([data-logo-reveal-phase="background"], [data-logo-reveal-phase="content"]) .logo-intro__stage-type {
    will-change: clip-path, opacity, transform;
  }

  .logo-intro[data-logo-reveal-ready="true"] .logo-intro__stage-type { opacity: 1; }

  .logo-intro__splash-canvas {
    position: absolute;
    z-index: 2;
    inset: 0;
    width: 100%;
    height: 100%;
    opacity: 0;
    transition: opacity 620ms cubic-bezier(.22, 1, .36, 1);
    pointer-events: none;
  }

  .logo-intro[data-title-state="splash"] .logo-intro__splash-canvas[data-media-ready="true"] {
    opacity: 1;
  }

  /* While the media is in the letters the resting glyphs would double the
     edges, exactly as they do behind an active hover letter. */
  .logo-intro[data-title-state="splash"]
    .logo-intro__stage-type:has(.logo-intro__splash-canvas[data-media-ready="true"])
    :is(.logo-intro__type-letter-rest, .logo-intro__mobile-outline-word) {
    opacity: 0;
  }

  .logo-intro__splash-media {
    position: fixed;
    width: 1px;
    height: 1px;
    inset: auto auto 0 0;
    overflow: hidden;
    opacity: 0;
    pointer-events: none;
  }

  .logo-intro__type-title {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    /* Hug the widest line. This element is the box the page controller
       measures against the splash box, so it has to be the type's own box
       rather than the column it sits in. */
    width: max-content;
    max-width: 100%;
    font-family: var(--font-title);
    font-size: clamp(8rem, 20.5vw, 20rem);
    font-weight: 900;
    /* The V1 artwork font includes the client's tightly fitted advances.
       Both title states share its measure throughout the scroll transition. */
    letter-spacing: var(--title-tracking);
    line-height: var(--title-leading);
    text-transform: lowercase;
  }

  .logo-intro__type-line {
    display: block;
    width: max-content;
    max-width: 100%;
    white-space: nowrap;
  }

  .logo-intro__mobile-outline-word { display: none; }

  .logo-intro__type-letter {
    position: relative;
    display: inline-block;
    pointer-events: none;
  }

  /* Both words remain interactive on the splash and in the gallery. */

  .logo-intro__type-letter-hit {
    position: absolute;
    z-index: 3;
    inset-block: 0;
    inset-inline: 0;
    cursor: crosshair;
    pointer-events: auto;
  }

  /* The interim face needed a manual correction on the "ew" pair. Helvetica
     Now Display Black kerns it correctly on its own, and a viewport-relative
     nudge here would put the two titles' glyph positions out of step at some
     widths, so the pair is left to the font. */

  /* The phone outline word only shares the fade. Its display is owned by the
     phone media query below; setting it here would show it on desktop too,
     next to the per-letter line. */
  .logo-intro__type-letter-rest,
  .logo-intro__mobile-outline-word {
    transition: opacity .62s cubic-bezier(.22, 1, .36, 1);
  }

  .logo-intro__type-letter-rest {
    display: block;
  }

  .logo-intro__type-letter-baseline {
    display: inline-block;
    width: 0;
    height: 0;
