---
import { withBase } from '../../lib/base-path';
import type { ProjectView } from '../../lib/types';

interface Props {
  projectSlug: string;
  projectTitle: string;
  projects: ProjectView[];
}

const { projectSlug, projectTitle, projects } = Astro.props;
const backdropProjects = [...projects]
  .filter((project) => project.slug !== projectSlug && project.cover.poster.src)
  .sort((left, right) => (left.homeOrder ?? 999) - (right.homeOrder ?? 999))
  .slice(0, 12);
---

<div class="project-overlay" data-project-overlay data-project-slug={projectSlug}>
  <div class="project-overlay__backdrop" data-project-overlay-backdrop aria-hidden="true">
    <div class="project-overlay__fallback" data-project-overlay-fallback>
      {backdropProjects.map((project) => (
        <div class="project-overlay__tile">
          <img
            src={project.cover.poster.src}
            width={project.cover.poster.width}
            height={project.cover.poster.height}
            alt=""
            loading="lazy"
            decoding="async"
            fetchpriority="low"
            style={`object-position:${project.cover.poster.objectPosition || '50% 50%'}`}
          />
        </div>
      ))}
    </div>
    <div class="project-overlay__snapshot" data-project-overlay-snapshot></div>
  </div>

  <a
    href={withBase('/')}
    class="project-overlay__edge-close"
    aria-label={`Close ${projectTitle} and return to the gallery`}
    data-project-overlay-edge-close
    data-project-return
    data-restore-work-scroll
    tabindex="-1"
  ></a>

  <div class="project-overlay__panel" data-project-overlay-panel>
    <nav class="project-overlay__toolbar" aria-label="Project controls">
      <a
        href={withBase('/')}
        class="project-overlay__return"
        data-project-overlay-return
        data-project-return
        data-restore-work-scroll
      >
        <svg viewBox="0 0 28 14" aria-hidden="true">
          <path d="M27 7H2M8 1 2 7l6 6" />
        </svg>
        <span>Return to gallery</span>
      </a>
    </nav>
    <slot />
  </div>
</div>

<script>
  import { navigate } from 'astro:transitions/client';
  import {
    cancelRouteVideo,
    captureRouteVideo,
    restoreRouteVideo,
  } from '../../lib/motion/route-video-continuity';
  import {
    persistMatchingVideo,
    persistResponsiveImage,
    supportsRouteMediaPersistence,
  } from '../../lib/motion/route-media-persistence';

  interface GalleryBackdropItem {
    src: string;
    x: number;
    y: number;
    width: number;
    height: number;
    objectPosition?: string;
  }

  interface GalleryBackdropSnapshot {
    destination?: string;
    items?: GalleryBackdropItem[];
  }

  interface GalleryReturnOrigin {
    slug?: string;
    scrollY?: number;
    historyIndex?: number;
  }

  type ProjectReturnWindow = typeof window & {
    __newWorkProjectReturnPopstateReady?: boolean;
    __newWorkPrepareGalleryReturn?: (origin: GalleryReturnOrigin) => void;
  };

  const backdropStorageKey = 'new-work:gallery-backdrop:v1';
  const galleryOriginStorageKey = 'new-work-origin';
  const galleryRestoreRequestKey = 'new-work-restore-requested';
  const returnTransitionStyleAttribute = 'data-gallery-return-transition-style';
  const stillPhotoReturnAttribute = 'data-photo-return-handoff';
  const stillPhotoReturnPersistKey = 'new-work-photo-return-handoff';
  const routeWindow = window as ProjectReturnWindow;

  const readGalleryOrigin = (): GalleryReturnOrigin => {
    try {
      const origin = JSON.parse(
        sessionStorage.getItem(galleryOriginStorageKey) || '{}',
      ) as GalleryReturnOrigin;
      return {
        slug: typeof origin.slug === 'string' ? origin.slug : undefined,
        scrollY: typeof origin.scrollY === 'number' ? origin.scrollY : undefined,
        historyIndex: typeof origin.historyIndex === 'number' ? origin.historyIndex : undefined,
      };
    } catch {
      return {};
    }
  };

  const settleIncomingGallery = (origin: GalleryReturnOrigin): void => {
    routeWindow.__newWorkPrepareGalleryReturn?.(origin);
    const gallery = document.querySelector<HTMLElement>('[data-work-gallery]');
    const entrance = gallery?.querySelector<HTMLElement>('[data-gallery-entrance]');
    if (gallery) {
      gallery.dataset.galleryRestore = 'true';
      gallery.dataset.galleryEntrancePlayed = 'true';
      gallery.style.setProperty('--gallery-pointer-x', '0px');
    }
    if (entrance) {
      entrance.dataset.galleryEntranceState = 'settled';
      entrance.style.removeProperty('transform');
      entrance.style.removeProperty('will-change');
    }
    if (typeof origin.scrollY === 'number') {
      window.scrollTo({ top: origin.scrollY, left: 0, behavior: 'auto' });
    }
  };

  const isStillReturnMedia = (sourceMedia?: HTMLElement | null): boolean => Boolean(
    sourceMedia?.matches('[data-gallery-photo-primary]')
    || sourceMedia?.dataset.projectBlock === 'heroImage'
    || sourceMedia?.dataset.projectBlock === 'fullBleedImage'
    || sourceMedia?.dataset.projectBlock === 'containedImage',
  );

  const prepareStillPhotoReturnHandoff = (
    overlay: HTMLElement,
    origin: GalleryReturnOrigin,
    sourceMedia: HTMLElement,
  ): boolean => {
    if (matchMedia('(prefers-reduced-motion: reduce)').matches) return false;
    if (!origin.slug || origin.slug !== overlay.dataset.projectSlug) return false;

    const sourceImage = sourceMedia.querySelector<HTMLImageElement>('img');
    if (!sourceImage) return false;
    // Measure the painted photo itself. The gallery-photo <figure> includes
    // additional layout height, so using it as the departure frame creates a
    // visible size jump before the return animation even begins.
    const sourceFrame = sourceImage;
    const sourceRect = sourceFrame.getBoundingClientRect();
    if (sourceRect.width <= 0 || sourceRect.height <= 0) return false;

    overlay.dataset.overlayReturnTransition = 'true';
    sessionStorage.setItem(galleryRestoreRequestKey, 'true');
    sourceMedia.setAttribute('data-project-return-source', 'still');

    // Native cross-document image snapshots are asymmetric here: entering a
    // project is stable, but the reverse snapshot can be rebuilt at the wrong
    // crop or disappear during the gallery scroll restore. Keep the decoded
    // hero image alive across the swap and move that real element back into
    // the originating tile instead.
    const handoff = document.createElement('div');
    handoff.setAttribute(stillPhotoReturnAttribute, 'source');
    handoff.setAttribute('data-astro-transition-persist', stillPhotoReturnPersistKey);
    handoff.setAttribute('aria-hidden', 'true');
    Object.assign(handoff.style, {
      position: 'fixed',
      zIndex: '2147483000',
      inset: 'auto',
      left: `${sourceRect.left}px`,
      top: `${sourceRect.top}px`,
      width: `${sourceRect.width}px`,
      height: `${sourceRect.height}px`,
      overflow: 'hidden',
      pointerEvents: 'none',
      contain: 'layout paint style',
      background: getComputedStyle(sourceMedia).backgroundColor,
      viewTransitionName: 'none',
    });

    const image = document.createElement('img');
    image.alt = '';
    image.decoding = 'async';
    image.src = sourceImage.currentSrc || sourceImage.src;
    const sourceImageStyles = getComputedStyle(sourceImage);
    const sourcePosition = sourceImageStyles.objectPosition || '50% 50%';
    const sourceTransform = sourceImageStyles.transform || 'none';
    Object.assign(image.style, {
      display: 'block',
      width: '100%',
      height: '100%',
      objectFit: sourceImageStyles.objectFit === 'fill' ? 'cover' : sourceImageStyles.objectFit,
      objectPosition: sourcePosition,
      transform: sourceTransform,
      transformOrigin: 'center',
    });
    handoff.append(image);
    document.body.append(handoff);
    sourceMedia.style.visibility = 'hidden';

    document.documentElement.style.viewTransitionName = 'none';
    overlay.querySelectorAll<HTMLElement>(
      '[data-project-hero-media], [data-gallery-photo-primary], .related-projects__media',
    ).forEach((candidate) => { candidate.style.viewTransitionName = 'none'; });

    let finished = false;
    let destinationImage: HTMLImageElement | undefined;
    let lockedTargetInner: HTMLElement | undefined;
    let lockedTargetImage: HTMLImageElement | undefined;
    let geometryFrame = 0;
    let galleryReadyFallback = 0;
    const cleanup = (target?: HTMLElement): void => {
      if (finished) return;
      finished = true;
      if (geometryFrame) cancelAnimationFrame(geometryFrame);
      if (galleryReadyFallback) window.clearTimeout(galleryReadyFallback);
      target?.style.removeProperty('visibility');
      handoff.getAnimations().forEach((animation) => animation.cancel());
      image.getAnimations().forEach((animation) => animation.cancel());
      destinationImage?.getAnimations().forEach((animation) => animation.cancel());
      handoff.remove();
      const targetInner = lockedTargetInner;
      if (targetInner?.isConnected) {
        // Keep the real tile on the handoff's exact final frame for the reveal.
        // Relinquish control on the following frame so any new hover/pointer
        // state is handled by the tile's existing slow CSS transition.
        requestAnimationFrame(() => {
          targetInner.style.removeProperty('transition');
          targetInner.style.removeProperty('transform');
        });
      }
      const targetImage = lockedTargetImage;
      if (targetImage?.isConnected) {
        requestAnimationFrame(() => {
          targetImage.style.removeProperty('transition');
          targetImage.style.removeProperty('opacity');
        });
      }
      document.documentElement.style.removeProperty('view-transition-name');
      document.querySelectorAll<HTMLElement>(
        '[data-project-grid] .project-card__media, [data-project-hero-media], [data-gallery-photo-primary]',
      ).forEach((candidate) => {
        candidate.style.removeProperty('view-transition-name');
        candidate.style.removeProperty('visibility');
      });
    };

    document.addEventListener('astro:before-swap', (event) => {
      const newDocument = (event as Event & { newDocument?: Document }).newDocument;
      if (!newDocument) return;
      const gallery = newDocument.querySelector<HTMLElement>('[data-work-gallery]');
      const entrance = gallery?.querySelector<HTMLElement>('[data-gallery-entrance]');
      if (gallery) {
        gallery.dataset.galleryRestore = 'true';
        gallery.dataset.galleryEntrancePlayed = 'true';
      }
      if (entrance) entrance.dataset.galleryEntranceState = 'settled';

      newDocument.documentElement.style.viewTransitionName = 'none';
      newDocument.querySelectorAll<HTMLElement>('[data-project-grid] .project-card__media')
        .forEach((candidate) => { candidate.style.viewTransitionName = 'none'; });

      const placeholder = newDocument.createElement('div');
      placeholder.setAttribute('data-astro-transition-persist', stillPhotoReturnPersistKey);
      placeholder.hidden = true;
      newDocument.body.append(placeholder);
    }, { once: true });

    document.addEventListener('astro:after-swap', () => {
      settleIncomingGallery(origin);
      if (!handoff.isConnected) document.body.append(handoff);
      handoff.setAttribute(stillPhotoReturnAttribute, 'waiting');
      document.querySelectorAll<HTMLElement>(
        `[data-astro-transition-persist="${stillPhotoReturnPersistKey}"]`,
      ).forEach((candidate) => {
        if (candidate !== handoff) candidate.remove();
      });

      let trackingStarted = false;
      const startTracking = (): void => {
        if (trackingStarted || finished) return;
        trackingStarted = true;
        if (galleryReadyFallback) window.clearTimeout(galleryReadyFallback);

        // `astro:after-swap` fires before the incoming page's motion lifecycle
        // has rebuilt the masonry tracks. Wait for `astro:page-load`, then
        // reapply the exact saved scroll before measuring any destination.
        settleIncomingGallery(origin);
        handoff.setAttribute(stillPhotoReturnAttribute, 'animating');
        handoff.dataset.photoReturnLayout = 'ready';

        requestAnimationFrame(() => requestAnimationFrame(() => {
        const escapedSlug = CSS.escape(origin.slug!);
        const target = document.querySelector<HTMLElement>(
          `[data-gallery-item-id="${escapedSlug}"] .project-card__media`,
        );
        if (!target || !target.isConnected || finished) {
          cleanup(target ?? undefined);
          return;
        }

        const initialTargetRect = target.getBoundingClientRect();
        if (initialTargetRect.width <= 0 || initialTargetRect.height <= 0) {
          cleanup(target);
          return;
        }
        target.style.visibility = 'hidden';
        const targetImage = target.querySelector<HTMLImageElement>('img[data-gallery-image], img');
        const targetInner = target.querySelector<HTMLElement>('[data-card-media]');
        if (targetImage) {
          targetImage.loading = 'eager';
          targetImage.fetchPriority = 'high';
          lockedTargetImage = targetImage;
          targetImage.style.transition = 'none';
          targetImage.style.opacity = '1';
        }
        const targetImageStyles = targetImage ? getComputedStyle(targetImage) : undefined;
        const targetPosition = targetImageStyles?.objectPosition || '50% 50%';
        const targetFit = targetImageStyles?.objectFit || 'cover';
        const targetTransform = targetInner
          ? getComputedStyle(targetInner).transform || 'none'
          : 'none';
        if (targetInner) {
          lockedTargetInner = targetInner;
          targetInner.style.transition = 'none';
          targetInner.style.transform = targetTransform;
        }

        destinationImage = targetImage ? document.createElement('img') : undefined;
        if (destinationImage && targetImage) {
          destinationImage.alt = '';
          destinationImage.decoding = 'async';
          destinationImage.src = targetImage.currentSrc || targetImage.src;
          Object.assign(destinationImage.style, {
            position: 'absolute',
            inset: '0',
            display: 'block',
            width: '100%',
            height: '100%',
            objectFit: targetFit,
            objectPosition: sourcePosition,
            opacity: '0',
            transform: sourceTransform,
            transformOrigin: 'center',
          });
          handoff.append(destinationImage);
        }

        const targetReady = Promise.all([
          targetImage
            ? targetImage.decode().catch(() => undefined).then(() => {
              if (targetImage.naturalWidth > 0) targetImage.dataset.galleryImageReady = 'true';
            })
            : Promise.resolve(),
          destinationImage?.decode().catch(() => undefined) ?? Promise.resolve(),
        ]);
        image.animate([
          { objectPosition: sourcePosition, transform: sourceTransform },
          { objectPosition: targetPosition, transform: targetTransform },
        ], {
          duration: 900,
          easing: 'cubic-bezier(.65, 0, .35, 1)',
          fill: 'forwards',
        });
        // Preserve full coverage throughout the return. The destination fades
        // over this source layer, so the light canvas can never show between
        // two partially transparent copies of the photograph.
        destinationImage?.animate([
          { objectPosition: sourcePosition, transform: sourceTransform },
          { objectPosition: targetPosition, transform: targetTransform },
        ], {
          duration: 900,
          easing: 'cubic-bezier(.65, 0, .35, 1)',
          fill: 'forwards',
        });
        destinationImage?.animate([
          { opacity: 0, offset: 0 },
          { opacity: 0, offset: .32 },
          { opacity: 1, offset: 1 },
        ], {
          duration: 900,
          easing: 'cubic-bezier(.65, 0, .35, 1)',
          fill: 'forwards',
        });
        let destinationReady = false;
        void Promise.race([
          targetReady,
          new Promise<void>((resolve) => window.setTimeout(resolve, 1_400)),
        ]).then(() => { destinationReady = true; });

        const sampleCurve = (value: number, first: number, second: number): number => (
          ((1 - 3 * second + 3 * first) * value
            + (3 * second - 6 * first)) * value
            + 3 * first
        ) * value;
        const sampleSlope = (value: number, first: number, second: number): number => (
          3 * (1 - 3 * second + 3 * first) * value * value
          + 2 * (3 * second - 6 * first) * value
          + 3 * first
        );
        const easeHandoff = (progress: number): number => {
          let parameter = progress;
          for (let iteration = 0; iteration < 6; iteration += 1) {
            const slope = sampleSlope(parameter, .65, .35);
            if (Math.abs(slope) < .0001) break;
            parameter -= (sampleCurve(parameter, .65, .35) - progress) / slope;
            parameter = Math.min(1, Math.max(0, parameter));
          }
          return sampleCurve(parameter, 0, 1);
        };
        const applyTrackedRect = (progress: number): boolean => {
          if (!target.isConnected) return false;
          const liveTarget = target.getBoundingClientRect();
          if (liveTarget.width <= 0 || liveTarget.height <= 0) return false;
          const interpolate = (start: number, end: number) => start + (end - start) * progress;
          handoff.style.left = `${interpolate(sourceRect.left, liveTarget.left)}px`;
          handoff.style.top = `${interpolate(sourceRect.top, liveTarget.top)}px`;
          handoff.style.width = `${interpolate(sourceRect.width, liveTarget.width)}px`;
          handoff.style.height = `${interpolate(sourceRect.height, liveTarget.height)}px`;
          return true;
        };

        const startedAt = performance.now();
        let settledAt = 0;
        const trackDestination = (time: number): void => {
          if (finished) return;
          const linearProgress = Math.min(1, Math.max(0, (time - startedAt) / 900));
          if (!applyTrackedRect(easeHandoff(linearProgress))) {
            cleanup(target);
            return;
          }

          if (linearProgress < 1 || !destinationReady) {
            geometryFrame = requestAnimationFrame(trackDestination);
            return;
          }

          // Continue sampling the live card for a few final frames. This keeps
          // the handoff attached to its lane if a scroll-restoration pass or
          // column filter settles during the last part of the transition.
          applyTrackedRect(1);
          if (!settledAt) {
            settledAt = time;
            handoff.setAttribute(stillPhotoReturnAttribute, 'settled');
          }
          if (time - settledAt < 120) {
            geometryFrame = requestAnimationFrame(trackDestination);
            return;
          }
          cleanup(target);
        };
        geometryFrame = requestAnimationFrame(trackDestination);
        }));
      };

      document.addEventListener('astro:page-load', startTracking, { once: true });
      galleryReadyFallback = window.setTimeout(startTracking, 700);
    }, { once: true });

    window.setTimeout(() => cleanup(), 4_500);
    return true;
  };

  const prepareProjectReturnTransition = (
    overlay: HTMLElement,
    origin: GalleryReturnOrigin,
  ): void => {
    if (overlay.dataset.overlayReturnTransition === 'true') return;

    const activeSlug = overlay.dataset.projectSlug;
    const sourceMedia = overlay.querySelector<HTMLElement>(
      '[data-project-hero-media][data-first-media="true"], [data-gallery-photo-primary]',
    );
    const isStill = isStillReturnMedia(sourceMedia);
    const usesPersistedStill = Boolean(isStill && sourceMedia && supportsRouteMediaPersistence());
    if (
      isStill
      && !usesPersistedStill
      && sourceMedia
      && prepareStillPhotoReturnHandoff(overlay, origin, sourceMedia)
    ) return;

    const sourceVideo = !isStill
      ? sourceMedia?.querySelector<HTMLVideoElement>('video[data-short-loop]')
      : undefined;
    if (sourceVideo && activeSlug) captureRouteVideo(sourceVideo, activeSlug);
    let persistedVideo = false;

    overlay.dataset.overlayReturnTransition = 'true';
    sessionStorage.setItem(galleryRestoreRequestKey, 'true');
    const sourceName = sourceMedia
      ? getComputedStyle(sourceMedia).viewTransitionName
      : undefined;
    const hasSharedMedia = Boolean(
      sourceMedia
      && sourceName
      && sourceName !== 'none'
      && origin.slug
      && origin.slug === activeSlug,
    );
    const escapedMediaName = hasSharedMedia && sourceName
      ? CSS.escape(sourceName)
      : undefined;
    const pageTransitionName = getComputedStyle(document.documentElement).viewTransitionName;
    const escapedPageName = pageTransitionName && pageTransitionName !== 'none'
      ? CSS.escape(pageTransitionName)
      : undefined;
    if (hasSharedMedia) sourceMedia?.setAttribute('data-project-return-source', isStill ? 'still' : 'motion');
    const mutedSourceMedia = [...overlay.querySelectorAll<HTMLElement>(
      '.related-projects__media',
    )];
    mutedSourceMedia.forEach((media) => { media.style.viewTransitionName = 'none'; });

    const transitionCss = `
      @media (prefers-reduced-motion: no-preference) {
        [data-project-return-source="motion"] :is(iframe, .lazy-embed__player) {
          opacity: 0 !important;
          transition: none !important;
        }
        ${escapedMediaName ? `
        ::view-transition-group(${escapedMediaName}) {
          animation-duration: 900ms;
          animation-timing-function: cubic-bezier(.65, 0, .35, 1);
        }
        ::view-transition-image-pair(${escapedMediaName}) {
          isolation: auto;
        }
        ::view-transition-old(${escapedMediaName}),
        ::view-transition-new(${escapedMediaName}) {
          animation-duration: 900ms;
          animation-timing-function: cubic-bezier(.65, 0, .35, 1);
          animation-fill-mode: both;
          mix-blend-mode: normal;
        }
        ` : ''}
        ${escapedPageName ? `
        ::view-transition-group(${escapedPageName}) {
          animation-duration: 520ms;
          animation-timing-function: cubic-bezier(.45, 0, .2, 1);
        }
        ::view-transition-old(${escapedPageName}),
        ::view-transition-new(${escapedPageName}) {
          animation-duration: 520ms;
          animation-timing-function: cubic-bezier(.45, 0, .2, 1);
        }` : ''}
      }
    `;

    const installStyle = (targetDocument: Document): void => {
      targetDocument.head.querySelector(`[${returnTransitionStyleAttribute}]`)?.remove();
      const style = targetDocument.createElement('style');
      style.setAttribute(
        returnTransitionStyleAttribute,
        escapedMediaName ? (isStill ? 'still' : 'motion') : 'panel',
      );
      style.textContent = transitionCss;
      targetDocument.head.append(style);
    };

    installStyle(document);
    document.addEventListener('astro:before-swap', (event) => {
      if (sourceVideo?.isConnected && activeSlug) captureRouteVideo(sourceVideo, activeSlug);
      const newDocument = event.newDocument;
      if (usesPersistedStill && sourceMedia && activeSlug && origin.slug === activeSlug) {
        const target = newDocument.querySelector<HTMLElement>(
          `[data-gallery-item-id="${CSS.escape(activeSlug)}"] .project-card__media`,
        );
        if (target && persistResponsiveImage(sourceMedia, target, activeSlug)) {
          sourceMedia.dataset.projectReturnSource = 'still-persisted';
          target.dataset.routeTransitionTarget = 'still-persisted';
        }
      }
      if (sourceVideo && activeSlug && origin.slug === activeSlug) {
        const targetVideo = newDocument.querySelector<HTMLVideoElement>(
          `[data-gallery-item-id="${CSS.escape(activeSlug)}"] [data-preview-video]`,
        );
        if (targetVideo) persistedVideo = persistMatchingVideo(sourceVideo, targetVideo, activeSlug);
      }
      const gallery = newDocument.querySelector<HTMLElement>('[data-work-gallery]');
      const entrance = gallery?.querySelector<HTMLElement>('[data-gallery-entrance]');
      if (gallery) {
        gallery.dataset.galleryRestore = 'true';
        gallery.dataset.galleryEntrancePlayed = 'true';
      }
      if (entrance) entrance.dataset.galleryEntranceState = 'settled';

      newDocument.querySelectorAll<HTMLElement>('[data-project-grid] .project-card__media')
        .forEach((media) => {
          const card = media.closest<HTMLElement>('[data-project-card]');
          if (!hasSharedMedia || card?.dataset.galleryItemId !== origin.slug) {
            media.style.viewTransitionName = 'none';
          }
        });
      installStyle(newDocument);
    }, { once: true });

    document.addEventListener('astro:after-swap', () => {
      settleIncomingGallery(origin);
      if (persistedVideo && sourceVideo && activeSlug) {
        cancelRouteVideo(sourceVideo, activeSlug);
        sourceVideo.dataset.routeVideoRestored = 'true';
      } else if (origin.slug) {
        const targetVideo = document.querySelector<HTMLVideoElement>(
          `[data-gallery-item-id="${CSS.escape(origin.slug)}"] [data-preview-video]`,
        );
        if (targetVideo) void restoreRouteVideo(targetVideo, origin.slug);
      }
      window.setTimeout(() => {
        document.head.querySelector(`[${returnTransitionStyleAttribute}]`)?.remove();
        document.querySelectorAll<HTMLElement>('[data-project-grid] .project-card__media')
          .forEach((media) => media.style.removeProperty('view-transition-name'));
      }, 1_000);
    }, { once: true });

    window.setTimeout(() => {
      if (!document.querySelector('[data-work-gallery]')) {
        document.head.querySelector(`[${returnTransitionStyleAttribute}]`)?.remove();
        overlay.removeAttribute('data-overlay-return-transition');
        sourceMedia?.removeAttribute('data-project-return-source');
        mutedSourceMedia.forEach((media) => media.style.removeProperty('view-transition-name'));
      }
    }, 2_000);
  };

  const setupProjectOverlay = (): void => {
    document.querySelectorAll<HTMLElement>('[data-project-overlay]:not([data-overlay-ready])')
      .forEach((overlay) => {
        overlay.dataset.overlayReady = 'true';
        const destination = overlay.dataset.projectSlug;
        const snapshotLayer = overlay.querySelector<HTMLElement>('[data-project-overlay-snapshot]');
        if (!snapshotLayer) return;

        try {
          const snapshot = JSON.parse(
            sessionStorage.getItem(backdropStorageKey) || '{}',
          ) as GalleryBackdropSnapshot;
          if (snapshot.destination !== destination || !Array.isArray(snapshot.items)) return;

          snapshot.items.slice(0, 20).forEach((item) => {
            if (
              typeof item.src !== 'string'
              || !Number.isFinite(item.x)
              || !Number.isFinite(item.y)
              || !Number.isFinite(item.width)
              || !Number.isFinite(item.height)
            ) return;
            const source = new URL(item.src, window.location.href);
            if (source.origin !== window.location.origin && source.hostname !== 'cdn.sanity.io') return;

            const image = document.createElement('img');
            image.src = source.href;
            image.alt = '';
            image.decoding = 'async';
            image.loading = 'eager';
            image.setAttribute('aria-hidden', 'true');
            image.style.left = `${item.x * 100}%`;
            image.style.top = `${item.y * 100}%`;
            image.style.width = `${item.width * 100}%`;
            image.style.height = `${item.height * 100}%`;
            image.style.objectPosition = item.objectPosition || '50% 50%';
            snapshotLayer.append(image);
          });

          if (snapshotLayer.childElementCount > 0) overlay.dataset.overlayBackdrop = 'snapshot';
        } catch {
          sessionStorage.removeItem(backdropStorageKey);
        }
      });

    document.querySelectorAll<HTMLAnchorElement>(
      '[data-project-overlay] [data-restore-work-scroll]:not([data-overlay-return-ready])',
    ).forEach((link) => {
      link.dataset.overlayReturnReady = 'true';
      link.addEventListener('click', (event) => {
        const plainNavigation = event.button === 0
          && !event.metaKey
          && !event.ctrlKey
          && !event.shiftKey
          && !event.altKey
          && link.target !== '_blank';
        if (!plainNavigation || link.dataset.returnNavigationPending === 'true') return;

        event.preventDefault();
        link.dataset.returnNavigationPending = 'true';
        const origin = readGalleryOrigin();
        const overlay = link.closest<HTMLElement>('[data-project-overlay]');
        if (overlay) prepareProjectReturnTransition(overlay, origin);

        const currentHistoryIndex = typeof history.state?.index === 'number'
          ? history.state.index
          : undefined;
        const canTraverseToOrigin = typeof origin.historyIndex === 'number'
          && typeof currentHistoryIndex === 'number'
          && currentHistoryIndex === origin.historyIndex + 1;

        if (canTraverseToOrigin) {
          history.back();
          return;
        }

        void navigate(link.href, { history: 'replace', sourceElement: link }).catch(() => {
          window.location.assign(link.href);
        });
      });
    });
  };

  if (!routeWindow.__newWorkProjectReturnPopstateReady) {
    routeWindow.__newWorkProjectReturnPopstateReady = true;
    window.addEventListener('popstate', () => {
      const overlay = document.querySelector<HTMLElement>('[data-project-overlay]');
      if (!overlay) return;
      prepareProjectReturnTransition(overlay, readGalleryOrigin());
    });
  }

  setupProjectOverlay();
  document.addEventListener('astro:page-load', setupProjectOverlay);
</script>

