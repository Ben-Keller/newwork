---
/**
 * Brand asset seam.
 *
 * The launch build deliberately falls back to live text. Approved artwork can
 * arrive as path data or as the reviewed Sanity image/SVG URL carried through
 * `artworkSrc`; no header or layout changes are required. Keep the visible name
 * in `label` so every version shares the same accessible name.
 */
export type WordmarkVariant = 'full' | 'compact';
export type WordmarkTone = 'dark' | 'light';

export interface WordmarkPath {
  d: string;
  fillRule?: 'nonzero' | 'evenodd';
  clipRule?: 'nonzero' | 'evenodd';
}

export interface Props {
  label?: string;
  variant?: WordmarkVariant;
  tone?: WordmarkTone;
  paths?: readonly (string | WordmarkPath)[];
  viewBox?: string;
  artworkSrc?: string;
  artworkWidth?: number;
  artworkHeight?: number;
  decorative?: boolean;
  class?: string;
}

const {
  label = 'New Work',
  variant = 'full',
  tone = 'dark',
  paths = [],
  viewBox = variant === 'compact' ? '0 0 64 32' : '0 0 180 32',
  artworkSrc,
  artworkWidth,
  artworkHeight,
  decorative = false,
  class: className,
} = Astro.props;

const fallbackText = variant === 'compact' ? 'NW' : label;
const hasArtwork = Boolean(artworkSrc) || paths.length > 0;
---

<span
  class:list={[
    'wordmark',
    `wordmark--${variant}`,
    `wordmark--${tone}`,
    { 'wordmark--artwork': hasArtwork },
    className,
  ]}
  data-wordmark={variant}
  aria-hidden={decorative ? 'true' : undefined}
>
  {
    artworkSrc ? (
      <img
        class="wordmark__image"
        src={artworkSrc}
        width={artworkWidth}
        height={artworkHeight}
        alt={decorative ? '' : label}
        loading="eager"
        decoding="async"
      />
    ) : hasArtwork ? (
      <svg
        class="wordmark__artwork"
        viewBox={viewBox}
        role={decorative ? undefined : 'img'}
        aria-label={decorative ? undefined : label}
        focusable="false"
      >
        {paths.map((path) => {
          const definition: WordmarkPath = typeof path === 'string' ? { d: path } : path;

          return (
            <path
              d={definition.d}
              fill-rule={definition.fillRule}
              clip-rule={definition.clipRule}
            />
          );
        })}
      </svg>
    ) : (
      <span class="wordmark__text">{fallbackText}</span>
    )
  }
</span>
