---
import PreviewVideo from './PreviewVideo.astro';
import ResponsiveImage from './ResponsiveImage.astro';
import type { WorkGalleryEntryView } from '../lib/types';
import {
  COLUMN_SCROLL_RESPONSES,
  COMPACT_COLUMN_SCROLL_RESPONSES,
} from '../lib/motion/column-filter';
import { withBase } from '../lib/base-path';
import { buildGalleryImageSizes } from '../lib/responsive-images';

interface Props {
  entry: WorkGalleryEntryView;
  index: number;
  desktopColumn?: number;
  tabletColumn?: number;
  desktopColumnStart?: boolean;
  tabletColumnStart?: boolean;
  editable?: boolean;
}

const {
  entry,
  index,
  desktopColumn,
  tabletColumn,
  desktopColumnStart = false,
  tabletColumnStart = false,
  editable = false,
} = Astro.props;
const project = entry.work;
// The first tile in every responsive lane is immediately visible during the
// opening zoom. Load those posters eagerly, while reserving high fetch priority
// for the single LCP candidate.
const eager = index === 0 || desktopColumnStart || tabletColumnStart;
const homeCardSize = entry.cardSize || project.homeCardSize || 'standard';
const homeTreatment = entry.treatment || project.homeTreatment || 'standard';
const requestedOffset = Number.isFinite(project.homeOffset) ? project.homeOffset : 0;
// Keep editorial staggering visible without letting repeated card offsets open
// oversized holes inside an otherwise packed column.
const safeOffset = Math.max(0, Math.min(12, requestedOffset || 0));
const transitionName = `project-${entry.id}-media`;
const columnResponse = desktopColumn ? COLUMN_SCROLL_RESPONSES[desktopColumn - 1] : undefined;
const tabletColumnResponse = tabletColumn
  ? COMPACT_COLUMN_SCROLL_RESPONSES[tabletColumn - 1]
  : undefined;
const usesWideCard = project.cover.cardRatio === 'wideFeature' && index >= 8;
const doorwayVideo = entry.asset?.kind === 'video' ? entry.asset.video : undefined;
const previewSource = doorwayVideo?.src
  || (!entry.asset && !entry.photo ? project.cover.previewVideo : undefined);
const galleryImageSizes = buildGalleryImageSizes(entry.image, {
  cardAspect: usesWideCard ? 3 / 2 : 4 / 5,
  mobileSource: project.cover.mobilePoster,
});
---

<article
  class:list={[
    'project-card',
    `project-card--${homeCardSize}`,
    usesWideCard && 'project-card--wide',
  ]}
  id={`project-${project.slug}`}
  data-project-card
  data-gallery-item-id={entry.id}
  data-home-size={homeCardSize}
  data-home-treatment={homeTreatment}
  data-desktop-column={desktopColumn}
  data-tablet-column={tabletColumn}
  data-desktop-column-start={desktopColumnStart || undefined}
  data-tablet-column-start={tabletColumnStart || undefined}
  data-motion-column
  data-motion-column-response={columnResponse}
  data-motion-column-response-tablet={tabletColumnResponse}
  data-motion-reveal={index === 0 ? undefined : 'clip'}
  data-motion-delay={index === 0 ? undefined : Math.min(index, 7) * 0.035}
  style={`--home-offset:${safeOffset}px`}
>
  <a
    href={withBase(entry.href)}
    data-project-link
    data-project-slug={entry.id}
    data-gallery-asset-link={entry.asset ? true : undefined}
    data-gallery-photo-link={entry.photo ? true : undefined}
  >
    <span class="sr-only">{project.title}</span>
    <div class="project-card__media" transition:name={transitionName}>
      <div class="project-card__media-inner" data-card-media>
        <ResponsiveImage
          image={entry.image}
          mobileImage={entry.asset || entry.photo ? undefined : project.cover.mobilePoster}
          sizes={galleryImageSizes}
          eager={eager}
          priority={index === 0}
          galleryPreload
        />
        {previewSource ? (
          <PreviewVideo
            source={previewSource}
            poster={doorwayVideo?.poster?.src || project.cover.previewPosterOverride?.src || entry.image.src}
            mobilePoster={entry.asset ? undefined : project.cover.mobilePoster?.src}
            title={project.title}
            placeholder={project.cover.previewIsPlaceholder}
          />
        ) : null}
      </div>
      <div class="project-card__label project-card__label--overlay" aria-hidden="true">
        <span class="project-card__label-mask"><span>{project.title}</span></span>
      </div>
    </div>
  </a>
  {editable ? (
    <button class="gallery-card-remove" type="button" data-gallery-remove hidden aria-label={`Remove ${project.title} from gallery`}>
      <span aria-hidden="true">×</span>
    </button>
  ) : null}
</article>
