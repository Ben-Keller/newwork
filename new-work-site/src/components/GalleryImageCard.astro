---
import type { DevelopmentGalleryImage } from '../content/local/michael-gallery';
import { COLUMN_SCROLL_RESPONSES } from '../lib/motion/column-filter';
import { withBase } from '../lib/base-path';
import ResponsiveImage from './ResponsiveImage.astro';

interface Props {
  item: DevelopmentGalleryImage;
  index: number;
  desktopColumn: number;
  tabletColumn: number;
  desktopColumnStart?: boolean;
  tabletColumnStart?: boolean;
}

const {
  item,
  index,
  desktopColumn,
  tabletColumn,
  desktopColumnStart = false,
  tabletColumnStart = false,
} = Astro.props;
---

<article
  class="project-card project-card--standard gallery-image-card"
  data-project-card
  data-gallery-item-id={item.id}
  data-gallery-source="michael-library"
  data-desktop-column={desktopColumn}
  data-tablet-column={tabletColumn}
  data-desktop-column-start={desktopColumnStart || undefined}
  data-tablet-column-start={tabletColumnStart || undefined}
  data-motion-column
  data-motion-column-response={COLUMN_SCROLL_RESPONSES[desktopColumn - 1]}
  data-motion-column-response-tablet={COLUMN_SCROLL_RESPONSES[tabletColumn - 1]}
  data-motion-reveal="clip"
  data-motion-delay={Math.min(index, 7) * .025}
  style="--home-offset:0px"
>
  <a href={withBase('/about#about-person-michael')} data-gallery-link>
    <span class="sr-only">{item.label}</span>
    <div class="project-card__media">
      <div class="project-card__media-inner" data-card-media>
        <ResponsiveImage
          image={item.image}
          sizes="(min-width: 1200px) 25vw, (min-width: 768px) 50vw, 100vw"
          galleryPreload
        />
      </div>
      <div class="project-card__label project-card__label--overlay" aria-hidden="true">
        <span class="project-card__label-mask"><span>Michael</span></span>
      </div>
    </div>
  </a>
  <button class="gallery-card-remove" type="button" data-gallery-remove hidden aria-label={`Remove ${item.label} from gallery`}>
    <span aria-hidden="true">×</span>
  </button>
</article>
