---
import { withBase, withoutBase } from '../lib/base-path';
import NavigationLabel from './NavigationLabel.astro';

export interface NavItem {
  href: string;
  label: string;
  match?: 'exact' | 'section';
}

export interface Props {
  items?: readonly NavItem[];
  currentPath?: string;
  ariaLabel?: string;
  class?: string;
}

const {
  items = [
    { href: withBase('/'), label: 'Work', match: 'section' },
    { href: withBase('/contact'), label: 'Contact', match: 'section' },
  ],
  currentPath = withoutBase(Astro.url.pathname),
  ariaLabel = 'Primary',
  class: className,
} = Astro.props;

const normalizePath = (path: string): string => {
  const pathname = path.split(/[?#]/u, 1)[0] || '/';
  if (pathname === '/') return pathname;
  return pathname.replace(/\/+$/, '');
};

const activePath = normalizePath(withoutBase(currentPath));

const isExactPage = (item: NavItem): boolean => activePath === normalizePath(withoutBase(item.href));
const isCurrent = (item: NavItem): boolean => {
  const href = normalizePath(withoutBase(item.href));

  if (href === '/') {
    return activePath === '/' || (item.match === 'section' && activePath.startsWith('/work/'));
  }

  return item.match === 'exact'
    ? activePath === href
    : activePath === href || activePath.startsWith(`${href}/`);
};
---

<nav class:list={['desktop-nav', className]} aria-label={ariaLabel} data-desktop-nav>
  <ul class="desktop-nav__list" role="list">
    {
      items.map((item) => (
        <li class="desktop-nav__item">
          <a
            class:list={['desktop-nav__link', { 'is-current': isCurrent(item) }]}
            href={item.href}
            aria-label={item.label}
            aria-current={isExactPage(item) ? 'page' : undefined}
            data-work-navigation={normalizePath(withoutBase(item.href)) === '/' ? '' : undefined}
            data-nav-link
          >
            <NavigationLabel label={item.label} />
          </a>
        </li>
      ))
    }
  </ul>
  <!-- Viewfinder brackets: one marker that frames the current tab and springs
       to whichever tab is pointed at or focused; positioned from script. -->
  <span class="nav-marker" data-nav-marker aria-hidden="true"><i></i><i></i><i></i><i></i></span>
</nav>

<script>
  let disposeNav = (): void => undefined;

  const setupNav = (): void => {
    disposeNav();
    const nav = document.querySelector<HTMLElement>('[data-desktop-nav]');
    const marker = nav?.querySelector<HTMLElement>('[data-nav-marker]');
    if (!nav || !marker) return;
    const controller = new AbortController();
    const { signal } = controller;
    const links = Array.from(nav.querySelectorAll<HTMLAnchorElement>('[data-nav-link]'));

    let lastLeft: number | null = null;
    let pointed: HTMLAnchorElement | null = null;

    const place = (instant = false): void => {
      const link = pointed ?? links.find((candidate) => candidate.classList.contains('is-current')) ?? null;
      const label = link?.querySelector<HTMLElement>('.nav-label');
      if (!link || !label || !nav.offsetWidth) {
        marker.dataset.visible = 'false';
        return;
      }
      const navBox = nav.getBoundingClientRect();
      const box = label.getBoundingClientRect();
      const left = box.left - navBox.left;
      const right = navBox.right - box.right;
      marker.dataset.instant = String(instant || lastLeft === null);
      marker.style.setProperty('--marker-left', `${left.toFixed(1)}px`);
      marker.style.setProperty('--marker-right', `${right.toFixed(1)}px`);
      marker.style.setProperty('--marker-top', `${(box.top - navBox.top).toFixed(1)}px`);
      marker.style.setProperty('--marker-height', `${box.height.toFixed(1)}px`);
      marker.dataset.visible = 'true';
      marker.dataset.pointed = String(Boolean(pointed));
      lastLeft = left;
      if (marker.dataset.instant === 'true') {
        window.requestAnimationFrame(() => { marker.dataset.instant = 'false'; });
      }
    };

    links.forEach((link) => {
      link.addEventListener('pointerenter', () => { pointed = link; place(); }, { signal });
      link.addEventListener('focus', () => {
        if (!link.matches(':focus-visible')) return;
        pointed = link;
        place();
      }, { signal });
      link.addEventListener('blur', () => { if (pointed === link) { pointed = null; place(); } }, { signal });
    });
    nav.addEventListener('pointerleave', () => { pointed = null; place(); }, { signal });
    window.addEventListener('resize', () => place(true), { passive: true, signal });
    void document.fonts?.ready.then(() => place(true)).catch(() => undefined);
    place(true);

    disposeNav = () => {
      controller.abort();
      disposeNav = () => undefined;
    };
  };

  setupNav();
  document.addEventListener('astro:page-load', setupNav);
  document.addEventListener('astro:before-swap', () => disposeNav());
</script>
