---
import { reducedMotionFeaturedStills } from '../lib/reel/reel-assets';
import type { AboutPageView } from '../lib/types';

interface Props {
  assetBase: string;
  copy: AboutPageView;
  ctaHref: string;
}

const { assetBase, copy, ctaHref } = Astro.props;
const normalizedAssetBase = assetBase.endsWith('/') ? assetBase : `${assetBase}/`;
const assetUrl = (path: string) => `${normalizedAssetBase}${path.replace(/^\/+/, '')}`;
const openingPlaceholderFrames = Array.from({length: 12});

const stages = [
  {
    id: 'rushes',
    marker: '01 — Lorem',
    start: 0,
    end: 0.17,
    eyebrow: copy.openingLabel,
    title: copy.openingHeadline,
    note: copy.openingNote,
  },
  {
    id: 'winding',
    marker: '02 — Ipsum',
    start: 0.14,
    end: 0.38,
    eyebrow: 'Lorem ipsum dolor',
    title: copy.windingHeadline,
    note: 'Sed do eiusmod tempor',
  },
  {
    id: 'orbit',
    marker: '03 — Dolor',
    start: 0.38,
    end: 0.61,
    eyebrow: 'Lorem ipsum dolor',
    title: copy.orbitHeadline,
    note: 'Ut labore et dolore',
  },
  {
    id: 'index',
    marker: '04 — Amet',
    start: 0.59,
    end: 0.79,
    eyebrow: 'Lorem ipsum dolor',
    title: copy.indexHeadline,
    note: 'Quis nostrud exercitation',
  },
  {
    id: 'chapters',
    marker: '05 — Elit',
    start: 0.77,
    end: 0.91,
    eyebrow: 'Lorem ipsum dolor',
    title: copy.chaptersHeadline,
    note: 'Reprehenderit in voluptate',
  },
  {
    id: 'aperture',
    marker: '06 — Tempor',
    start: 0.86,
    end: 0.981,
    eyebrow: 'Lorem ipsum dolor',
    title: copy.apertureHeadline,
    note: 'Sunt in culpa qui officia',
  },
] as const;
---

<section
  class="reel-experience"
  data-about-experience
  data-asset-base={normalizedAssetBase}
  data-mode="loading"
  data-reel-scroll-ready="false"
  aria-busy="true"
>
  <a class="reel-skip-link" href="#about-archive" aria-label="Skip the motion experience">Lorem ipsum</a>

  <div class="reel-motion-stage">
    <div class="reel-canvas-mount" data-reel-canvas></div>
    <div class="reel-opening-placeholder" data-reel-opening-placeholder aria-hidden="true">
      <div class="reel-opening-placeholder__track reel-opening-placeholder__track--upper">
        {openingPlaceholderFrames.map(() => <i></i>)}
      </div>
      <div class="reel-opening-placeholder__track reel-opening-placeholder__track--feed">
        {openingPlaceholderFrames.slice(0, 5).map(() => <i></i>)}
      </div>
      <div class="reel-opening-placeholder__track reel-opening-placeholder__track--lower">
        {openingPlaceholderFrames.slice(0, 7).map(() => <i></i>)}
      </div>
    </div>
    <div class="reel-paper-wash" aria-hidden="true"></div>
    <div class="reel-grain" aria-hidden="true"></div>

    <div class="reel-scene-chrome" aria-hidden="true">
      <span data-reel-marker>01 — Lorem</span>
    </div>

    <div class="reel-progress-track" aria-hidden="true"><span></span></div>

    <div class="reel-stage-copy-stack">
      {stages.map((stage) => (
        <article
          class:list={['reel-stage-copy', `reel-stage-copy--${stage.id}`]}
          data-reel-stage-copy
          data-start={stage.start}
          data-end={stage.end}
          data-initial={stage.id === 'rushes' ? 'true' : undefined}
          data-exit-duration={stage.id === 'aperture' ? '0.017' : undefined}
        >
          <p>{stage.eyebrow}</p>
          <h1>{stage.title}</h1>
          <small>{stage.note}</small>
        </article>
      ))}

      <article
        class="reel-stage-copy reel-stage-copy--final"
        data-reel-stage-copy
        data-final
        data-enter-duration="0.017"
        data-start="0.964"
        data-end="1.1"
      >
        <p>{copy.closingLabel}</p>
        <h1>{copy.closingHeadline}</h1>
        <a href={ctaHref} tabindex="-1" aria-label="Start a project">
          {copy.ctaLabel} <span aria-hidden="true">↗</span>
        </a>
      </article>
    </div>

    <div class="reel-loading-card" role="status">
      <span>Lorem ipsum</span>
      <i></i>
    </div>
  </div>

  <section id="about-archive" class="reel-static-fallback">
    <div class="reel-fallback-intro">
      <p>{copy.fallbackLabel}</p>
      <h1>{copy.fallbackHeadline}</h1>
      <span>{copy.fallbackDescription}</span>
    </div>
    <div class="reel-fallback-grid">
      {reducedMotionFeaturedStills.map((asset, index) => (
        <figure class:list={['reel-fallback-card', `reel-card-${index + 1}`]}>
          <div class="reel-fallback-image">
            <img
              src={assetUrl(asset.poster)}
              alt={asset.alt}
              loading="lazy"
              data-reel-fallback-asset
            />
          </div>
          <figcaption>
            <span>Lorem ipsum</span>
            <small>Dolor sit amet</small>
          </figcaption>
        </figure>
      ))}
    </div>
    <div class="reel-fallback-cta">
      <p>{copy.closingLabel}</p>
      <h2>{copy.closingHeadline}</h2>
      <a href={ctaHref} aria-label="Start a project">{copy.ctaLabel} <span aria-hidden="true">↗</span></a>
    </div>
  </section>

  <noscript>
    <style is:global>
      .reel-experience[data-mode='loading'] { height: auto; overflow: visible; }
      .reel-experience[data-mode='loading'] .reel-motion-stage { display: none; }
      .reel-experience[data-mode='loading'] .reel-static-fallback { display: block; }
    </style>
    <p class="reel-noscript-note">Lorem ipsum dolor sit amet, consectetur adipiscing elit.</p>
  </noscript>
</section>

<script>
  type AboutController = {
    destroy: () => void;
    refresh: () => void;
  };

  declare global {
    interface Window {
      __newWorkAboutCleanup?: () => void;
      __newWorkAboutLifecycleInstalled?: boolean;
    }
  }

  const quintic = (edge0: number, edge1: number, value: number): number => {
    const t = Math.min(1, Math.max(0, (value - edge0) / (edge1 - edge0)));
    return t * t * t * (t * (t * 6 - 15) + 10);
  };

  const supportsWebGL2 = (): boolean => {
    try {
      const probe = document.createElement('canvas');
      const context = probe.getContext('webgl2', {powerPreference: 'high-performance'});
      if (!context) return false;
      context.getExtension('WEBGL_lose_context')?.loseContext();
      return true;
    } catch {
      return false;
    }
  };

  const initializeAboutExperience = (): void => {
    const root = document.querySelector<HTMLElement>('[data-about-experience]');
    const mount = root?.querySelector<HTMLElement>('[data-reel-canvas]');
    if (!root || !mount) {
      window.__newWorkAboutCleanup?.();
      return;
    }
    // This component script and Astro's first page-load event run back to
    // back. Preserve the first engine instead of compiling and loading the
    // full WebGL experience twice.
    if (root.dataset.reelLifecycleReady === 'true') return;
    window.__newWorkAboutCleanup?.();
    root.dataset.reelLifecycleReady = 'true';

    let cancelled = false;
    let controller: AboutController | undefined;
    let placeholderRevealFrame = 0;
    let canvasRevealFrame = 0;
    const assetController = new AbortController();
    const openingPlaceholder = root.querySelector<HTMLElement>('[data-reel-opening-placeholder]');
    const fallbackAssets = Array.from(
      root.querySelectorAll<HTMLImageElement>('[data-reel-fallback-asset]'),
    );
    root.dataset.reelAssetsManaged = 'true';
    root.dataset.reelScrollReady = 'false';
    document.documentElement.dataset.aboutReelScrollLocked = 'true';
    const queuedAssets = new WeakSet<HTMLImageElement>();
    const revealFallbackAsset = (image: HTMLImageElement): void => {
      if (queuedAssets.has(image)) return;
      queuedAssets.add(image);
      window.requestAnimationFrame(() => window.requestAnimationFrame(() => {
        if (!cancelled && image.isConnected) image.dataset.assetLoaded = 'true';
      }));
    };
    fallbackAssets.forEach((image) => {
      if (image.complete && image.naturalWidth > 0) revealFallbackAsset(image);
      else image.addEventListener('load', () => revealFallbackAsset(image), {
        once: true,
        signal: assetController.signal,
      });
    });
    const syncPlaceholderGeometry = (): void => {
      const cameraZ = 7.5;
      const viewHeight = 2 * cameraZ * Math.tan(19 * Math.PI / 180);
      const viewAspect = window.innerWidth / Math.max(1, window.innerHeight);
      const minView = viewHeight * Math.min(1, viewAspect);
      const openingDepthScale = (cameraZ - 0.27 * minView) / cameraZ;
      const frameWidth = 0.1696460033
        * Math.min(window.innerWidth, window.innerHeight)
        / openingDepthScale;
      root.style.setProperty('--opening-feed-frame-width', `${frameWidth}px`);
      root.style.setProperty('--opening-feed-frame-height', `${frameWidth / (16 / 9)}px`);
    };
    syncPlaceholderGeometry();
    window.addEventListener('resize', syncPlaceholderGeometry, {passive: true});
    root.dataset.mode = 'loading';
    root.setAttribute('aria-busy', 'true');
    // Commit the transparent placeholder before asking the browser to reveal
    // it. Without the frame boundary a warm cache can collapse both states
    // into one paint and skip the transition entirely.
    openingPlaceholder?.getBoundingClientRect();
    placeholderRevealFrame = window.requestAnimationFrame(() => {
      placeholderRevealFrame = 0;
      if (!cancelled && openingPlaceholder?.isConnected) {
        openingPlaceholder.dataset.placeholderVisible = 'true';
      }
    });

    const settleFallback = (): void => {
      if (cancelled) return;
      controller?.destroy();
      controller = undefined;
      root.dataset.mode = 'fallback';
      root.setAttribute('aria-busy', 'false');
      openingPlaceholder?.remove();
      root.dataset.reelScrollReady = 'true';
      delete document.documentElement.dataset.aboutReelScrollLocked;
    };

    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches || !supportsWebGL2()) {
      settleFallback();
      window.__newWorkAboutCleanup = () => {
        cancelled = true;
        assetController.abort();
        if (placeholderRevealFrame) window.cancelAnimationFrame(placeholderRevealFrame);
        if (canvasRevealFrame) window.cancelAnimationFrame(canvasRevealFrame);
        window.removeEventListener('resize', syncPlaceholderGeometry);
        delete root.dataset.reelAssetsManaged;
        delete root.dataset.reelAssetsReady;
        delete root.dataset.reelScrollReady;
        delete root.dataset.reelLifecycleReady;
        delete document.documentElement.dataset.aboutReelScrollLocked;
      };
      return;
    }

    const assetBase = root.dataset.assetBase || '/';
    const preloadImage = (key: string, path: string): void => {
      if (document.head.querySelector(`link[data-reel-preload="${key}"]`)) return;
      const link = document.createElement('link');
      link.rel = 'preload';
      link.as = 'image';
      link.type = 'image/webp';
      link.href = `${assetBase}${path}`;
      link.dataset.reelPreload = key;
      link.setAttribute('fetchpriority', 'high');
      document.head.appendChild(link);
    };
    // Start critical imagery alongside the engine chunk rather than waiting
    // for Three.js to download and evaluate before beginning these requests.
    preloadImage('atlas', 'media/atlas-grid.webp');
    preloadImage(
      'feature',
      'media/images/oliver/olympics-toyota-alex-massailas/featured-frame-6.webp',
    );

    const stageElements = Array.from(
      root.querySelectorAll<HTMLElement>('[data-reel-stage-copy]'),
    );
    const marker = root.querySelector<HTMLElement>('[data-reel-marker]');
    const markerRanges = [
      [0, '01 — Lorem'],
      [0.14, '02 — Ipsum'],
      [0.38, '03 — Dolor'],
      [0.59, '04 — Amet'],
      [0.77, '05 — Elit'],
      [0.86, '06 — Tempor'],
      [0.972, '07 — Ipsum'],
    ] as const;

    const updateInterface = (progress: number): void => {
      root.style.setProperty('--reel-progress', progress.toFixed(5));
      stageElements.forEach((element) => {
        const start = Number(element.dataset.start ?? 0);
        const end = Number(element.dataset.end ?? 1);
        const enterDuration = Number(element.dataset.enterDuration ?? 0.025);
        const exitDuration = Number(element.dataset.exitDuration ?? 0.025);
        const enter = element.hasAttribute('data-initial')
          ? 1
          : quintic(start, Math.min(end, start + enterDuration), progress);
        const exit = element.hasAttribute('data-final')
          ? 1
          : 1 - quintic(Math.max(start, end - exitDuration), end, progress);
        const opacity = enter * exit;
        const travel = (1 - enter) * 28 - (1 - exit) * 22;
        const interactive = opacity > 0.72;
        element.style.opacity = opacity.toFixed(4);
        element.style.transform = `translate3d(0, ${travel.toFixed(2)}px, 0)`;
        element.style.pointerEvents = interactive ? 'auto' : 'none';
        element.inert = !interactive;
        element.querySelectorAll<HTMLAnchorElement>('a').forEach((anchor) => {
          anchor.tabIndex = interactive ? 0 : -1;
        });
      });
      let currentMarker: string = markerRanges[0][1];
      markerRanges.forEach(([start, label]) => {
        if (progress >= start) currentMarker = label;
      });
      if (marker) marker.textContent = currentMarker;
    };

    void import('../lib/reel/engine')
      .then((module) => {
        // A fast route change can finish before the engine chunk arrives.
        // Avoid constructing an off-screen renderer in that case.
        if (cancelled) return undefined;
        return module.createExperience({
          mount,
          scrollRoot: root,
          assetBase,
          onReady: () => {
            if (cancelled) return;
            root.dataset.mode = 'enhanced';
            const canvas = mount.querySelector<HTMLCanvasElement>('.reel-media-canvas');
            canvas?.getBoundingClientRect();
            canvasRevealFrame = window.requestAnimationFrame(() => {
              canvasRevealFrame = 0;
              if (cancelled || !canvas?.isConnected) return;
              root.dataset.reelAssetsReady = 'true';
              canvas.dataset.assetFade = 'active';
              canvas.style.opacity = '0';
              const startedAt = performance.now();
              let paintedFrames = 0;
              const paintFadeFrame = (now: number): void => {
                if (cancelled || !canvas.isConnected) return;
                paintedFrames += 1;
                // Require several painted steps as well as elapsed time. This
                // keeps a busy first render from jumping directly to opaque.
                const elapsedProgress = Math.min(1, (now - startedAt) / 720);
                const frameProgress = Math.min(1, paintedFrames / 18);
                const progress = Math.min(elapsedProgress, frameProgress);
                const easedProgress = quintic(0, 1, progress);
                canvas.style.opacity = easedProgress.toFixed(4);
                if (progress < 1) {
                  canvasRevealFrame = window.requestAnimationFrame(paintFadeFrame);
                  return;
                }
                canvasRevealFrame = 0;
                canvas.dataset.assetFade = 'complete';
                openingPlaceholder?.remove();
                root.setAttribute('aria-busy', 'false');
                root.dataset.reelScrollReady = 'true';
                delete document.documentElement.dataset.aboutReelScrollLocked;
                window.requestAnimationFrame(() => controller?.refresh());
              };
              canvasRevealFrame = window.requestAnimationFrame(paintFadeFrame);
            });
          },
          onFailure: settleFallback,
          onProgress: updateInterface,
        });
      })
      .then((createdController) => {
        if (!createdController) return;
        if (cancelled) createdController.destroy();
        else {
          controller = createdController;
          if (root.dataset.reelScrollReady === 'true') createdController.refresh();
        }
      })
      .catch(settleFallback);

    window.__newWorkAboutCleanup = () => {
      cancelled = true;
      controller?.destroy();
      controller = undefined;
      assetController.abort();
      if (placeholderRevealFrame) window.cancelAnimationFrame(placeholderRevealFrame);
      if (canvasRevealFrame) window.cancelAnimationFrame(canvasRevealFrame);
      window.removeEventListener('resize', syncPlaceholderGeometry);
      root.style.removeProperty('--reel-progress');
      delete root.dataset.reelAssetsManaged;
      delete root.dataset.reelAssetsReady;
      delete root.dataset.reelScrollReady;
      delete root.dataset.reelLifecycleReady;
      delete document.documentElement.dataset.aboutReelScrollLocked;
    };
  };

  if (!window.__newWorkAboutLifecycleInstalled) {
    window.__newWorkAboutLifecycleInstalled = true;
    document.addEventListener('astro:page-load', initializeAboutExperience);
    document.addEventListener('astro:before-swap', () => window.__newWorkAboutCleanup?.());
  }
  initializeAboutExperience();
</script>
