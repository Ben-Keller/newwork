---
import ResponsiveImage from '../ResponsiveImage.astro';
import MediaCaption from './MediaCaption.astro';
import type { ImagePairBlock } from '../../lib/types';
interface Props { block: ImagePairBlock; eager?: boolean; sizes?: string }
const { block, eager = false, sizes = '(min-width: 768px) 50vw, 100vw' } = Astro.props;
---
<figure class="media-block media-block--pair">
  <div
    class:list={['media-pair', `media-pair-ratio--${block.ratioHandling || 'natural'}`]}
    style={`--pair-ratio:${block.images[0].width} / ${block.images[0].height}`}
  >
    {block.images.map((image, index) => (
      <div class="media-item">
        <ResponsiveImage
          image={image}
          sizes={sizes}
          eager={eager && index === 0}
          projectPoster={eager && index === 0}
        />
        {image.caption || image.credit ? (
          <p class="media-item__meta">
            {image.caption ? <span>{image.caption}</span> : null}
            {image.credit ? <span class="media-credit">{image.credit}</span> : null}
          </p>
        ) : null}
      </div>
    ))}
  </div>
  <MediaCaption caption={block.caption} credit={block.credit} />
</figure>
