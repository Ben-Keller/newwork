---
import { withBase } from '../lib/base-path';
---

<section class="contact-callout" aria-labelledby="contact-callout-heading" data-contact-callout>
  <div class="contact-callout__inner">
    <p class="contact-callout__eyebrow">Looking to create something beautiful?</p>
    <a class="contact-callout__link" href={withBase('/contact')} aria-labelledby="contact-callout-heading">
      <h2 id="contact-callout-heading"><span class="contact-callout__outline">contact</span>{' '}<span>us.</span></h2>
      <span class="contact-callout__arrow" aria-hidden="true">
        <svg viewBox="0 0 48 48" fill="none">
          <path d="M12 36 36 12M12 12h24v24" stroke="currentColor" stroke-width="2" />
        </svg>
      </span>
    </a>
  </div>
</section>

<style>
  .contact-callout {
    position: relative;
    max-width: 1800px;
    margin-inline: auto;
    margin-block-start: clamp(-2rem, -2vw, -1rem);
    padding-inline: var(--page-gutter);
  }

  .contact-callout__inner {
    padding-block: clamp(.5rem, .75vw, .75rem) clamp(3rem, 5vw, 5rem);
    text-align: center;
  }

  .contact-callout__eyebrow {
    margin-bottom: clamp(1.25rem, 2vw, 2rem);
    font-size: clamp(.9375rem, 1.35vw, 1.25rem);
    line-height: 1.3;
    letter-spacing: -.02em;
  }

  .contact-callout__link {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: clamp(.75rem, 1.5vw, 1.25rem);
    width: fit-content;
    margin-inline: auto;
    color: var(--color-ink);
    text-decoration: none;
  }

  .contact-callout h2 {
    display: flex;
    align-items: baseline;
    gap: .18em;
    font-family: "New Work Title", var(--font-body);
    font-size: clamp(2rem, 3.8vw, 4rem);
    font-weight: 900;
    line-height: .95;
    letter-spacing: -.035em;
    white-space: nowrap;
  }

  .contact-callout__outline {
    color: transparent;
    -webkit-text-stroke: max(1px, .009em) var(--color-ink);
    paint-order: stroke fill;
    transition: color 240ms ease;
  }

  .contact-callout__arrow {
    display: grid;
    flex: 0 0 auto;
    width: clamp(2.5rem, 3.5vw, 3rem);
    aspect-ratio: 1;
    place-items: center;
    border: 1px solid var(--color-ink);
    border-radius: 50%;
    transition: color 240ms ease, background-color 240ms ease;
  }

  .contact-callout__arrow svg {
    width: 45%;
    height: 45%;
    transition: transform 280ms cubic-bezier(.22, 1, .36, 1);
  }

  .contact-callout__link:focus-visible {
    outline-offset: 12px;
  }

  .contact-callout__link:focus-visible .contact-callout__outline {
    color: var(--color-ink);
  }

  .contact-callout__link:focus-visible .contact-callout__arrow {
    color: var(--color-canvas);
    background: var(--color-ink);
  }

  @media (hover: hover) and (pointer: fine) {
    .contact-callout__link:hover .contact-callout__outline {
      color: var(--color-ink);
    }

    .contact-callout__link:hover .contact-callout__arrow {
      color: var(--color-canvas);
      background: var(--color-ink);
    }

    .contact-callout__link:hover svg {
      transform: translate(3px, -3px);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .contact-callout__outline,
    .contact-callout__arrow,
    .contact-callout__arrow svg {
      transition: none;
    }

    .contact-callout__link:hover svg {
      transform: none;
    }
  }
</style>
