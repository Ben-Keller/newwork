---
import SplitFlapTicker from './SplitFlapTicker.astro';
import OliverBrand from './OliverBrand.astro';
import type { BrandAssetView, ClientLogoView, ProjectView } from '../lib/types';
import type { WordmarkTone } from './Wordmark.astro';
import { withBase } from '../lib/base-path';
import {resolveFooterLogos} from '../lib/footer-projects';
import {buildResponsiveSrcset, pickResponsiveSource} from '../lib/responsive-images';
interface Props {
  tickerWords?: string[]; siteName?: string; clientLogos?: ClientLogoView[];
  projects?: ProjectView[];
  copyrightLine?: string; wordmarkAsset?: BrandAssetView; tone?: WordmarkTone;
  showYear?: boolean; class?: string;
}
const { siteName = 'New Work Agency', tickerWords = ['Arriving', 'In transit', 'Departing', 'Early'],
  clientLogos = [], projects = [], copyrightLine = 'All rights reserved.', wordmarkAsset,
  showYear = true, class: className } = Astro.props;
const year = new Date().getFullYear();
const logos = resolveFooterLogos(clientLogos, projects);
---
<footer class:list={['site-footer', className]} data-site-footer>
  <div class="site-footer__inner">
    <div class="site-footer__main">
      <div class="site-footer__directory">
        {logos.length > 0 && <ul class="client-logos" aria-label="Clients" role="list">
          {logos.map(client => {
            const Tag = client.href ? 'a' : 'span';
            return <li><Tag class="client-logos__mark" href={client.href}
              aria-label={client.projectTitle ? `${client.name} — ${client.projectTitle}` : client.name}
              data-footer-project={client.image ? client.key : undefined}>
              {client.artwork ? <img class="client-logos__artwork" src={client.artwork.src} alt={client.name}
                width={client.artwork.width || 230} height={client.artwork.height || 60}
                loading="lazy" decoding="async" /> : <span class="client-logos__name">{client.name}</span>}
              {client.image && <span class="client-logos__preview" data-footer-preview aria-hidden="true">
                <img data-preview-src={pickResponsiveSource(client.image, 480)}
                  data-preview-srcset={buildResponsiveSrcset(client.image)}
                  sizes="(min-width: 1455px) 320px, (min-width: 1091px) 22vw, 240px"
                  width={client.image.width} height={client.image.height} alt="" decoding="async"
                  style={`object-position:${client.image.objectPosition || '50% 50%'}`} />
              </span>}
            </Tag></li>;
          })}
        </ul>}
      </div>
      <div class="site-footer__signature">
        <a
          class="site-footer__brand"
          href={withBase('/')}
          aria-label={siteName}
        >
          <OliverBrand variant="stacked" asset={wordmarkAsset} class="site-footer__wordmark" />
        </a>
        <span class="site-footer__discipline">
          <SplitFlapTicker words={tickerWords} cells={10} class="site-footer__ticker" size="var(--footer-ticker-height)" label={tickerWords.join('. ')} />
        </span>
      </div>
      {showYear && (
        <div class="site-footer__bottom">
          <p class="site-footer__legal">© {year} {siteName}<br />{copyrightLine}</p>
        </div>
      )}
    </div>
  </div>
</footer>

<script>
  import {setupFooterPreviews} from '../lib/footer-previews';

  let cleanup: (() => void) | undefined;
  const setup = () => {
    cleanup?.();
    cleanup = setupFooterPreviews(document.querySelector('[data-site-footer]'));
  };
  setup();
  document.addEventListener('astro:page-load', setup);
  document.addEventListener('astro:before-swap', () => cleanup?.());
</script>

<style>
  .site-footer { position: relative; isolation: isolate; color: var(--color-ink); background: var(--page-background, var(--color-canvas)); font-family: var(--font-body); border-block-start: 1px solid var(--color-rule); }
  .site-footer__inner { max-inline-size: var(--site-max-width); margin-inline: auto; padding: clamp(1.75rem, 3vw, 3rem) var(--site-gutter) max(1.75rem, env(safe-area-inset-bottom)); }
  .site-footer__main { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.2fr) max-content; align-items: start; gap: clamp(1.5rem, 3vw, 3rem); }
  .site-footer__signature { grid-column: 1; grid-row: 1; display: flex; align-items: flex-end; flex-wrap: nowrap; min-width: 0; gap: clamp(.75rem, 1.7vw, 1.5rem); }
  .site-footer__brand { display: flex; flex: 0 1 clamp(170px, 20vw, 280px); min-width: 0; color: inherit; text-decoration: none; }
  .site-footer__brand:focus-visible { outline: 2px solid currentColor; outline-offset: 6px; }
  .site-footer__signature :global(.site-footer__wordmark.oliver-brand) { width: 100%; }
  .site-footer__discipline { --footer-ticker-height: clamp(1.2rem, 1.7vw, 1.6rem); display: flex; flex: 0 0 auto; margin: 0; }
  .site-footer__directory { grid-column: 2; grid-row: 1; width: 100%; min-width: 0; }
  .site-footer__bottom { grid-column: 3; grid-row: 1; max-inline-size: 14em; }
  .site-footer__legal { margin: 0; font-size: var(--text-xs); line-height: 1.45; text-align: start; overflow-wrap: anywhere; }
  .client-logos { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); align-items: center; gap: 24px clamp(16px, 2.2vw, 32px); margin: 0; padding: 0; list-style: none; }
  .client-logos li { min-width: 0; }
  .client-logos__mark { display: flex; align-items: center; justify-content: center; min-height: 48px; color: inherit; text-decoration: none; }
  .client-logos__artwork { display: block; width: 100%; max-width: 104px; height: 48px; object-fit: contain; filter: brightness(0) invert(var(--brand-asset-invert, 0)); }
  .client-logos__name { font-weight: 700; overflow-wrap: anywhere; }
  a.client-logos__mark:focus-visible { outline: 2px solid currentColor; outline-offset: 6px; }
  .client-logos__preview { display: block; position: fixed; left: 0; top: 0; z-index: 2; width: clamp(240px, 22vw, 320px); max-width: calc(100vw - 32px); aspect-ratio: 4 / 3; overflow: hidden; pointer-events: none; visibility: hidden; opacity: 0; transform: translateY(6px); transition: opacity 180ms ease, transform 240ms cubic-bezier(.22, 1, .36, 1); }
  .client-logos__preview img { display: block; width: 100%; height: 100%; object-fit: cover; }
  .client-logos__preview[data-active][data-ready] { visibility: visible; opacity: 1; transform: none; }
  @media (prefers-reduced-motion: reduce) { .client-logos__preview { transition: none; transform: none; } }
  @media (max-width: 1099px) {
    .site-footer__main { grid-template-columns: minmax(0, 1fr) max-content; gap: 32px clamp(24px, 5vw, 56px); }
    .site-footer__signature { grid-column: 1 / -1; }
    .site-footer__directory { grid-column: 1; grid-row: 2; max-width: 384px; }
    .site-footer__bottom { grid-column: 2; grid-row: 2; }
  }
  @media (max-width: 599px) {
    .site-footer__main { column-gap: 24px; }
    .client-logos { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 16px 20px; }
    .client-logos__mark, .client-logos__artwork { height: 40px; min-height: 40px; }
    .client-logos__artwork { max-width: 80px; }
  }
</style>
