---
import BrandLockup from './BrandLockup.astro';
import type { BrandAssetView, FooterLineView } from '../lib/types';
import type { WordmarkTone } from './Wordmark.astro';
import { withBase } from '../lib/base-path';

export interface FooterLink {
  href?: string;
  url?: string;
  label: string;
}

export interface Props {
  siteName?: string;
  contactEmail?: string;
  contactLabel?: string;
  links?: readonly FooterLink[];
  people?: readonly FooterLink[];
  strapline?: readonly FooterLineView[];
  exploreLinks?: readonly FooterLink[];
  peopleHeading?: string;
  exploreHeading?: string;
  connectHeading?: string;
  copyrightLine?: string;
  wordmarkAsset?: BrandAssetView;
  tone?: WordmarkTone;
  showContact?: boolean;
  showNotes?: boolean;
  showYear?: boolean;
  class?: string;
}

const {
  siteName = 'New Work Agency',
  contactEmail,
  contactLabel,
  links = [],
  people = [],
  strapline = [
    {text: 'New Work is film.', emphasis: 'New Work'},
    {text: 'New Work is photography.', emphasis: 'New Work'},
    {text: 'We make beautiful work.', emphasis: 'beautiful'},
    {text: 'Come create with us.', emphasis: 'create'},
  ],
  exploreLinks: suppliedExploreLinks,
  peopleHeading = 'People',
  exploreHeading = 'Explore',
  connectHeading = 'Connect',
  copyrightLine = 'All rights reserved.',
  wordmarkAsset,
  tone = 'dark',
  showContact = true,
  showNotes = false,
  showYear = true,
  class: className,
} = Astro.props;

const year = new Date().getFullYear();
const emailText = contactLabel ?? contactEmail;
const resolvedLinks = links.flatMap((link) => {
  const href = link.href ?? link.url;
  return href ? [{ href, label: link.label }] : [];
});
const resolvedPeople = people.flatMap((link) => {
  const href = link.href ?? link.url;
  return href ? [{ href, label: link.label }] : [];
});
const defaultExploreLinks = [
  { href: withBase('/#work-gallery'), label: 'Work' },
  { href: withBase('/about'), label: 'About' },
  ...(showNotes ? [{ href: withBase('/notes'), label: 'Notes' }] : []),
  { href: withBase('/contact'), label: 'Contact' },
];
const exploreLinks = suppliedExploreLinks?.length ? suppliedExploreLinks : defaultExploreLinks;
const connectLinks = [
  ...(showContact && contactEmail && emailText
    ? [{ href: `mailto:${contactEmail}`, label: emailText }]
    : []),
  ...resolvedLinks,
];
const straplineParts = strapline.map((line) => {
  if (!line.emphasis) return {text: line.text};
  const index = line.text.indexOf(line.emphasis);
  if (index < 0) return {text: line.text};
  return {
    text: line.text,
    before: line.text.slice(0, index),
    emphasis: line.emphasis,
    after: line.text.slice(index + line.emphasis.length),
  };
});
---

<footer class:list={['site-footer', className]} data-site-footer>
  <div class="site-footer__inner">
    <div class="site-footer__main">
      <div class="site-footer__strapline">
        {straplineParts.map((line) => (
          <p>{line.emphasis ? <>{line.before}<em>{line.emphasis}</em>{line.after}</> : line.text}</p>
        ))}
      </div>

      <nav class="site-footer__directory" aria-label="Footer">
        {resolvedPeople.length ? (
          <div class="site-footer__group site-footer__group--people">
            <h2>{peopleHeading}</h2>
            <ul role="list">
              {resolvedPeople.map((link) => <li><a href={link.href}>{link.label}</a></li>)}
            </ul>
          </div>
        ) : null}

        <div class="site-footer__group site-footer__group--explore">
          <h2>{exploreHeading}</h2>
          <ul role="list">
            {exploreLinks.map((link) => <li><a href={link.href}>{link.label}</a></li>)}
          </ul>
        </div>

        {connectLinks.length ? (
          <div class="site-footer__group site-footer__group--connect">
            <h2>{connectHeading}</h2>
            <ul role="list">
              {connectLinks.map((link) => (
                <li><a href={link.href} rel={/^https?:/u.test(link.href) ? 'noreferrer' : undefined}>{link.label}</a></li>
              ))}
            </ul>
          </div>
        ) : null}
      </nav>
    </div>

    <div class="site-footer__bottom">
      <a
        class="site-footer__brand"
        href={withBase('/')}
        aria-label={siteName}
      >
        <BrandLockup
          label={siteName}
          variant="full"
          tone={tone}
          artworkSrc={wordmarkAsset?.src}
          artworkWidth={wordmarkAsset?.width}
          artworkHeight={wordmarkAsset?.height}
        />
      </a>
      {showYear && <p class="site-footer__legal">© {year} {siteName}<br />{copyrightLine}</p>}
    </div>
  </div>
</footer>
