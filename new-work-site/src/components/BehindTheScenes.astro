---
import type { BtsArtworkView } from '../lib/types';
import type { BtsItem } from '../lib/bts';
import { withBase } from '../lib/base-path';
import ResponsiveImage from './ResponsiveImage.astro';

interface Props { items: BtsItem[]; heading?: string; subtitle?: string; artworks?: BtsArtworkView[]; artworkMode?: 'default' | 'custom' | 'none'; showCaptions?: boolean; showNumbers?: boolean }
const { items, heading = 'Behind the scenes', subtitle = '', artworks = [], artworkMode = 'default', showCaptions = true, showNumbers = true } = Astro.props;
const outline = /^(Behind)(\b.*)$/iu.exec(heading);
const poses = [
  { span: 2, ratio: '3 / 2', angle: -1.8, offset: -3 },
  { span: 1, ratio: '4 / 5', angle: 1.3, offset: 14 },
  { span: 1, ratio: '4 / 5', angle: -1.6, offset: -5 },
  { span: 1, ratio: '1 / 1', angle: 1.8, offset: -8 },
  { span: 2, ratio: '3 / 2', angle: -.8, offset: 6 },
  { span: 1, ratio: '4 / 5', angle: 1.4, offset: 10 },
  { span: 1, ratio: '1 / 1', angle: -1.9, offset: -6 },
  { span: 1, ratio: '4 / 5', angle: -1.2, offset: 5 },
  { span: 1, ratio: '6 / 5', angle: 2, offset: -5 },
  { span: 1, ratio: '4 / 5', angle: -.8, offset: 10 },
  { span: 1, ratio: '1 / 1', angle: 1.3, offset: -4 },
  { span: 1, ratio: '4 / 5', angle: -1.7, offset: 4 },
] as const;
const frames = items.map((item, index) => ({ item, pose: poses[index % poses.length]! }));
const artworkEntries: Array<{afterPhoto: number; artwork?: BtsArtworkView}> = artworkMode === 'custom'
  ? artworks.map(artwork => ({afterPhoto: Math.min(artwork.afterPhoto, items.length), artwork}))
  : artworkMode === 'default' && items.length >= 2 ? [{afterPhoto: 2}] : [];
const board = Array.from({length: items.length + 1}, (_, index) => [
  ...artworkEntries.filter(entry => entry.afterPhoto === index).map(entry => ({kind: 'artwork' as const, artwork: entry.artwork})),
  ...(frames[index] ? [{kind: 'photo' as const, ...frames[index], index}] : []),
]).flat();
const imageSizes = (wide: boolean) => wide
  ? '(min-width: 1800px) 510px, (min-width: 1000px) 30.6vw, (min-width: 600px) 52.7vw, 74.8vw'
  : '(min-width: 1800px) 238px, (min-width: 1000px) 15.3vw, (min-width: 600px) 25.5vw, 35.7vw';
---
{items.length > 0 && (
  <section class="bts" id="behind-the-scenes" aria-labelledby="bts-heading" data-bts data-bts-layout="pinboard">
    <header class="bts__header"><h2 id="bts-heading">{outline ? <><span class="bts__outline">{outline[1]}</span>{outline[2]}</> : heading}</h2>{subtitle && <span aria-hidden="true">{subtitle}</span>}</header>
    <div class="bts__board" style={`--pinboard-surface: url("${withBase('/media/bts-pinboard/board.webp')}")`}>
      {board.map(entry => entry.kind === 'photo' ? (
        <div class="bts__frame" style={`--board-span:${entry.pose.span};--board-ratio:${entry.pose.ratio};--board-angle:${entry.pose.angle}deg;--board-offset:${entry.pose.offset}px`}>
          <ResponsiveImage image={entry.item.image} sizes={imageSizes(entry.pose.span === 2)} />
          {showCaptions && <span class="bts__caption">{showNumbers && <span class="bts__number">{String(entry.index + 1).padStart(2, '0')}</span>}<span class="bts__label">{entry.item.caption || entry.item.project}</span></span>}
        </div>
      ) : (
        <div class:list={['bts__storyboard', {'bts__storyboard--custom': !!entry.artwork}]} aria-hidden="true"
          style={`grid-column:span ${entry.artwork?.size === 'large' ? 2 : 1};--artwork-angle:${entry.artwork?.tilt === 'left' ? -3 : entry.artwork?.tilt === 'straight' ? 0 : 3}deg`}>
          {entry.artwork ? <ResponsiveImage image={entry.artwork.image} sizes={imageSizes(entry.artwork.size === 'large')} /> : <img src={withBase('/media/bts-pinboard/storyboard.webp')} alt="" width="640" height="960" loading="lazy" decoding="async" />}
        </div>
      ))}
    </div>
  </section>
)}
<style>
  .bts { width: 85%; max-width: 1530px; margin: clamp(4rem, 8vw, 8rem) auto clamp(3.4rem, 6.8vw, 7.65rem); padding: .425rem calc(var(--page-gutter) * .85) 0; }
  .bts__header { display: flex; align-items: baseline; justify-content: space-between; gap: 1rem; margin-bottom: clamp(1.5rem, 3vw, 3rem); }
  .bts__header h2 { font-family: var(--font-body); font-size: clamp(1.7rem, 4.25vw, 4.25rem); font-weight: 800; letter-spacing: -.07em; line-height: .95; }
  .bts__outline { margin-inline-end: .16em; color: transparent; -webkit-text-stroke: max(1px, .013em) var(--color-ink); paint-order: stroke fill; }
  .bts__header > span { font-size: .75rem; white-space: nowrap; }
  .bts__board {
    position: relative; isolation: isolate; display: grid; grid-template-columns: repeat(5, minmax(0, 1fr));
    align-items: center; gap: clamp(24px, 3.23vw, 53px) clamp(19px, 2.3vw, 37px);
    padding: clamp(32px, 3.91vw, 65px) clamp(26px, 3.15vw, 51px);
  }
  .bts__board::before {
    content: ''; position: absolute; z-index: -1; pointer-events: none;
    inset-block: 0; left: 50%; width: 100vw; transform: translateX(-50%);
    background-color: #e5e4df;
    background-image: linear-gradient(#e5e4dfb8, #e5e4dfb8), var(--pinboard-surface);
    background-size: auto, 480px 480px;
  }
  /* Explicit width keeps WebKit's aspect-ratio items from shrinking around
     their absolutely positioned image children. DOM order is reading order. */
  .bts__frame {
    position: relative; display: block; width: 100%; min-width: 0; grid-column: span var(--board-span);
    padding: clamp(7px, .7vw, 11px); color: #32332e; background: #faf9f4;
    transform: translateY(var(--board-offset)) rotate(var(--board-angle)); transform-origin: 50% 4px;
    box-shadow: 0 1px 2px #272b261f, 2px 6px 9px #272b261a;
  }
  .bts__frame :global(.responsive-image) { position: relative; width: 100%; aspect-ratio: var(--board-ratio); overflow: hidden; }
  .bts__frame :global(picture), .bts__frame :global(img) { position: absolute; inset: 0; display: block; width: 100%; height: 100%; object-fit: cover; }
  .bts__frame::before, .bts__storyboard::before {
    content: ''; position: absolute; top: -3px; left: calc(50% - 3px); z-index: 2;
    width: 7px; height: 7px; border-radius: 50%;
    background: radial-gradient(circle at 30% 25%, #f0f0e6 0 12%, #969a93 24%, #3b413b 60%, #252b25 100%);
    box-shadow: 1px 2px 2px #0005;
  }
  .bts__caption { display: flex; align-items: center; gap: .55rem; padding: 10px 1px 2px; color: #62645a; font-size: clamp(9px, .7vw, 11px); line-height: 1.25; }
  .bts__number { font-variant-numeric: tabular-nums; color: #929489; }
  .bts__label { flex: 1; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .bts__storyboard { position: relative; min-width: 0; margin: -12% -8%; pointer-events: none; transform: rotate(var(--artwork-angle, 3deg)); filter: drop-shadow(1px 4px 3px #22281e12); }
  .bts__storyboard--custom { margin: 0; }
  .bts__storyboard :global(.responsive-image) { background: transparent; }
  .bts__storyboard :global(img) { display: block; width: 100%; height: auto; }
  .bts__storyboard::before { top: 16%; }
  @media (min-width: 600px) and (max-width: 999px) { .bts__board { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
  @media (max-width: 599px) {
    .bts__board { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 27px 17px; padding: 24px 19px 29px; }
    .bts__frame { --board-offset: 0px !important; padding: 6px; }
    .bts__header > span { display: none; }
    .bts__caption { gap: 4px; padding-top: 8px; font-size: 9px; }
  }
</style>
