---
import type { BtsItem } from '../lib/bts';
import { buildResponsiveSrcset } from '../lib/responsive-images';

interface Props {
  items: BtsItem[];
}
const { items } = Astro.props;
---

{items.length >= 3 ? (
  <section class="bts" aria-labelledby="bts-heading" data-bts data-carousel-look="frosted" data-carousel-parallax="depth">
    <header class="bts__header">
      <h2 id="bts-heading" aria-label="Behind the scenes">
        <span
          class="bts__heading-text"
          aria-hidden="true"
          data-motion-split="scroll-letters"
          data-motion-split-aria="none"
        >
          <span class="bts__title">
            <span class="bts__title-outline">Behind</span>{' '}
            <span>the</span>{' '}
            <span>scenes</span>
          </span>
        </span>
      </h2>
    </header>
    <div class="bts__carousel">
      <div
        class="bts-ring"
        data-carousel-stage
        role="group"
        aria-roledescription="carousel"
        aria-label="Behind the scenes photographs. Drag or use the arrow keys to turn."
      >
        {items.map((item, index) => (
          <div
            class="bts-ring__card"
            data-carousel-card
          >
            <button type="button" tabindex={index === 0 ? 0 : -1} aria-label={`Bring photograph ${index + 1} to the front`}>
              <img
                src={item.thumb}
                srcset={buildResponsiveSrcset(item.image)}
                sizes="(min-width: 768px) 26vw, 56vw"
                alt={item.image.alt || `${item.project}, behind the scenes`}
                loading="lazy"
                decoding="async"
                draggable="false"
              />
            </button>
          </div>
        ))}
      </div>
    </div>
  </section>
) : null}

<style>
  .bts {
    max-width: 1800px;
    margin-inline: auto;
    padding: 0 var(--page-gutter);
  }

  .bts__header {
    position: relative;
    z-index: 1;
    width: fit-content;
    max-width: 100%;
    /* Use the ring's empty upper area to keep the heading close to the photos. */
    margin: 0 auto clamp(-5.5rem, -7vw, -3rem);
  }

  .bts__header h2 {
    width: max-content;
    font-family: "New Work Title", var(--font-body);
    font-size: clamp(1.75rem, 5.5vw, 5rem);
    font-weight: 900;
    line-height: .84;
    letter-spacing: -.065em;
    text-transform: lowercase;
    white-space: nowrap;
  }

  .bts__heading-text {
    display: block;
  }

  .bts__title {
    display: flex;
    align-items: baseline;
    gap: .22em;
  }

  .bts__title-outline {
    color: transparent;
    -webkit-text-stroke: max(1px, .013em) var(--color-ink);
    paint-order: stroke fill;
  }

  .bts__carousel {
    position: relative;
    /* Keep the scene's scroll timeline scoped to this carousel. */
    timeline-scope: --bts-scroll;
  }

  /* --- The ring ----------------------------------------------------------- */
  .bts-ring {
    --card-width: clamp(170px, 21vw, 340px);
    --bts-origin: 35%;
    position: relative;
    height: clamp(520px, 56vw, 820px);
    margin-inline: calc(var(--page-gutter) * -1);
    overflow: hidden;
    isolation: isolate;
    cursor: grab;
    touch-action: pan-y;
    user-select: none;
    view-timeline: --bts-scroll block;
    view-timeline-inset: 0;
    background:
      radial-gradient(ellipse 50% 40% at 30% 30%, rgb(255 214 170 / 32%), transparent 70%),
      radial-gradient(ellipse 50% 45% at 72% 55%, rgb(170 205 255 / 30%), transparent 70%);
  }

  .bts-ring[data-dragging='true'] {
    cursor: grabbing;
  }

  .bts-ring__card {
    position: absolute;
    /* Leave room below the ring for the stronger foreground scroll travel. */
    top: var(--bts-origin);
    left: 50%;
    width: var(--card-width);
    aspect-ratio: 4 / 5;
    will-change: transform, opacity;
  }

  /* Scroll owns vertical travel; the independent transform owns rotation.
     No JS frame, transition or easing can hold back a scroll reversal. */
  .bts[data-carousel-scroll='native'] .bts-ring__card {
    animation: bts-scroll-depth 1s linear both;
    animation-timeline: --bts-scroll;
  }

  @keyframes bts-scroll-depth {
    from { translate: 0 var(--bts-travel, 0px); }
    to { translate: 0 calc(-1 * var(--bts-travel, 0px)); }
  }

  .bts-ring__card button {
    position: relative;
    display: block;
    width: 100%;
    height: 100%;
    padding: 7px;
    overflow: hidden;
    border: 0;
    border-radius: 14px;
    background: rgb(255 255 255 / 32%);
    box-shadow: 0 0 0 1px rgb(255 255 255 / 55%) inset;
    backdrop-filter: blur(calc(14px * var(--bts-clarity, 1))) saturate(calc(1 + .25 * var(--bts-clarity, 1)));
    cursor: inherit;
    transition: transform 220ms ease;
  }

  .bts-ring__card img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: 9px;
    opacity: calc(.82 + .18 * var(--bts-clarity, 1));
    pointer-events: none;
  }

  @media (hover: hover) and (pointer: fine) {
    /* Native hit testing selects only the uppermost card at the pointer.
       Scale its button without changing the ring's depth order. */
    .bts-ring:not([data-dragging='true']) .bts-ring__card:hover button {
      transform: scale(1.055);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .bts-ring__card button {
      transition: none;
    }
  }

  @media (min-width: 1200px) {
    .bts__carousel {
      /* Trim the empty tail without changing the ring's scroll geometry. */
      margin-bottom: -2rem;
    }
  }

  @media (max-width: 767px) {
    .bts-ring {
      --card-width: 46vw;
      height: 124vw;
    }
  }
</style>

<script>
  import { mountCarousel } from '../lib/bts-carousel';

  let disposeBts = (): void => undefined;

  const setupBts = (): void => {
    disposeBts();
    const section = document.querySelector<HTMLElement>('[data-bts]');
    if (!section) return;
    const disposeCarousel = mountCarousel(section);

    disposeBts = () => {
      disposeCarousel();
      disposeBts = () => undefined;
    };
  };

  setupBts();
  document.addEventListener('astro:page-load', setupBts);
  document.addEventListener('astro:before-swap', () => disposeBts());
</script>
