---
import BtsViewer from './BtsViewer.astro';
import type { BtsItem } from './types';

interface Props {
  items: BtsItem[];
}
const { items } = Astro.props;
---

<div class="bts-reel" data-bts-reel data-bts-reel-state="loading">
  <div class="bts-reel__stage" data-bts-reel-stage>
    <p class="bts-reel__backdrop" aria-hidden="true"><span>Behind</span><span>the</span><span>scenes</span></p>
    <canvas class="bts-reel__canvas" data-bts-reel-canvas aria-hidden="true"></canvas>

    <div class="bts-reel__hud" aria-live="polite">
      <p class="bts-reel__counter"><span data-bts-reel-counter>01</span> / {String(items.length).padStart(2, '0')}</p>
      <p class="bts-reel__time" data-bts-reel-time>{items[0]?.time} · {items[0]?.department}</p>
      <p class="bts-reel__note" data-bts-reel-note>{items[0]?.note}</p>
      <p class="bts-reel__project" data-bts-reel-project>{items[0]?.project}</p>
    </div>
    <p class="bts-reel__hint" aria-hidden="true">Scroll or drag to wind the reel · Click a frame</p>

    <!-- Keyboard and assistive-tech route through the same frames. Without
         WebGL this list is the presentation. -->
    <ol class="bts-reel__index" data-bts-reel-index>
      {items.map((item, index) => (
        <li>
          <button type="button" data-bts-reel-frame={index} aria-label={`${item.time}, ${item.note}, ${item.project}`}>
            <img src={item.thumb} alt="" loading="lazy" decoding="async" width={item.image.width} height={item.image.height} />
          </button>
        </li>
      ))}
    </ol>
  </div>
  <BtsViewer class="bts-reel__viewer" />
</div>

<style>
  .bts-reel {
    --reel-bg: #0d0c0b;
    position: relative;
    height: calc(100vh * 4);
    height: calc(100svh * 4);
    color: #f6f3ea;
  }

  .bts-reel__stage {
    position: sticky;
    top: 0;
    height: 100vh;
    height: 100svh;
    overflow: hidden;
    background:
      radial-gradient(ellipse 60% 70% at 50% 45%, rgb(255 226 170 / 16%), transparent 70%),
      radial-gradient(ellipse at 50% 120%, rgb(255 120 60 / 12%), transparent 60%),
      var(--reel-bg);
  }

  .bts-reel__backdrop {
    position: absolute;
    inset: 0;
    display: grid;
    align-content: center;
    justify-items: center;
    color: rgb(246 243 234 / 6%);
    font-family: var(--font-display);
    font-size: clamp(4rem, 1rem + 14vw, 17rem);
    font-weight: 900;
    letter-spacing: -.06em;
    line-height: .8;
    text-transform: uppercase;
    pointer-events: none;
    user-select: none;
  }

  .bts-reel__canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    opacity: 0;
    transition: opacity 900ms ease;
    touch-action: pan-y;
    cursor: grab;
  }

  .bts-reel[data-bts-reel-state='ready'] .bts-reel__canvas {
    opacity: 1;
  }

  .bts-reel__canvas[data-dragging='true'] {
    cursor: grabbing;
  }

  .bts-reel__canvas[data-hovering='true'] {
    cursor: pointer;
  }

  .bts-reel__hud {
    position: absolute;
    bottom: clamp(1.25rem, 5vh, 3rem);
    left: var(--page-gutter);
    display: grid;
    gap: .35rem;
    max-width: min(28rem, 80vw);
    pointer-events: none;
  }

  .bts-reel__counter,
  .bts-reel__time,
  .bts-reel__project,
  .bts-reel__hint {
    font-size: var(--text-xs);
    font-variant-numeric: tabular-nums;
    letter-spacing: .1em;
    text-transform: uppercase;
  }

  .bts-reel__counter span {
    color: #ff9a3e;
  }

  .bts-reel__note {
    font-family: var(--font-display);
    font-size: clamp(1.6rem, 1rem + 2.2vw, 3.4rem);
    font-weight: 900;
    letter-spacing: -.04em;
    line-height: .92;
  }

  .bts-reel__project {
    opacity: .6;
  }

  .bts-reel__hint {
    position: absolute;
    right: var(--page-gutter);
    bottom: clamp(1.25rem, 5vh, 3rem);
    opacity: .5;
    pointer-events: none;
  }

  /* Visually hidden while WebGL is running, but still focusable. */
  .bts-reel__index {
    position: absolute;
    top: 50%;
    right: var(--page-gutter);
    left: var(--page-gutter);
    display: flex;
    gap: .5rem;
    margin: 0;
    padding: 0;
    overflow-x: auto;
    list-style: none;
    transform: translateY(-50%);
  }

  .bts-reel__index button {
    display: block;
    width: 180px;
    padding: 0;
    border: 0;
    border-radius: 0;
    background: #000;
  }

  .bts-reel__index img {
    width: 100%;
    aspect-ratio: 3 / 2;
    object-fit: cover;
  }

  .bts-reel[data-bts-reel-state='ready'] .bts-reel__index,
  .bts-reel[data-bts-reel-state='loading'] .bts-reel__index {
    clip-path: inset(50%);
    opacity: 0;
    pointer-events: none;
  }

  .bts-reel[data-bts-reel-state='fallback'] .bts-reel__hint {
    display: none;
  }

  @media (max-width: 767px) {
    .bts-reel__hint {
      display: none;
    }
  }
</style>
