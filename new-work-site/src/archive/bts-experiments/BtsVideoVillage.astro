---
import type { BtsItem } from './types';

interface Props {
  items: BtsItem[];
}
const { items } = Astro.props;
const first = items[0];
const second = items[1] ?? first;
const camLabel = (index: number): string => `CAM ${String(index + 1).padStart(2, '0')}`;
---

<div class="bts-vv" data-bts-video-village>
  <div class="bts-vv__desk">
    <figure class="bts-vv__main">
      <div class="bts-vv__monitor bts-vv__monitor--program">
        <div class="bts-vv__screen" data-vv-program>
          <div class="bts-vv__layer" data-vv-layer="a" data-active="true">
            <img data-vv-image src={first?.large} alt="" decoding="async" />
            <video muted loop playsinline preload="none" data-vv-video aria-hidden="true" tabindex="-1"></video>
          </div>
          <div class="bts-vv__layer" data-vv-layer="b">
            <img data-vv-image alt="" decoding="async" />
            <video muted loop playsinline preload="none" data-vv-video aria-hidden="true" tabindex="-1"></video>
          </div>
          <div class="bts-vv__glass" aria-hidden="true"></div>
          <div class="bts-vv__safe" aria-hidden="true"></div>
          <div class="bts-vv__osd" aria-hidden="true">
            <span class="bts-vv__tally bts-vv__tally--program">PGM</span>
            <span class="bts-vv__rec"><i></i>REC</span>
            <span data-vv-cam>{camLabel(0)}</span>
            <span class="bts-vv__timecode" data-vv-timecode>01:00:00:00</span>
          </div>
          <div class="bts-vv__lower-third" data-vv-lower>
            <p class="bts-vv__lower-meta"><span data-vv-time>{first?.time}</span><span data-vv-department>{first?.department}</span></p>
            <p class="bts-vv__lower-note" data-vv-note>{first?.note}</p>
            <a class="bts-vv__lower-project" data-vv-link href={first?.href}>{first?.project}</a>
          </div>
          <div class="bts-vv__flash" data-vv-flash aria-hidden="true"></div>
        </div>
        <div class="bts-vv__meters" aria-hidden="true">
          <i data-vv-meter></i><i data-vv-meter></i>
        </div>
      </div>
      <figcaption class="bts-vv__label">Program</figcaption>
    </figure>

    <div class="bts-vv__side">
      <figure class="bts-vv__preview">
        <div class="bts-vv__monitor bts-vv__monitor--preview">
          <div class="bts-vv__screen">
            <img data-vv-preview-image src={second?.thumb} alt="" decoding="async" />
            <div class="bts-vv__glass" aria-hidden="true"></div>
            <div class="bts-vv__osd" aria-hidden="true">
              <span class="bts-vv__tally bts-vv__tally--preview">PVW</span>
              <span data-vv-preview-cam>{camLabel(1)}</span>
            </div>
          </div>
        </div>
        <figcaption class="bts-vv__label">Preview · <span data-vv-preview-note>{second?.note}</span></figcaption>
      </figure>

      <div class="bts-vv__mixer" role="group" aria-label="Vision mixer">
        <div class="bts-vv__row" role="group" aria-label="Transition type">
          <button type="button" data-vv-type="mix" aria-pressed="true">Mix</button>
          <button type="button" data-vv-type="wipe" aria-pressed="false">Wipe</button>
          <button type="button" data-vv-type="dip" aria-pressed="false">Dip</button>
        </div>
        <div class="bts-vv__take">
          <button type="button" class="bts-vv__cut" data-vv-cut>Cut</button>
          <button type="button" class="bts-vv__auto" data-vv-auto>Auto</button>
          <label class="bts-vv__tbar">
            <span class="sr-only">Transition bar</span>
            <input type="range" min="0" max="1000" value="0" step="1" data-vv-tbar />
          </label>
        </div>
        <button type="button" class="bts-vv__director" data-vv-director aria-pressed="true">
          <i aria-hidden="true"></i> Auto-director
        </button>
      </div>
    </div>
  </div>

  <ol class="bts-vv__wall" aria-label="Camera feeds">
    {items.map((item, index) => (
      <li>
        <button
          type="button"
          class="bts-vv__source"
          data-vv-source={index}
          data-state={index === 0 ? 'program' : index === 1 ? 'preview' : 'idle'}
          aria-label={`${camLabel(index)}: ${item.note}, ${item.project}`}
        >
          <img src={item.thumb} alt="" loading="lazy" decoding="async" width={item.image.width} height={item.image.height} />
          <span class="bts-vv__source-cam" aria-hidden="true">{camLabel(index)}</span>
          <span class="bts-vv__source-time" aria-hidden="true">{item.time}</span>
          {item.video ? <span class="bts-vv__source-live" aria-hidden="true">Live</span> : null}
        </button>
      </li>
    ))}
  </ol>
  <p class="bts-vv__hint">Pick a feed to preview it. Cut, Auto, or throw the T-bar to take it to air.</p>
</div>

<style>
  .bts-vv {
    --vv-bg: #121110;
    --vv-panel: #1b1a18;
    --vv-bezel: #050505;
    --vv-ink: #ece8df;
    --vv-muted: #8d877c;
    --vv-red: #ff3b30;
    --vv-green: #2fd35a;
    --vv-amber: #ffb340;
    max-width: 1800px;
    margin-inline: auto;
    padding: clamp(1rem, 2.4vw, 2.5rem) var(--page-gutter) clamp(1.5rem, 3vw, 3rem);
    color: var(--vv-ink);
    background:
      radial-gradient(ellipse 70% 60% at 35% 30%, rgb(255 244 220 / 6%), transparent 70%),
      var(--vv-bg);
    font-size: var(--text-xs);
    letter-spacing: .06em;
    text-transform: uppercase;
  }

  .bts-vv__desk {
    display: grid;
    gap: clamp(.75rem, 1.6vw, 1.5rem);
  }

  .bts-vv__main,
  .bts-vv__preview {
    display: grid;
    gap: .45rem;
    margin: 0;
  }

  .bts-vv__monitor {
    position: relative;
    display: flex;
    gap: 6px;
    padding: clamp(6px, .7vw, 12px);
    border-radius: 6px;
    background: linear-gradient(160deg, #1d1d1d, var(--vv-bezel) 40%);
    box-shadow:
      inset 0 1px 0 rgb(255 255 255 / 8%),
      0 30px 60px -30px rgb(0 0 0 / 80%);
  }

  .bts-vv__screen {
    position: relative;
    flex: 1;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    background: #000;
    isolation: isolate;
  }

  .bts-vv__layer {
    position: absolute;
    inset: 0;
    opacity: 0;
  }

  .bts-vv__layer[data-active='true'] {
    opacity: 1;
  }

  .bts-vv__layer img,
  .bts-vv__layer video,
  .bts-vv__screen > img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .bts-vv__layer video {
    opacity: 0;
    transition: opacity 400ms ease;
  }

  .bts-vv__layer video[data-playing='true'] {
    opacity: 1;
  }

  /* CRT-ish glass: scanlines, vignette and a faint reflection. */
  .bts-vv__glass {
    position: absolute;
    z-index: 2;
    inset: 0;
    background:
      linear-gradient(115deg, rgb(255 255 255 / 7%), transparent 30%),
      repeating-linear-gradient(0deg, rgb(0 0 0 / 16%) 0 1px, transparent 1px 3px),
      radial-gradient(ellipse at 50% 50%, transparent 55%, rgb(0 0 0 / 55%));
    mix-blend-mode: multiply;
    pointer-events: none;
  }

  .bts-vv__safe {
    position: absolute;
    z-index: 2;
    inset: 5% 5%;
    border: 1px solid rgb(255 255 255 / 22%);
    pointer-events: none;
  }

  .bts-vv__safe::after {
    position: absolute;
    top: 50%;
    left: 50%;
    width: 18px;
    height: 18px;
    background:
      linear-gradient(rgb(255 255 255 / 40%), rgb(255 255 255 / 40%)) 50% 0 / 1px 100% no-repeat,
      linear-gradient(rgb(255 255 255 / 40%), rgb(255 255 255 / 40%)) 0 50% / 100% 1px no-repeat;
    content: '';
    transform: translate(-50%, -50%);
  }

  .bts-vv__osd {
    position: absolute;
    z-index: 3;
    top: 7%;
    right: 6%;
    left: 6%;
    display: flex;
    gap: .9em;
    align-items: center;
    font: 700 clamp(.6rem, .45rem + .4vw, .9rem) / 1 ui-monospace, "SF Mono", Menlo, monospace;
    letter-spacing: .08em;
    text-shadow: 0 1px 2px rgb(0 0 0 / 70%);
  }

  .bts-vv__timecode {
    margin-left: auto;
    font-variant-numeric: tabular-nums;
  }

  .bts-vv__tally {
    padding: .25em .45em;
    border-radius: 2px;
    color: #fff;
    text-shadow: none;
  }

  .bts-vv__tally--program { background: var(--vv-red); }
  .bts-vv__tally--preview { background: var(--vv-green); color: #04220d; }

  .bts-vv__rec i {
    display: inline-block;
    width: .7em;
    height: .7em;
    margin-right: .35em;
    border-radius: 50%;
    background: var(--vv-red);
    animation: bts-vv-blink 1.2s steps(1) infinite;
  }

  @keyframes bts-vv-blink {
    50% { opacity: 0; }
  }

  .bts-vv__lower-third {
    position: absolute;
    z-index: 3;
    bottom: 8%;
    left: 6%;
    display: grid;
    gap: .25rem;
    max-width: 70%;
    padding: .7em 1em .8em;
    border-left: 4px solid var(--vv-red);
    background: linear-gradient(90deg, rgb(10 10 10 / 88%), rgb(10 10 10 / 55%));
    backdrop-filter: blur(6px);
    text-transform: none;
    transition: transform 420ms cubic-bezier(.22, 1, .36, 1), opacity 420ms ease;
  }

  .bts-vv__lower-third[data-leaving='true'] {
    opacity: 0;
    transform: translateX(-12px);
  }

  .bts-vv__lower-meta {
    display: flex;
    gap: 1em;
    color: var(--vv-amber);
    font-size: clamp(.6rem, .5rem + .25vw, .78rem);
    letter-spacing: .1em;
    text-transform: uppercase;
  }

  .bts-vv__lower-note {
    font-family: var(--font-display);
    font-size: clamp(1rem, .6rem + 1.4vw, 2.2rem);
    font-weight: 900;
    letter-spacing: -.03em;
    line-height: 1;
  }

  .bts-vv__lower-project {
    justify-self: start;
    color: var(--vv-ink);
    font-size: clamp(.62rem, .5rem + .3vw, .82rem);
    letter-spacing: .06em;
    text-decoration: none;
    text-transform: uppercase;
    border-bottom: 1px solid rgb(236 232 223 / 45%);
  }

  .bts-vv__flash {
    position: absolute;
    z-index: 4;
    inset: 0;
    background: #fff;
    opacity: 0;
    pointer-events: none;
  }

  .bts-vv__flash[data-cut='true'] {
    animation: bts-vv-cut 260ms steps(3, end);
  }

  @keyframes bts-vv-cut {
    0% { opacity: .5; transform: translateX(-1.5%); filter: hue-rotate(90deg); }
    50% { opacity: .15; transform: translateX(1%); }
    100% { opacity: 0; transform: none; }
  }

  .bts-vv__meters {
    display: flex;
    gap: 3px;
    width: clamp(10px, 1vw, 16px);
  }

  .bts-vv__meters i {
    --level: .1;
    position: relative;
    flex: 1;
    border-radius: 1px;
    background: linear-gradient(to top, var(--vv-green) 0 65%, var(--vv-amber) 65% 85%, var(--vv-red) 85%);
  }

  /* The unlit part of the meter, above the current level. */
  .bts-vv__meters i::before {
    position: absolute;
    inset: 0 0 auto;
    height: calc((1 - var(--level)) * 100%);
    background: #1c1c1c;
    content: '';
  }

  /* LED segment gaps. */
  .bts-vv__meters i::after {
    position: absolute;
    inset: 0;
    background: repeating-linear-gradient(to top, transparent 0 3px, #050505 3px 4px);
    content: '';
  }

  .bts-vv__label {
    display: flex;
    gap: .5em;
    color: var(--vv-muted);
    font-size: .68rem;
    letter-spacing: .14em;
  }

  .bts-vv__side {
    display: grid;
    gap: clamp(.75rem, 1.4vw, 1.25rem);
    align-content: start;
  }

  .bts-vv__mixer {
    display: grid;
    gap: .6rem;
    padding: .8rem;
    border-radius: 6px;
    background: var(--vv-panel);
    box-shadow: inset 0 1px 0 rgb(255 255 255 / 6%);
  }

  .bts-vv__row,
  .bts-vv__take {
    display: flex;
    gap: .4rem;
    align-items: center;
  }

  .bts-vv__mixer button {
    min-height: 40px;
    padding: .5rem .75rem;
    border: 1px solid rgb(255 255 255 / 12%);
    border-radius: 4px;
    background: linear-gradient(#2a2926, #1f1e1c);
    color: var(--vv-ink);
    font: inherit;
    letter-spacing: .1em;
    text-transform: uppercase;
    box-shadow: 0 2px 0 #000;
  }

  .bts-vv__mixer button:active {
    transform: translateY(1px);
    box-shadow: 0 1px 0 #000;
  }

  .bts-vv__row button {
    flex: 1;
  }

  .bts-vv__row button[aria-pressed='true'] {
    border-color: var(--vv-amber);
    color: var(--vv-amber);
    box-shadow: 0 2px 0 #000, 0 0 12px rgb(255 179 64 / 25%);
  }

  .bts-vv__cut {
    flex: 1;
    min-height: 56px !important;
    background: linear-gradient(#3a1a18, #2a1210) !important;
    color: #ffd7d3 !important;
    font-weight: 700 !important;
  }

  .bts-vv__auto {
    flex: 1;
    min-height: 56px !important;
    font-weight: 700 !important;
  }

  .bts-vv__tbar {
    display: grid;
    place-items: center;
    width: 64px;
    height: 124px;
    border-radius: 4px;
    background: repeating-linear-gradient(to bottom, #151412 0 9px, #262521 9px 10px);
  }

  /* A vertical fader: the input is rotated so dragging up takes to air. */
  .bts-vv__tbar input {
    width: 112px;
    margin: 0;
    background: transparent;
    transform: rotate(-90deg);
    appearance: none;
    cursor: ns-resize;
  }

  .bts-vv__tbar input::-webkit-slider-runnable-track {
    height: 6px;
    border-radius: 3px;
    background: #050505;
  }

  .bts-vv__tbar input::-moz-range-track {
    height: 6px;
    border-radius: 3px;
    background: #050505;
  }

  .bts-vv__tbar input::-webkit-slider-thumb {
    width: 18px;
    height: 44px;
    margin-top: -19px;
    border: 0;
    border-radius: 3px;
    background: linear-gradient(90deg, #cfcac0, #8c877f 45%, #d8d3c9 55%, #9a958c);
    box-shadow: 0 3px 6px rgb(0 0 0 / 60%);
    appearance: none;
  }

  .bts-vv__tbar input::-moz-range-thumb {
    width: 18px;
    height: 44px;
    border: 0;
    border-radius: 3px;
    background: linear-gradient(90deg, #cfcac0, #8c877f 45%, #d8d3c9 55%, #9a958c);
  }

  .bts-vv__director {
    display: inline-flex;
    gap: .5rem;
    align-items: center;
    justify-content: center;
  }

  .bts-vv__director i {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: #3a3935;
  }

  .bts-vv__director[aria-pressed='true'] i {
    background: var(--vv-green);
    box-shadow: 0 0 8px var(--vv-green);
  }

  .bts-vv__wall {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(6px, .7vw, 10px);
    margin: clamp(.75rem, 1.6vw, 1.5rem) 0 0;
    padding: 0;
    list-style: none;
  }

  .bts-vv__source {
    position: relative;
    display: block;
    width: 100%;
    aspect-ratio: 16 / 9;
    padding: 0;
    overflow: hidden;
    border: 3px solid var(--vv-bezel);
    border-radius: 3px;
    background: #000;
    box-shadow: 0 0 0 1px rgb(255 255 255 / 6%);
    transition: border-color 160ms ease, transform 160ms ease;
  }

  .bts-vv__source:hover {
    transform: translateY(-2px);
  }

  .bts-vv__source img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: saturate(.75) brightness(.85);
    transition: filter 200ms ease;
  }

  .bts-vv__source:is(:hover, :focus-visible, [data-state='preview'], [data-state='program']) img {
    filter: none;
  }

  .bts-vv__source::after {
    position: absolute;
    inset: 0;
    background: repeating-linear-gradient(0deg, rgb(0 0 0 / 18%) 0 1px, transparent 1px 3px);
    content: '';
    pointer-events: none;
  }

  .bts-vv__source[data-state='preview'] { border-color: var(--vv-green); }
  .bts-vv__source[data-state='program'] { border-color: var(--vv-red); }

  .bts-vv__source-cam,
  .bts-vv__source-time,
  .bts-vv__source-live {
    position: absolute;
    z-index: 1;
    padding: .2em .4em;
    background: rgb(0 0 0 / 65%);
    color: #fff;
    font: 700 .58rem / 1 ui-monospace, "SF Mono", Menlo, monospace;
    letter-spacing: .08em;
  }

  .bts-vv__source-cam { top: 4px; left: 4px; }
  .bts-vv__source-time { right: 4px; bottom: 4px; }
  .bts-vv__source-live { top: 4px; right: 4px; background: var(--vv-red); }

  .bts-vv__source[data-state='program'] .bts-vv__source-cam { background: var(--vv-red); }
  .bts-vv__source[data-state='preview'] .bts-vv__source-cam { background: var(--vv-green); color: #04220d; }

  .bts-vv__hint {
    margin-top: .9rem;
    color: var(--vv-muted);
  }

  @media (min-width: 900px) {
    .bts-vv__desk {
      grid-template-columns: minmax(0, 2.2fr) minmax(0, 1fr);
      align-items: start;
    }

    .bts-vv__wall {
      grid-template-columns: repeat(5, minmax(0, 1fr));
    }
  }

  @media (min-width: 1400px) {
    .bts-vv__wall {
      grid-template-columns: repeat(8, minmax(0, 1fr));
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .bts-vv__rec i { animation: none; }
    .bts-vv__flash[data-cut='true'] { animation: none; }
  }
</style>
