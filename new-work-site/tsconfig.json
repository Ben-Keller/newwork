{
  "extends": "astro/tsconfigs/strictest",
  "compilerOptions": {
    "allowJs": false,
    "exactOptionalPropertyTypes": false,
    "noUncheckedIndexedAccess": true,
    "resolveJsonModule": true,
    "types": ["@sanity/astro/module", "vitest/globals", "node"]
  },
  "include": [".astro/types.d.ts", "src/**/*", "sanity/**/*", "scripts/**/*", "tests/**/*", "*.ts", "src/sanity.types.ts"],
  "exclude": ["dist", "node_modules"]
}
