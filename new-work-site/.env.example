PUBLIC_SANITY_PROJECT_ID=7un4plyu
PUBLIC_SANITY_DATASET=production
# Server-only read token for a protected preview build. Never prefix with PUBLIC_.
SANITY_PREVIEW_TOKEN=
# Server-only write token used only by the explicit seed command.
SANITY_WRITE_TOKEN=
SANITY_SEED_UPDATE_MODE=preserve
PUBLIC_SITE_URL=http://localhost:4321
# Leave as / locally. GitHub Pages sets this to /<repository> in its workflow.
PUBLIC_BASE_PATH=/
# prototype = local fixtures; preview = Sanity drafts; production = approved published Sanity documents.
PUBLIC_CONTENT_MODE=prototype
PUBLIC_CONTACT_EMAIL=
# Leave blank unless analytics has written privacy approval for this deployment.
PUBLIC_CLOUDFLARE_ANALYTICS_TOKEN=
