{
  "name": "new-work",
  "private": true,
  "version": "1.0.0",
  "main": "package.json",
  "license": "UNLICENSED",
  "scripts": {
    "build": "sanity build",
    "migrate:project-ids": "sanity exec scripts/migrate-private-project-ids.ts --with-user-token --",
    "seed:with-user-token": "sanity exec scripts/seed-with-user-token.ts --with-user-token",
    "deploy": "sanity deploy",
    "deploy-graphql": "sanity graphql deploy",
    "dev": "sanity dev",
    "schema:deploy": "sanity schemas deploy",
    "typegen": "sanity schemas extract --force --enforce-required-fields && sanity typegen generate",
    "start": "sanity start"
  },
  "keywords": [
    "sanity"
  ],
  "dependencies": {
    "@sanity/icons": "^5.2.1",
    "@sanity/ui": "^4.0.6",
    "groq": "^6.10.1",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "sanity": "^6.11.0",
    "styled-components": "^6.1.18"
  },
  "devDependencies": {
    "@sanity/eslint-config-studio": "^7",
    "@types/node": "^24.10.0",
    "@types/react": "^19.2.14",
    "eslint": "^10.8.1",
    "prettier": "^3.5",
    "typescript": "^5.8"
  },
  "prettier": {
    "bracketSpacing": false,
    "printWidth": 100,
    "semi": false,
    "singleQuote": true
  }
}
